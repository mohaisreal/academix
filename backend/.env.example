# Ajustes de Django
SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*

# Ajustes de CORS
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:4321,http://localhost:3000
FRONTEND_URL=http://localhost:4321

# Frontend API contract (dev/prod)
PUBLIC_API_URL=http://localhost:8000/api
BACKEND_API_URL=http://localhost:8000/api

# Base de datos (SQLite para desarrollo)
# SQLite no necesita configuración
DATABASE_PATH=db.sqlite3

# Ajustes de JWT
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# Ficheros multimedia
MEDIA_ROOT=media
MEDIA_URL=/media/

# Ajustes de correo electrónico
# Para desarrollo: usa Mailpit (nombre del servicio Docker + puerto 1025)
# Para producción: usa smtp.EmailBackend con credenciales SMTP reales
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@academix.local

# Pagos con Stripe
# Desarrollo permanece en modo demo aunque estas claves estén definidas porque DEBUG=True.
# Producción requiere DEBUG=False + STRIPE_LIVE_PAYMENTS_ENABLED=True + claves de Stripe válidas.
STRIPE_LIVE_PAYMENTS_ENABLED=False
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
