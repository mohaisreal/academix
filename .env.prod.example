# Django Production Settings
DEBUG=False
SECRET_KEY=change-me-to-a-secure-random-key-in-production
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost
FRONTEND_URL=http://localhost
PUBLIC_API_URL=http://backend:8000/api
BACKEND_API_URL=http://backend:8000/api

# JWT Token Lifetime (in minutes)
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# PostgreSQL Database Configuration
DATABASE_URL=postgres://academix:replace-with-strong-password@db:5432/academix_db
POSTGRES_DB=academix_db
POSTGRES_USER=academix
POSTGRES_PASSWORD=replace-with-strong-password

# Media Files
MEDIA_URL=/media/
MEDIA_ROOT=media

# AWS S3 (production files)
AWS_ACCESS_KEY_ID=replace-with-aws-access-key
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-key
AWS_STORAGE_BUCKET_NAME=replace-with-bucket-name
AWS_S3_REGION_NAME=replace-with-region

# Email (production placeholders)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@academix.cv

# Stripe (demo-only by default)
# Demo mode requires STRIPE_PUBLIC_KEY. Keep live-only credentials blank until STRIPE_LIVE_PAYMENTS_ENABLED=True.
STRIPE_LIVE_PAYMENTS_ENABLED=False
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
