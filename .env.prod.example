# Django Production Settings
DEBUG=False
SECRET_KEY=change-me-to-a-secure-random-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost

# JWT Token Lifetime (in minutes)
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# PostgreSQL Database Configuration
DATABASE_URL=postgres://academix:academix_prod_password@db:5432/academix_db
POSTGRES_DB=academix_db
POSTGRES_USER=academix
POSTGRES_PASSWORD=academix_prod_password

# Media Files
MEDIA_URL=/media/
MEDIA_ROOT=media
