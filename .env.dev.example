# Django Development Settings
DEBUG=True
SECRET_KEY=django-insecure-dev-key-not-for-production-change-in-production
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:4321,http://localhost:3000
FRONTEND_URL=http://localhost:4321
PUBLIC_API_URL=http://localhost:8000/api
BACKEND_API_URL=http://localhost:8000/api

# JWT Token Lifetime (in minutes)
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# Database (SQLite path for local development)
DATABASE_PATH=db.sqlite3

# Media Files
MEDIA_URL=/media/
MEDIA_ROOT=media

# Email (Mailpit - dev SMTP catcher)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@academix.local

# Stripe (development placeholders)
STRIPE_LIVE_PAYMENTS_ENABLED=False
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
