# Django Development Settings
DEBUG=True
SECRET_KEY=django-insecure-dev-key-not-for-production-change-in-production
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:4321,http://localhost:3000

# JWT Token Lifetime (in minutes)
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# Media Files
MEDIA_URL=/media/
MEDIA_ROOT=media
