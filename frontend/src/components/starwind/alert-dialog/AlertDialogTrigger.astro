---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"button"> & {
    /**
   * Cuando es true, el componente renderizará su elemento hijo con un envoltorio simple en vez de un componente botón
   */
  asChild?: boolean;
    /**
   * ID opcional del diálogo que se va a disparar. Si no se proporciona y el disparador está dentro de un componente Dialog,
   * apuntará automáticamente a ese diálogo. Es obligatorio cuando se usa fuera de un componente Dialog.
   */
  for?: string;
};

const { class: className, asChild = false, for: dialogFor, ...rest } = Astro.props;

// Obtiene el primer elemento hijo si asChild es true
let hasChildren = false;
if (Astro.slots.has("default")) {
  hasChildren = true;
}
---

{
  asChild && hasChildren ? (
    <div
      class:list={["starwind-alert-dialog-trigger", className]}
      data-slot="alert-dialog-trigger"
      data-as-child
      data-dialog-for={dialogFor}
    >
      <slot />
    </div>
  ) : (
    <button
      type="button"
      aria-haspopup="dialog"
      class:list={["starwind-alert-dialog-trigger", className]}
      data-slot="alert-dialog-trigger"
      data-dialog-for={dialogFor}
      {...rest}
    >
      <slot />
    </button>
  )
}
