---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
---
<DashboardLayout title="My Subjects — Academix" currentPath="/my-subjects">
  <div id="page-loading" class="p-6 space-y-4">
    <div class="h-12 bg-card rounded-xl border border-border animate-pulse"></div>
    <div class="grid grid-cols-3 gap-4">
      <div class="h-48 bg-card rounded-xl border border-border animate-pulse"></div>
      <div class="h-48 bg-card rounded-xl border border-border animate-pulse"></div>
      <div class="h-48 bg-card rounded-xl border border-border animate-pulse"></div>
    </div>
  </div>

  <div id="page-content" class="hidden">
    <div class="flex items-center justify-between border-b border-border px-6 py-4">
      <div>
        <h1 class="text-xl font-semibold text-foreground">My Subjects</h1>
        <p class="text-sm text-muted-foreground">Your enrolled subjects this period</p>
      </div>
      <span id="period-badge" class="inline-flex items-center rounded-full bg-primary/10 px-3 py-1 text-sm font-medium text-primary"></span>
    </div>

    <div class="p-6">
      <div id="subjects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
      <div id="subjects-empty" class="hidden flex flex-col items-center justify-center py-16 text-center">
        <div class="flex size-16 items-center justify-center rounded-full bg-muted mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 6 3 6 3s3 0 6-3v-5"/></svg>
        </div>
        <p class="text-lg font-medium text-foreground">No subjects enrolled</p>
        <p class="text-sm text-muted-foreground mt-1">You are not enrolled in any subjects</p>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  const STORAGE_KEY = "user-storage";
  const TOKEN_KEY = "access_token";
  const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8000/api";
  const RECENT_SUBJECTS_KEY = "academix:recent-subject-visits";

  function getUser() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY))?.state?.user ?? null; }
    catch { return null; }
  }

  const token = localStorage.getItem(TOKEN_KEY);
  if (!token) window.location.replace('/login');
  const user = getUser();
  if (!user) window.location.replace('/login');
  const role = user?.role ?? '';

  if (role !== 's') window.location.replace('/');

  async function apiFetch(path, options = {}) {
    const res = await fetch(`${API_URL}${path}`, {
      headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
      ...options,
    });
    if (res.status === 401) window.location.replace('/login');
    return res.json();
  }

  function showContent() {
    document.getElementById('page-loading')?.classList.add('hidden');
    document.getElementById('page-content')?.classList.remove('hidden');
  }

  function escHtml(str) {
    const d = document.createElement('div');
    d.textContent = String(str ?? '');
    return d.innerHTML;
  }

  function getClassId(item) {
    return String(item?.class_id ?? item?.class?.id ?? item?.cls?.id ?? item?.id ?? "");
  }

  function getRecentSubjectIds() {
    try {
      const parsed = JSON.parse(localStorage.getItem(RECENT_SUBJECTS_KEY) ?? "[]");
      if (!Array.isArray(parsed)) return [];
      return parsed.map(entry => String(entry?.classId ?? entry?.id ?? entry ?? "")).filter(Boolean);
    } catch {
      return [];
    }
  }

  function rememberSubjectVisit(classId) {
    if (!classId) return;
    const next = [
      { classId, visitedAt: new Date().toISOString() },
      ...getRecentSubjectIds()
        .filter(id => id !== classId)
        .map(id => ({ classId: id, visitedAt: null })),
    ].slice(0, 20);
    try { localStorage.setItem(RECENT_SUBJECTS_KEY, JSON.stringify(next)); } catch {}
  }

  function initials(name) {
    if (!name) return '??';
    return name.split(' ').map(p => p[0]).join('').toUpperCase().substring(0, 2);
  }

  (async () => {
    try {
      const data = await apiFetch('/enrollment/my-subjects/');
      const subjects = Array.isArray(data) ? data : (data.results || []);

      const grid = document.getElementById('subjects-grid');
      const empty = document.getElementById('subjects-empty');
      const badge = document.getElementById('period-badge');

      if (subjects.length === 0) {
        empty?.classList.remove('hidden');
        showContent();
        return;
      }

      // Establece la insignia de periodo desde la primera asignatura
      if (badge && subjects[0]?.period_name) badge.textContent = subjects[0].period_name;

      grid.innerHTML = subjects.map(s => {
        const classId = getClassId(s);
        const name = s.subject_name || s.name || 'Subject';
        const code = s.subject_code || s.code || '';
        const teacher = s.teacher_name || s.teacher || 'Unknown Teacher';
        const credits = s.credits || 0;
        const grade = s.current_grade ?? s.grade;
        const gradeDisplay = grade != null ? `${parseFloat(grade).toFixed(1)}%` : 'Not graded yet';
        const gradeProgress = grade != null ? Math.min(100, parseFloat(grade)) : 0;
        const schedules = s.schedules || s.schedule || [];
        const firstSlot = schedules[0];
        const slotText = firstSlot ? `${['Mon','Tue','Wed','Thu','Fri','Sat','Sun'][(firstSlot.day_of_week === 0 ? 6 : firstSlot.day_of_week - 1)]} ${firstSlot.start_time || ''}` : '';

        const progressColor = gradeProgress >= 75 ? 'bg-green-500' : gradeProgress >= 50 ? 'bg-blue-500' : gradeProgress > 0 ? 'bg-yellow-500' : 'bg-muted';

        return `
          <div class="bg-card text-card-foreground rounded-xl border border-border p-5 flex flex-col gap-4 hover:border-primary/50 transition-colors">
            <div class="flex items-start justify-between">
              <div>
                <p class="font-semibold text-foreground">${escHtml(name)}</p>
                <p class="text-xs text-muted-foreground mt-0.5">${escHtml(code)}</p>
              </div>
              <span class="inline-flex items-center rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary">${credits} cr</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="flex size-7 items-center justify-center rounded-full bg-primary/15 text-xs font-semibold text-primary">${initials(teacher)}</div>
              <span class="text-sm text-muted-foreground">${escHtml(teacher)}</span>
            </div>
            <div class="space-y-1.5">
              <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Progress</span>
                <span class="font-medium text-foreground">${gradeDisplay}</span>
              </div>
              <div class="h-1.5 bg-muted rounded-full overflow-hidden">
                <div class="h-full ${progressColor} rounded-full transition-all" style="width:${gradeProgress}%"></div>
              </div>
            </div>
            ${slotText ? `<p class="text-xs text-muted-foreground">Next: ${escHtml(slotText)}</p>` : ''}
            <a href="/grades${classId ? `?class=${encodeURIComponent(classId)}` : ''}" data-subject-class-id="${escHtml(classId)}" class="mt-auto inline-flex items-center justify-center rounded-lg border border-border px-3 py-1.5 text-xs font-medium text-foreground hover:bg-muted transition-colors">
              View Grades
            </a>
          </div>
        `;
      }).join('');

      grid.querySelectorAll('[data-subject-class-id]').forEach(el => {
        el.addEventListener('click', () => rememberSubjectVisit(el.dataset.subjectClassId || ''));
      });

    } catch {
      document.getElementById('subjects-empty')?.classList.remove('hidden');
    }
    showContent();
  })();
</script>
