---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
---
<DashboardLayout title="Teachers — Academix" currentPath="/teachers">
  <div id="page-loading" class="p-6 space-y-4">
    <div class="h-12 bg-card rounded-xl border border-border animate-pulse"></div>
    <div class="h-64 bg-card rounded-xl border border-border animate-pulse"></div>
  </div>

  <div id="page-content" class="hidden">
    <div class="border-b border-border px-6 py-4">
      <h1 class="text-xl font-semibold text-foreground">Teachers</h1>
      <p class="text-sm text-muted-foreground">Manage teaching staff</p>
    </div>

    <div class="p-6 space-y-4">
      <!-- Search -->
      <div class="relative max-w-sm">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0"/></svg>
        <input id="search-input" type="text" placeholder="Search teachers..." class="pl-9 pr-4 py-2 w-full bg-input border border-border rounded-lg text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
      </div>

      <div class="bg-card text-card-foreground rounded-xl border border-border overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-border bg-muted/50">
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide px-4 py-3">Teacher</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide px-4 py-3">Email</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide px-4 py-3">Phone</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide px-4 py-3">Classes (Active)</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide px-4 py-3">Status</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide px-4 py-3">Actions</th>
              </tr>
            </thead>
            <tbody id="teachers-table"></tbody>
          </table>
        </div>
        <div id="teachers-empty" class="hidden py-10 text-center text-sm text-muted-foreground">No teachers found</div>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  const STORAGE_KEY = "user-storage";
  const TOKEN_KEY = "access_token";
  const API_URL = "http://localhost:8000/api";

  function getUser() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY))?.state?.user ?? null; }
    catch { return null; }
  }
  const token = localStorage.getItem(TOKEN_KEY);
  if (!token) window.location.replace('/login');
  const user = getUser();
  if (!user) window.location.replace('/login');
  if (user.role !== 'm' && user.role !== 'a') window.location.replace('/');

  async function apiFetch(path, options = {}) {
    const res = await fetch(`${API_URL}${path}`, {
      headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
      ...options,
    });
    if (res.status === 401) window.location.replace('/login');
    if (res.status === 204) return {};
    return res.json();
  }

  function escHtml(str) {
    const d = document.createElement('div');
    d.textContent = String(str ?? '');
    return d.innerHTML;
  }

  function initials(first, last) {
    return ((first?.[0] ?? '') + (last?.[0] ?? '')).toUpperCase() || '?';
  }

  let allTeachers = [];
  let searchQuery = '';

  function renderTable() {
    const filtered = searchQuery
      ? allTeachers.filter(t => {
          const q = searchQuery.toLowerCase();
          return (t.first_name + ' ' + t.last_name).toLowerCase().includes(q) || t.email?.toLowerCase().includes(q);
        })
      : allTeachers;

    const tbody = document.getElementById('teachers-table');
    const empty = document.getElementById('teachers-empty');
    if (!tbody) return;
    if (filtered.length === 0) {
      tbody.innerHTML = '';
      empty?.classList.remove('hidden');
      return;
    }
    empty?.classList.add('hidden');
    tbody.innerHTML = filtered.map(t => {
      const active = t.is_active !== false;
      return `<tr class="border-b border-border hover:bg-muted/40 transition-colors">
        <td class="px-4 py-3">
          <div class="flex items-center gap-3">
            <div class="size-8 rounded-full bg-primary/15 flex items-center justify-center text-xs font-semibold text-primary">
              ${escHtml(initials(t.first_name, t.last_name))}
            </div>
            <span class="text-sm font-medium text-foreground">${escHtml(t.first_name)} ${escHtml(t.last_name)}</span>
          </div>
        </td>
        <td class="px-4 py-3 text-sm text-muted-foreground">${escHtml(t.email ?? '—')}</td>
        <td class="px-4 py-3 text-sm text-muted-foreground">${escHtml(t.phone ?? '—')}</td>
        <td class="px-4 py-3 text-sm text-muted-foreground">${t.active_classes_count ?? '—'}</td>
        <td class="px-4 py-3">
          <span class="inline-flex items-center rounded-full ${active ? 'bg-green-500/15 text-green-400' : 'bg-muted text-muted-foreground'} px-2 py-0.5 text-xs font-medium">
            ${active ? 'Active' : 'Inactive'}
          </span>
        </td>
        <td class="px-4 py-3">
          <div class="flex items-center gap-2">
            <button class="toggle-btn rounded-lg border border-border px-2.5 py-1 text-xs font-medium hover:bg-muted transition-colors ${active ? 'text-red-400 hover:border-red-500/30' : 'text-green-400 hover:border-green-500/30'}" data-id="${t.id}" data-active="${active}">
              ${active ? 'Deactivate' : 'Activate'}
            </button>
          </div>
        </td>
      </tr>`;
    }).join('');

    tbody.querySelectorAll('.toggle-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.id;
        const active = btn.dataset.active === 'true';
        await apiFetch(`/users/${id}/`, { method: 'PATCH', body: JSON.stringify({ is_active: !active }) });
        await loadTeachers();
      });
    });
  }

  async function loadTeachers() {
    const data = await apiFetch('/users/teachers/');
    allTeachers = Array.isArray(data) ? data : (data?.results ?? []);
    renderTable();
    document.getElementById('page-loading')?.classList.add('hidden');
    document.getElementById('page-content')?.classList.remove('hidden');
  }

  document.getElementById('search-input')?.addEventListener('input', e => {
    searchQuery = (e.target as HTMLInputElement).value;
    renderTable();
  });

  loadTeachers();
</script>
