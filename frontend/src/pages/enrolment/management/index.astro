---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
---
<DashboardLayout title="Gestión de matrículas — Academix" currentPath="/enrolment/management">
  <div id="page-loading" class="p-6 space-y-4">
    <div class="h-12 bg-card rounded-xl border border-border animate-pulse"></div>
    <div class="h-64 bg-card rounded-xl border border-border animate-pulse"></div>
  </div>

  <div id="page-content" class="hidden">
    <div class="flex items-center justify-between border-b border-border px-6 py-4">
      <div>
        <h1 class="text-xl font-semibold text-foreground">Gestión de matrículas</h1>
        <p class="text-sm text-muted-foreground">Manage student career enrolments</p>
      </div>
      <button id="new-enrolment-btn" class="inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        New Enrolment
      </button>
    </div>

    <div class="p-6 space-y-4">
      <!-- Filtros -->
      <div class="flex flex-wrap gap-3">
        <select id="filter-status" class="bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
          <option value="">All Statuses</option>
          <option value="pending">Pending Review</option>
          <option value="active">Active</option>
          <option value="completed">Completed</option>
          <option value="dropped">Dropped</option>
        </select>
        <select id="filter-career" class="bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
          <option value="">All Careers</option>
        </select>
      </div>

      <div class="bg-card text-card-foreground rounded-xl border border-border overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-border bg-muted/50">
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide px-4 py-3">Estudiante</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide px-4 py-3">Career</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide px-4 py-3">Period</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide px-4 py-3">Estado</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide px-4 py-3">Actions</th>
              </tr>
            </thead>
            <tbody id="enrolments-table"></tbody>
          </table>
        </div>
        <div id="enrolments-empty" class="hidden py-10 text-center text-sm text-muted-foreground">No enrolments found</div>
      </div>
    </div>
  </div>

  <!-- Modal centrado -->
  <div id="modal-backdrop" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="w-full max-w-lg rounded-xl border border-border bg-background shadow-2xl max-h-[90vh] flex flex-col">
      <!-- Cabecera -->
      <div class="flex items-center justify-between px-5 py-4 border-b border-border shrink-0">
        <h2 id="modal-title" class="text-base font-semibold text-foreground">New Enrolment</h2>
        <button id="modal-close" type="button" class="rounded-md p-1.5 text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <!-- Scrollable body -->
      <div class="overflow-y-auto flex-1 px-5 py-4">
        <form id="enrolment-form" class="space-y-4">
          <input id="edit-id" type="hidden" value="" />
          <div>
            <label class="text-xs font-medium text-muted-foreground">Student *</label>
            <select id="enrolment-student" required class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
              <option value="">Select student...</option>
            </select>
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Career *</label>
            <select id="enrolment-career" required class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
              <option value="">Select career...</option>
            </select>
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Period *</label>
            <select id="enrolment-period" required class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
              <option value="">Select period...</option>
            </select>
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Estado</label>
            <select id="enrolment-status" class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
              <option value="pending">Pending Review</option>
              <option value="active">Active</option>
              <option value="completed">Completed</option>
              <option value="dropped">Dropped</option>
            </select>
          </div>
          <div id="form-error" class="hidden text-xs text-red-400"></div>
        </form>
      </div>
      <!-- Pie fijo -->
      <div class="flex items-center justify-end gap-3 px-5 py-4 border-t border-border shrink-0">
        <button id="modal-cancel" type="button" class="inline-flex items-center justify-center rounded-md border border-input bg-background px-4 py-2 text-sm font-medium text-foreground hover:bg-muted transition-colors">Cancelar</button>
        <button id="modal-save" type="submit" form="enrolment-form" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary/90 transition-colors">Guardar</button>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  const STORAGE_KEY = "user-storage";
  const TOKEN_KEY = "access_token";
  const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8000/api";

  function getUser() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY) ?? 'null')?.state?.user ?? null; }
    catch { return null; }
  }

  const token = localStorage.getItem(TOKEN_KEY);
  if (!token) { window.location.replace('/login'); throw new Error('Unauthenticated'); }
  const user = getUser();
  if (!user) { window.location.replace('/login'); throw new Error('Unauthenticated'); }
  if (user.role !== 'm' && user.role !== 'a') { window.location.replace('/'); throw new Error('Unauthorised'); }

  async function apiFetch(path: string, options: RequestInit = {}): Promise<any> {
    const res = await fetch(`${API_URL}${path}`, {
      headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
      ...options,
    });
    if (res.status === 401) window.location.replace('/login');
    if (res.status === 204) return {};
    return res.json();
  }

  function escHtml(str: any): string {
    const d = document.createElement('div');
    d.textContent = String(str ?? '');
    return d.innerHTML;
  }

  const STATUS_COLORS: Record<string, string> = {
    pending: 'bg-yellow-500/15 text-yellow-400',
    active: 'bg-green-500/15 text-green-400',
    completed: 'bg-blue-500/15 text-blue-400',
    dropped: 'bg-red-500/15 text-red-400',
  };

  const STATUS_LABELS: Record<string, string> = {
    pending: 'Pending Review',
    active: 'Active',
    completed: 'Completed',
    dropped: 'Dropped',
  };

  let enrolments: any[] = [], careers: any[] = [], periods: any[] = [], students: any[] = [];
  let studentOptionsLoaded = false;
  let filterStatus = '', filterCareer = '';

  function renderTable() {
    let filtered = enrolments;
    if (filterStatus) filtered = filtered.filter(e => e.status === filterStatus);
    if (filterCareer) filtered = filtered.filter(e => {
      const career = careers.find(c => String(c.id) === filterCareer);
      return career ? e.career_name === career.name : false;
    });

    const tbody = document.getElementById('enrolments-table');
    const empty = document.getElementById('enrolments-empty');
    if (!tbody) return;
    if (filtered.length === 0) {
      tbody.innerHTML = '';
      empty?.classList.remove('hidden');
      return;
    }
    empty?.classList.add('hidden');
    tbody.innerHTML = filtered.map(e => {
      const studentName = e.student?.full_name ?? (`${e.student?.first_name ?? ''} ${e.student?.last_name ?? ''}`.trim() || `Student #${e.student?.id ?? '?'}`);
      const careerName = e.career_name ?? `Career #?`;
      const periodName = e.period_name ?? `Period #?`;
      const colorClass = STATUS_COLORS[e.status] ?? 'bg-muted text-muted-foreground';
      return `<tr class="border-b border-border hover:bg-muted/40 transition-colors">
        <td class="px-4 py-3 text-sm font-medium text-foreground">${escHtml(studentName)}</td>
        <td class="px-4 py-3 text-sm text-muted-foreground">${escHtml(careerName)}</td>
        <td class="px-4 py-3 text-sm text-muted-foreground">${escHtml(periodName)}</td>
        <td class="px-4 py-3">
          <span class="inline-flex items-center rounded-full ${colorClass} px-2 py-0.5 text-xs font-medium">${STATUS_LABELS[e.status] ?? e.status}</span>
        </td>
        <td class="px-4 py-3">
          <div class="flex items-center gap-2">
            ${e.status === 'pending' ? `
              <button class="approve-btn rounded-lg bg-green-500/15 border border-green-500/30 px-2.5 py-1 text-xs font-medium text-green-400 hover:bg-green-500/25 transition-colors" data-id="${e.id}">Approve</button>
              <button class="reject-btn rounded-lg bg-red-500/15 border border-red-500/30 px-2.5 py-1 text-xs font-medium text-red-400 hover:bg-red-500/25 transition-colors" data-id="${e.id}">Reject</button>
            ` : ''}
            <button class="edit-btn rounded-lg border border-border px-2.5 py-1 text-xs font-medium text-foreground hover:bg-muted transition-colors" data-id="${e.id}">Editar</button>
            <button class="delete-btn rounded-lg border border-red-500/30 px-2.5 py-1 text-xs font-medium text-red-400 hover:bg-red-500/10 transition-colors" data-id="${e.id}">Eliminar</button>
          </div>
        </td>
      </tr>`;
    }).join('');

    tbody.querySelectorAll<HTMLButtonElement>('.edit-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const e = enrolments.find(x => x.id == btn.dataset.id);
        if (e) {
          await ensureStudentOptions();
          openPanel(e);
        }
      });
    });
    tbody.querySelectorAll<HTMLButtonElement>('.approve-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        await apiFetch(`/enrollment/review/${btn.dataset.id}/approve/`, { method: 'PATCH' });
        await loadData();
      });
    });
    tbody.querySelectorAll<HTMLButtonElement>('.reject-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.id;
        window.confirmAction({
          title: "Reject Enrolment",
          description: "This will mark the enrolment as dropped.",
          confirmLabel: "Reject",
          variant: "destructive",
          onConfirm: async () => {
            await apiFetch(`/enrollment/review/${id}/reject/`, { method: 'PATCH' });
            await loadData();
          },
        });
      });
    });
    tbody.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.id;
        window.confirmAction({
          title: "Delete Enrolment",
          description: "This action cannot be undone.",
          confirmLabel: "Eliminar",
          variant: "destructive",
          onConfirm: async () => {
            await apiFetch(`/enrollment/management/${id}/`, { method: 'DELETE' });
            await loadData();
          },
        });
      });
    });
  }

  async function loadData() {
    const [eData, cData, pData] = await Promise.all([
      apiFetch('/enrollment/management/'),
      apiFetch('/academic/careers/'),
      apiFetch('/academic/periods/'),
    ]);
    enrolments = Array.isArray(eData) ? eData : (eData?.results ?? []);
    careers = Array.isArray(cData) ? cData : (cData?.results ?? []);
    periods = Array.isArray(pData) ? pData : (pData?.results ?? []);

    const careerFilter = document.getElementById('filter-career') as HTMLSelectElement;
    if (careerFilter) {
      careerFilter.innerHTML = '<option value="">All Careers</option>';
      careers.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.id; opt.textContent = c.name;
        careerFilter.appendChild(opt);
      });
    }

    const careerSel = document.getElementById('enrolment-career') as HTMLSelectElement;
    if (careerSel) {
      careerSel.innerHTML = '<option value="">Select career...</option>';
      careers.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.id; opt.textContent = c.name;
        careerSel.appendChild(opt);
      });
    }

    const periodSel = document.getElementById('enrolment-period') as HTMLSelectElement;
    if (periodSel) {
      periodSel.innerHTML = '<option value="">Select period...</option>';
      periods.forEach(p => {
        const opt = document.createElement('option');
        opt.value = p.id; opt.textContent = p.name;
        periodSel.appendChild(opt);
      });
    }

    renderTable();
    document.getElementById('page-loading')?.classList.add('hidden');
    document.getElementById('page-content')?.classList.remove('hidden');
  }

  function openPanel(enrolment: any = null) {
    document.getElementById('form-error')?.classList.add('hidden');
    const title = document.getElementById('modal-title');
    if (enrolment) {
      if (title) title.textContent = 'Edit Enrolment';
      (document.getElementById('edit-id') as HTMLInputElement).value = enrolment.id;
      (document.getElementById('enrolment-student') as HTMLSelectElement).value = String(enrolment.student?.id ?? enrolment.student);
      const careerId = careers.find(c => c.name === enrolment.career_name)?.id ?? '';
      (document.getElementById('enrolment-career') as HTMLSelectElement).value = String(careerId);
      const periodId = periods.find(p => p.name === enrolment.period_name)?.id ?? '';
      (document.getElementById('enrolment-period') as HTMLSelectElement).value = String(periodId);
      (document.getElementById('enrolment-status') as HTMLSelectElement).value = enrolment.status;
    } else {
      if (title) title.textContent = 'New Enrolment';
      (document.getElementById('edit-id') as HTMLInputElement).value = '';
      (document.getElementById('enrolment-form') as HTMLFormElement)?.reset();
    }
    document.getElementById('modal-backdrop')?.classList.remove('hidden');
  }

  function closePanel() {
    document.getElementById('modal-backdrop')?.classList.add('hidden');
  }

  async function ensureStudentOptions() {
    if (studentOptionsLoaded) return;
    const sData = await apiFetch('/users/students/');
    students = Array.isArray(sData) ? sData : (sData?.results ?? []);
    const sel = document.getElementById('enrolment-student') as HTMLSelectElement;
    if (sel) {
      sel.innerHTML = '<option value="">Select student...</option>';
      students.forEach(s => {
        const opt = document.createElement('option');
        opt.value = s.id;
        opt.textContent = `${s.first_name} ${s.last_name}`;
        sel.appendChild(opt);
      });
    }
    studentOptionsLoaded = true;
  }

  document.getElementById('new-enrolment-btn')?.addEventListener('click', async () => {
    await ensureStudentOptions();
    openPanel();
  });
  document.getElementById('modal-close')?.addEventListener('click', closePanel);
  document.getElementById('modal-cancel')?.addEventListener('click', closePanel);
  document.getElementById('modal-backdrop')?.addEventListener('click', e => { if (e.target === e.currentTarget) closePanel(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closePanel(); });
  document.getElementById('filter-status')?.addEventListener('change', e => { filterStatus = (e.target as HTMLSelectElement).value; renderTable(); });
  document.getElementById('filter-career')?.addEventListener('change', e => { filterCareer = (e.target as HTMLSelectElement).value; renderTable(); });

  document.getElementById('enrolment-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const errEl = document.getElementById('form-error');
    const id = (document.getElementById('edit-id') as HTMLInputElement).value;
    const body = {
      student_id: parseInt((document.getElementById('enrolment-student') as HTMLSelectElement).value),
      career_id: parseInt((document.getElementById('enrolment-career') as HTMLSelectElement).value),
      period_id: parseInt((document.getElementById('enrolment-period') as HTMLSelectElement).value),
      status: (document.getElementById('enrolment-status') as HTMLSelectElement).value,
    };
    try {
      if (id) {
        await apiFetch(`/enrollment/management/${id}/`, { method: 'PATCH', body: JSON.stringify(body) });
      } else {
        await apiFetch('/enrollment/management/', { method: 'POST', body: JSON.stringify(body) });
      }
      closePanel();
      await loadData();
    } catch {
      errEl?.classList.remove('hidden');
      if (errEl) errEl.textContent = 'No se ha podido guardar enrolment';
    }
  });

  loadData();
</script>
