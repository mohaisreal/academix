---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
---
<DashboardLayout title="Mis estudiantes — Academix" currentPath="/my-students">
  <div id="page-loading" class="p-6 space-y-4">
    <div class="h-12 bg-card rounded-xl border border-border animate-pulse"></div>
    <div class="h-64 bg-card rounded-xl border border-border animate-pulse"></div>
  </div>

  <div id="page-content" class="hidden">
    <div class="flex flex-col gap-3 border-b border-border px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <div>
        <h1 class="text-xl font-semibold text-foreground">Mis estudiantes</h1>
        <p class="text-sm text-muted-foreground">Estudiantes inscritos en tus clases</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <select id="class-filter" class="w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary sm:w-auto">
          <option value="">Todas las clases</option>
        </select>
        <input id="search-input" type="text" placeholder="Buscar estudiantes..." class="w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary sm:w-52" />
      </div>
    </div>

    <div class="p-4 sm:p-6">
      <div class="bg-card text-card-foreground rounded-xl border border-border p-4 sm:p-5">
        <div class="overflow-x-auto">
          <table class="min-w-[880px] w-full">
            <thead>
              <tr class="border-b border-border">
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Estudiante</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Carrera</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Promedio</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Acciones</th>
              </tr>
            </thead>
            <tbody id="students-table-body"></tbody>
          </table>
        </div>
        <div id="students-empty" class="hidden py-10 text-center text-sm text-muted-foreground">No se encontraron estudiantes</div>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  import API_BASE_URL from '@/config/api';
  const STORAGE_KEY = "user-storage";
  const TOKEN_KEY = "access_token";
  const API_URL = API_BASE_URL;

  function getUser() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY))?.state?.user ?? null; }
    catch { return null; }
  }

  const token = localStorage.getItem(TOKEN_KEY);
  if (!token) window.location.replace('/login');
  const user = getUser();
  if (!user) window.location.replace('/login');
  const role = user?.role ?? '';

  if (role !== 't') window.location.replace('/');

  async function apiFetch(path, options = {}) {
    const res = await fetch(`${API_URL}${path}`, {
      headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
      ...options,
    });
    if (res.status === 401) window.location.replace('/login');
    const data = await res.json();
    if (!res.ok) throw data;
    return data;
  }

  function showContent() {
    document.getElementById('page-loading')?.classList.add('hidden');
    document.getElementById('page-content')?.classList.remove('hidden');
  }

  function escHtml(str) {
    const d = document.createElement('div');
    d.textContent = String(str ?? '');
    return d.innerHTML;
  }

  function initials(name) {
    if (!name) return '??';
    return name.split(' ').map(p => p[0]).join('').toUpperCase().substring(0, 2);
  }

  function gradeBadge(avg) {
    const v = parseFloat(avg) || 0;
    if (v > 75) return `<span class="inline-flex items-center rounded-full bg-green-500/15 text-green-400 px-2 py-0.5 text-xs font-medium">${v.toFixed(1)}</span>`;
    if (v >= 50) return `<span class="inline-flex items-center rounded-full bg-blue-500/15 text-blue-400 px-2 py-0.5 text-xs font-medium">${v.toFixed(1)}</span>`;
    return `<span class="inline-flex items-center rounded-full bg-yellow-500/15 text-yellow-400 px-2 py-0.5 text-xs font-medium">${v > 0 ? v.toFixed(1) : '-'}</span>`;
  }

  function finalGradeValue(student) {
    return student.final_grade ?? student.average_grade ?? student.avg_grade ?? student.gpa ?? '';
  }

  function normalizeStudents(items) {
    const groups = new Map();
    items.forEach((item) => {
      const studentId = item.student_id ?? item.id;
      const key = String(studentId ?? item.username ?? item.student_name ?? Math.random());
      if (!groups.has(key)) {
        groups.set(key, {
          student_id: studentId,
          student_name: item.student_name || `${item.first_name || ''} ${item.last_name || ''}`.trim() || item.username || 'Desconocido',
          email: item.email || '-',
          career_name: item.career_name || item.career || '-',
          final_grade: finalGradeValue(item),
          classes: [],
        });
      }
      const group = groups.get(key);
      const classes = Array.isArray(item.classes) ? item.classes : (item.class ? [item.class] : []);
      if (classes.length > 0) {
        classes.forEach((cls) => {
          const classId = cls.id ?? item.class_id ?? item.class;
          if (!group.classes.some((c) => String(c.id) === String(classId))) {
            group.classes.push({
              id: classId,
              subject_name: cls.subject_name || cls.subject?.name || item.subject_name || `Clase ${classId}`,
              current_grade: cls.current_grade ?? cls.final_grade ?? item.current_grade ?? item.final_grade ?? null,
              visible: cls.final_grade_visible ?? item.final_grade_visible ?? true,
            });
          }
        });
      } else if (item.class_id || item.class) {
        const classId = item.class_id ?? item.class;
        if (!group.classes.some((c) => String(c.id) === String(classId))) {
          group.classes.push({
            id: classId,
            subject_name: item.subject_name || item.class_name || `Clase ${classId}`,
            current_grade: item.current_grade ?? item.final_grade ?? null,
            visible: item.final_grade_visible ?? true,
          });
        }
      }
    });
    return Array.from(groups.values());
  }

  function renderStudentClassRow(studentId, cls) {
    const value = cls.current_grade ?? '';
    const scoreId = `final-grade-${studentId}-${cls.id}`;
    return `<tr data-class-row data-student-id="${studentId}" class="border-b border-border bg-muted/20">
      <td class="py-3 pl-12 pr-4 text-sm text-foreground">${escHtml(cls.subject_name)}</td>
      <td class="py-3 pr-4 text-sm text-muted-foreground">${cls.id}</td>
      <td class="py-3 pr-4 text-sm text-muted-foreground">${cls.visible ? 'Visible' : 'Oculta'}</td>
      <td class="py-3 pr-4">
        <input id="${scoreId}" data-testid="final-grade-input" data-class-id="${cls.id}" data-student-id="${studentId}" type="number" min="0" max="10" step="0.01" value="${value === '' || value == null ? '' : String(value)}" class="w-24 bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" placeholder="-" />
      </td>
      <td class="py-3 pr-4">
        <button type="button" data-testid="save-final-grade-btn" data-action="save" data-class-id="${cls.id}" data-student-id="${studentId}" class="rounded-lg bg-primary px-3 py-2 text-xs font-medium text-primary-foreground hover:bg-primary/90">Guardar</button>
        <button type="button" data-testid="clear-final-grade-btn" data-action="clear" data-class-id="${cls.id}" data-student-id="${studentId}" class="ml-2 rounded-lg border border-border px-3 py-2 text-xs font-medium text-foreground hover:bg-muted">Borrar</button>
      </td>
    </tr>`;
  }

  function updateStudentFinalGrade(studentId, classId, response, action, inputValue) {
    const nextClassGrade = action === 'clear' ? (response.final_grade ?? null) : inputValue;
    allStudents = allStudents.map((student) => {
      if (String(student.student_id) !== String(studentId)) return student;
      const nextClasses = (student.classes || []).map((cls) => {
        if (String(cls.id) !== String(classId)) return cls;
        return {
          ...cls,
          current_grade: nextClassGrade,
        };
      });
      return {
        ...student,
        final_grade: response.final_grade ?? null,
        classes: nextClasses,
      };
    });
    applyFilters();
  }

  function renderTable(students) {
    const tbody = document.getElementById('students-table-body');
    const empty = document.getElementById('students-empty');
    if (!tbody) return;
    if (students.length === 0) { tbody.innerHTML = ''; empty?.classList.remove('hidden'); return; }
    empty?.classList.add('hidden');
    tbody.innerHTML = students.map((s) => {
      const studentId = s.student_id;
      const rows = (s.classes || []).map((cls) => renderStudentClassRow(studentId, cls)).join('');
      return `<tr data-student-row class="border-b border-border hover:bg-muted/40 transition-colors" data-student-id="${studentId}">
        <td class="py-3 pr-4">
          <button type="button" class="flex w-full items-center gap-3 text-left student-expand-btn" data-student-id="${studentId}" aria-expanded="false">
            <div class="flex size-8 items-center justify-center rounded-full bg-primary/15 text-xs font-semibold text-primary">${initials(s.student_name)}</div>
            <div class="min-w-0">
              <p class="truncate text-sm font-medium text-foreground">${escHtml(s.student_name)}</p>
              <p class="truncate text-xs text-muted-foreground">${escHtml(s.email)}</p>
            </div>
          </button>
        </td>
        <td class="py-3 pr-4 text-sm text-muted-foreground">${escHtml(s.career_name)}</td>
        <td class="py-3 pr-4">${gradeBadge(s.final_grade)}</td>
        <td class="py-3 pr-4 text-sm text-muted-foreground">${(s.classes || []).length} clases</td>
      </tr>
      <tr class="hidden" data-student-classes-for="${studentId}"><td colspan="4" class="p-0"><table class="w-full">${rows}</table></td></tr>`;
    }).join('');

    tbody.querySelectorAll('.student-expand-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const studentId = (btn as HTMLElement).dataset.studentId;
        const row = tbody.querySelector(`[data-student-classes-for="${studentId}"]`);
        row?.classList.toggle('hidden');
        btn.setAttribute('aria-expanded', String(!row?.classList.contains('hidden')));
      });
    });

    tbody.querySelectorAll('button[data-action]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const classId = (btn as HTMLElement).dataset.classId;
        const studentId = (btn as HTMLElement).dataset.studentId;
        const action = (btn as HTMLElement).dataset.action;
        const input = tbody.querySelector(`#final-grade-${studentId}-${classId}`) as HTMLInputElement | null;
        if (!classId || !studentId) return;
        if (action === 'clear' && !window.confirm('¿Borrar la nota final de este estudiante?')) return;
        if (action === 'save') {
          const rawValue = input?.value ?? '';
          const score = rawValue === '' ? NaN : Number(rawValue);
          if (!Number.isFinite(score) || score < 0 || score > 10) {
            window.alert('La nota final debe estar entre 0 y 10.');
            input?.focus();
            return;
          }
        }
        const method = action === 'clear' ? 'DELETE' : 'PUT';
        const body = action === 'clear' ? undefined : JSON.stringify({ score: input?.value || '' });
        try {
          const response = await apiFetch(`/grades/classes/${classId}/students/${studentId}/final-grade/`, { method, body });
          updateStudentFinalGrade(studentId, classId, response, action, input?.value ?? null);
        } catch (error: unknown) {
          const err = error as { error?: string; detail?: string; non_field_errors?: string[] };
          const message = err?.error || err?.detail || err?.non_field_errors?.[0] || 'No se pudo guardar la nota final';
          window.alert(message);
        }
      });
    });
  }
  function matchesSearch(student, q) {
    if (!q) return true;
    return [student.student_name, student.email, student.career_name].some((value) => String(value || '').toLowerCase().includes(q));
  }

  function matchesClassFilter(student, classId) {
    if (!classId) return true;
    return (student.classes || []).some((cls) => String(cls.id) === String(classId));
  }

  function applyFilters() {
    const q = (document.getElementById('search-input') as HTMLInputElement)?.value?.toLowerCase() || '';
    const classId = (document.getElementById('class-filter') as HTMLSelectElement)?.value || '';
    renderTable(allStudents.filter((student) => matchesSearch(student, q) && matchesClassFilter(student, classId)));
  }
  let allStudents = [];

  document.getElementById('search-input')?.addEventListener('input', applyFilters);

  document.getElementById('class-filter')?.addEventListener('change', applyFilters);

  (async () => {
    // Rellena el filtro de clases
    try {
      const classData = await apiFetch('/academic/classes/my-classes/');
      const classes = Array.isArray(classData) ? classData : (classData.results || []);
      const sel = document.getElementById('class-filter') as HTMLSelectElement;
      classes.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.id;
          opt.textContent = c.subject_name || c.subject?.name || `Clase ${c.id}`;
        sel?.appendChild(opt);
      });
    } catch {}

    try {
      const data = await apiFetch('/grades/files/');
      allStudents = normalizeStudents(Array.isArray(data) ? data : (data.results || []));
      applyFilters();
    } catch {
      allStudents = [];
      document.getElementById('students-empty')?.classList.remove('hidden');
    }
    showContent();
  })();
</script>

