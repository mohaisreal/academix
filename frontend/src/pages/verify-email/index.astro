---
import "@/styles/starwind.css";
---

<html lang="en" class="dark">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>Verificar correo electrónico — Academix</title>
    </head>
    <body class="bg-background text-foreground">
        <div class="flex min-h-svh items-center justify-center p-6">
            <div class="w-full max-w-md text-center">
                <!-- Logo -->
                <div class="flex items-center justify-center gap-2.5 mb-8">
                    <div class="flex size-9 items-center justify-center rounded-lg bg-primary/10">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                        </svg>
                    </div>
                    <span class="text-xl font-bold tracking-tight text-foreground">academix</span>
                </div>

                <!-- Estado de carga -->
                <div id="state-loading" class="space-y-4">
                    <div class="flex size-16 items-center justify-center rounded-full bg-muted mx-auto">
                        <svg class="animate-spin text-primary" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                    </div>
                    <h2 class="text-xl font-semibold text-foreground">Verificando tu correo electrónico...</h2>
                    <p class="text-sm text-muted-foreground">Please wait a moment.</p>
                </div>

                <!-- Estado de éxito -->
                <div id="state-success" class="hidden space-y-4">
                    <div class="flex size-16 items-center justify-center rounded-full bg-emerald-500/15 mx-auto">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-400">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                            <polyline points="22 4 12 14.01 9 11.01"/>
                        </svg>
                    </div>
                    <h2 class="text-xl font-semibold text-foreground">Correo electrónico verificado</h2>
                    <p class="text-sm text-muted-foreground">
                        Un paso más: sube una prueba de identidad para que gestión confirme que eres quien dices ser.
                    </p>

                    <form id="identity-upload-form" class="rounded-xl border border-border bg-card p-4 text-left space-y-3">
                        <div>
                            <label for="identity-files" class="block text-sm font-medium text-foreground">Identity proof files</label>
                            <p class="mt-1 text-xs text-muted-foreground">Escaneo de DNI/NIE/pasaporte o cualquier justificante requerido. Se aceptan PDF o imágenes.</p>
                            <input id="identity-files" name="files" type="file" multiple required class="mt-3 block w-full text-sm text-muted-foreground file:mr-3 file:rounded-md file:border-0 file:bg-primary file:px-3 file:py-2 file:text-sm file:font-semibold file:text-primary-foreground hover:file:bg-primary/90" />
                        </div>
                        <button id="identity-upload-button" type="submit" class="w-full inline-flex items-center justify-center rounded-md bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground hover:bg-primary/90 transition-colors">
                            Send proofs for review
                        </button>
                        <p id="identity-upload-error" class="hidden text-sm text-destructive"></p>
                    </form>

                    <div id="identity-upload-success" class="hidden rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-4">
                        <p class="text-sm font-medium text-emerald-300">Proofs received.</p>
                        <p class="mt-1 text-xs text-muted-foreground">Gestión revisará tu identidad. Solo podrás iniciar sesión tras la aprobación.</p>
                        <a href="/login" class="mt-4 inline-flex items-center justify-center rounded-md border border-border px-5 py-2 text-sm font-medium text-foreground hover:bg-muted transition-colors">
                            Back to Sign In
                        </a>
                    </div>
                </div>

                <!-- Estado de error -->
                <div id="state-error" class="hidden space-y-4">
                    <div class="flex size-16 items-center justify-center rounded-full bg-destructive/15 mx-auto">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-destructive">
                            <circle cx="12" cy="12" r="10"/>
                            <line x1="12" y1="8" x2="12" y2="12"/>
                            <line x1="12" y1="16" x2="12.01" y2="16"/>
                        </svg>
                    </div>
                    <h2 class="text-xl font-semibold text-foreground">Verification failed</h2>
                    <p id="error-detail" class="text-sm text-muted-foreground">The verification link may be invalid or expired.</p>
                    <div class="flex flex-col gap-2 items-center">
                        <a href="/login" class="inline-flex items-center justify-center rounded-md bg-primary px-6 py-2.5 text-sm font-semibold text-primary-foreground hover:bg-primary/90 transition-colors">
                            Back to Sign In
                        </a>
                        <p class="text-xs text-muted-foreground">Need help? Contact support.</p>
                    </div>
                </div>

                <!-- Estado sin parámetros -->
                <div id="state-no-params" class="hidden space-y-4">
                    <div class="flex size-16 items-center justify-center rounded-full bg-yellow-500/15 mx-auto">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-yellow-400">
                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                            <line x1="12" y1="9" x2="12" y2="13"/>
                            <line x1="12" y1="17" x2="12.01" y2="17"/>
                        </svg>
                    </div>
                    <h2 class="text-xl font-semibold text-foreground">Invalid link</h2>
                    <p class="text-sm text-muted-foreground">A este enlace de verificación le faltan parámetros obligatorios. Usa el enlace de tu correo electrónico.</p>
                    <a href="/login" class="inline-flex items-center justify-center rounded-md border border-border px-6 py-2.5 text-sm font-medium text-foreground hover:bg-muted transition-colors">
                        Go to Sign In
                    </a>
                </div>
            </div>
        </div>
    </body>
</html>

<script>
    const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8000/api";
    let verifiedUid: string | null = null;
    let verifiedToken: string | null = null;

    function show(id: string) {
        ["state-loading", "state-success", "state-error", "state-no-params"].forEach(s => {
            document.getElementById(s)?.classList.toggle("hidden", s !== id);
        });
    }

    function showUploadError(message: string) {
        const el = document.getElementById("identity-upload-error");
        if (!el) return;
        el.textContent = message;
        el.classList.remove("hidden");
    }

    async function verify() {
        const params = new URLSearchParams(window.location.search);
        const uid = params.get("uid");
        const token = params.get("token");

        if (!uid || !token) {
            show("state-no-params");
            return;
        }

        try {
            const res = await fetch(`${API_URL}/auth/verify-email/?uid=${encodeURIComponent(uid)}&token=${encodeURIComponent(token)}`, {
                method: "GET",
                headers: { "Accept": "application/json" },
            });

            if (res.ok) {
                verifiedUid = uid;
                verifiedToken = token;
                show("state-success");
            } else {
                const json = await res.json().catch(() => ({}));
                const detail = document.getElementById("error-detail");
                if (detail) {
                    detail.textContent = json.detail || json.error || json.message || `Verification failed (${res.status}).`;
                }
                show("state-error");
            }
        } catch (err) {
            const detail = document.getElementById("error-detail");
            if (detail) detail.textContent = "Unable to reach the server. Please check your connection.";
            show("state-error");
        }
    }

    document.getElementById("identity-upload-form")?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const error = document.getElementById("identity-upload-error");
        error?.classList.add("hidden");

        if (!verifiedUid || !verifiedToken) {
            showUploadError("Falta el token de verificación. Abre de nuevo el enlace del correo electrónico.");
            return;
        }

        const input = document.getElementById("identity-files") as HTMLInputElement | null;
        const files = input?.files;
        if (!files || files.length === 0) {
            showUploadError("Select at least one file.");
            return;
        }

        const button = document.getElementById("identity-upload-button") as HTMLButtonElement | null;
        if (button) {
            button.disabled = true;
            button.textContent = "Uploading...";
        }

        const formData = new FormData();
        Array.from(files).forEach(file => formData.append("files", file));

        try {
            const res = await fetch(`${API_URL}/auth/identity-documents/?uid=${encodeURIComponent(verifiedUid)}&token=${encodeURIComponent(verifiedToken)}`, {
                method: "POST",
                body: formData,
                headers: { "Accept": "application/json" },
            });
            const json = await res.json().catch(() => ({}));
            if (!res.ok) {
                throw new Error(json.detail || json.error || `Upload failed (${res.status}).`);
            }

            document.getElementById("identity-upload-form")?.classList.add("hidden");
            document.getElementById("identity-upload-success")?.classList.remove("hidden");
        } catch (err) {
            showUploadError(err instanceof Error ? err.message : "Could not upload identity proofs.");
        } finally {
            if (button) {
                button.disabled = false;
                button.textContent = "Send proofs for review";
            }
        }
    });

    verify();
</script>
