---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
---
<DashboardLayout title="Reportes — Academix" currentPath="/reports">
  <div id="page-loading" class="p-6 space-y-4">
    <div class="h-12 bg-card rounded-xl border border-border animate-pulse"></div>
    <div class="h-96 bg-card rounded-xl border border-border animate-pulse"></div>
  </div>

  <div id="page-content" class="hidden flex" style="height:calc(100vh - 64px)">
    <!-- Barra lateral: lista de clases -->
    <div class="w-64 shrink-0 border-r border-border overflow-y-auto p-4">
      <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wide mb-3">Clases</p>
      <div id="class-list" class="space-y-2"></div>
    </div>

    <!-- Área principal -->
    <div class="flex-1 overflow-y-auto">
      <!-- Estado vacío -->
      <div id="reports-empty" class="flex flex-col items-center justify-center h-full text-center">
        <div class="flex size-16 items-center justify-center rounded-full bg-muted mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        </div>
        <p class="text-lg font-medium text-foreground">Seleccioná una clase para ver reportes</p>
        <p class="text-sm text-muted-foreground mt-1">Elegí una clase del panel izquierdo</p>
      </div>

      <!-- Contenido del reporte -->
      <div id="report-content" class="hidden p-6 space-y-6"></div>
    </div>
  </div>
</DashboardLayout>

<script>
  const STORAGE_KEY = "user-storage";
  const TOKEN_KEY = "access_token";
  const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8000/api";

  function getUser() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY))?.state?.user ?? null; }
    catch { return null; }
  }

  const token = localStorage.getItem(TOKEN_KEY);
  if (!token) window.location.replace('/login');
  const user = getUser();
  if (!user) window.location.replace('/login');
  const role = user?.role ?? '';

  if (role !== 't') window.location.replace('/');

  async function apiFetch(path, options = {}) {
    const res = await fetch(`${API_URL}${path}`, {
      headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
      ...options,
    });
    if (res.status === 401) window.location.replace('/login');
    return res.json();
  }

  function showContent() {
    document.getElementById('page-loading')?.classList.add('hidden');
    document.getElementById('page-content')?.classList.remove('hidden');
  }

  function escHtml(str) {
    const d = document.createElement('div');
    d.textContent = String(str ?? '');
    return d.innerHTML;
  }

  const DIST_RANGES = [
    { label: '0–49', min: 0, max: 49, color: 'bg-red-500' },
    { label: '50–59', min: 50, max: 59, color: 'bg-orange-500' },
    { label: '60–69', min: 60, max: 69, color: 'bg-yellow-500' },
    { label: '70–79', min: 70, max: 79, color: 'bg-blue-500' },
    { label: '80–89', min: 80, max: 89, color: 'bg-green-500' },
    { label: '90–100', min: 90, max: 100, color: 'bg-emerald-500' },
  ];

  async function loadReport(classId, className, periodName) {
    document.getElementById('reports-empty')?.classList.add('hidden');
    const content = document.getElementById('report-content');
    content?.classList.remove('hidden');
    if (content) content.innerHTML = '<div class="text-sm text-muted-foreground">Cargando reporte...</div>';

    try {
      const data = await apiFetch(`/grades/reports/${classId}/`);

      const totalStudents = data.total_students || 0;
      const mean = data.mean_score != null ? parseFloat(data.mean_score).toFixed(1) : '-';
      const passRate = data.pass_rate != null ? parseFloat(data.pass_rate).toFixed(1) : '-';
      const failCount = data.fail_count ?? data.failed_count ?? '-';

      // Distribución
      const allScores = data.student_scores || data.scores || [];
      const distCounts = DIST_RANGES.map(r => ({
        ...r,
        count: allScores.filter(s => parseFloat(s) >= r.min && parseFloat(s) <= r.max).length,
      }));
      const maxDistCount = Math.max(1, ...distCounts.map(d => d.count));

      const top5 = data.top_students || [];
      const bottom5 = data.bottom_students || [];
      const evalPerf = data.evaluations_performance || data.evaluation_stats || [];

      content.innerHTML = `
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-xl font-semibold text-foreground">${escHtml(className)}</h1>
            <p class="text-sm text-muted-foreground">${escHtml(periodName)}</p>
          </div>
        </div>

        <!-- KPI row -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          ${[
            { label: 'Total de estudiantes', value: totalStudents, color: 'text-primary' },
            { label: 'Puntaje promedio', value: mean + (mean !== '-' ? '%' : ''), color: 'text-blue-400' },
            { label: 'Tasa de aprobación', value: passRate + (passRate !== '-' ? '%' : ''), color: 'text-green-400' },
            { label: 'Cantidad de reprobados', value: failCount, color: 'text-red-400' },
          ].map(k => `
            <div class="kpi-card bg-card text-card-foreground rounded-xl border border-border p-5">
              <p class="text-sm text-muted-foreground mb-2">${k.label}</p>
              <p class="text-2xl font-bold ${k.color}">${k.value}</p>
            </div>
          `).join('')}
        </div>

        <!-- Distribución de puntajes -->
        <div class="bg-card text-card-foreground rounded-xl border border-border p-5">
          <h2 class="text-lg font-semibold text-foreground mb-4">Distribución de puntajes</h2>
          <div class="space-y-3">
            ${distCounts.map(d => `
              <div class="flex items-center gap-3">
                <span class="text-xs text-muted-foreground w-14 shrink-0">${d.label}</span>
                <div class="flex-1 bg-muted rounded-full h-5 overflow-hidden">
                  <div class="${d.color} h-full rounded-full transition-all flex items-center justify-end pr-2" style="width:${(d.count / maxDistCount) * 100}%;min-width:${d.count > 0 ? '28px' : '0'}">
                    ${d.count > 0 ? `<span class="text-white text-xs font-medium">${d.count}</span>` : ''}
                  </div>
                </div>
                <span class="text-xs text-muted-foreground w-6 shrink-0 text-right">${d.count}</span>
              </div>
            `).join('')}
          </div>
        </div>

        <!-- Mejores/peores estudiantes -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="bg-card text-card-foreground rounded-xl border border-border p-5">
            <h2 class="text-lg font-semibold text-foreground mb-4">Mejores 5 estudiantes</h2>
            <table class="w-full">
              <thead><tr class="border-b border-border">
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-2">Nombre</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-2">Prom.</th>
              </tr></thead>
              <tbody>
                ${top5.map(s => `<tr class="border-b border-border hover:bg-muted/40">
                  <td class="py-2 text-sm text-foreground">${escHtml(s.student_name || s.name || '-')}</td>
                  <td class="py-2"><span class="text-sm font-semibold text-green-400">${parseFloat(s.average || s.avg || 0).toFixed(1)}%</span></td>
                </tr>`).join('')}
                ${top5.length === 0 ? '<tr><td colspan="2" class="py-4 text-center text-xs text-muted-foreground">Sin datos</td></tr>' : ''}
              </tbody>
            </table>
          </div>
          <div class="bg-card text-card-foreground rounded-xl border border-border p-5">
            <h2 class="text-lg font-semibold text-foreground mb-4">Últimos 5 estudiantes</h2>
            <table class="w-full">
              <thead><tr class="border-b border-border">
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-2">Nombre</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-2">Prom.</th>
              </tr></thead>
              <tbody>
                ${bottom5.map(s => `<tr class="border-b border-border hover:bg-muted/40">
                  <td class="py-2 text-sm text-foreground">${escHtml(s.student_name || s.name || '-')}</td>
                  <td class="py-2"><span class="text-sm font-semibold text-red-400">${parseFloat(s.average || s.avg || 0).toFixed(1)}%</span></td>
                </tr>`).join('')}
                ${bottom5.length === 0 ? '<tr><td colspan="2" class="py-4 text-center text-xs text-muted-foreground">Sin datos</td></tr>' : ''}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Rendimiento de evaluaciones -->
        <div class="bg-card text-card-foreground rounded-xl border border-border p-5">
          <h2 class="text-lg font-semibold text-foreground mb-4">Rendimiento de evaluaciones</h2>
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead><tr class="border-b border-border">
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Evaluación</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Tipo</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Puntaje prom.</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Tasa de entrega</th>
              </tr></thead>
              <tbody>
                ${evalPerf.map(e => {
                  const typeBg = { exam: 'bg-purple-500/15 text-purple-400', quiz: 'bg-blue-500/15 text-blue-400', assignment: 'bg-orange-500/15 text-orange-400' };
                  const t = e.type || 'other';
                  const c = typeBg[t] || 'bg-muted text-muted-foreground';
                  const rate = e.submission_rate != null ? parseFloat(e.submission_rate).toFixed(1) + '%' : '-';
                  return `<tr class="border-b border-border hover:bg-muted/40">
                    <td class="py-3 pr-4 text-sm text-foreground">${escHtml(e.name || '-')}</td>
                    <td class="py-3 pr-4"><span class="inline-flex items-center rounded-full ${c} px-2 py-0.5 text-xs capitalize">${t}</span></td>
                    <td class="py-3 pr-4 text-sm font-medium text-foreground">${e.average_score != null ? parseFloat(e.average_score).toFixed(1) + '%' : '-'}</td>
                    <td class="py-3 text-sm text-muted-foreground">${rate}</td>
                  </tr>`;
                }).join('')}
                ${evalPerf.length === 0 ? '<tr><td colspan="4" class="py-4 text-center text-xs text-muted-foreground">Sin datos de evaluaciones</td></tr>' : ''}
              </tbody>
            </table>
          </div>
        </div>
      `;
    } catch {
      if (content) content.innerHTML = '<div class="p-6 text-sm text-red-400">No se pudieron cargar los datos del reporte</div>';
    }
  }

  (async () => {
    const urlParams = new URLSearchParams(window.location.search);
    const preClass = urlParams.get('class');

    try {
      const data = await apiFetch('/academic/classes/my-classes/');
      const classes = Array.isArray(data) ? data : (data.results || []);
      const list = document.getElementById('class-list');
      if (list) {
        list.innerHTML = classes.map(c => {
          const subject = c.subject_name || c.subject?.name || 'Clase';
          const period = c.period_name || c.period?.name || '';
          return `<div class="class-item cursor-pointer rounded-lg border border-border p-3 hover:border-primary/50 hover:bg-muted/40 transition-colors" data-id="${c.id}" data-name="${escHtml(subject)}" data-period="${escHtml(period)}">
            <p class="text-sm font-medium text-foreground">${escHtml(subject)}</p>
            <p class="text-xs text-muted-foreground mt-0.5">${escHtml(period)}</p>
          </div>`;
        }).join('');

        list.querySelectorAll('.class-item').forEach(el => {
          el.addEventListener('click', () => {
            list.querySelectorAll('.class-item').forEach(i => i.classList.remove('border-primary', 'bg-primary/5'));
            el.classList.add('border-primary', 'bg-primary/5');
            loadReport((el as HTMLElement).dataset.id, (el as HTMLElement).dataset.name, (el as HTMLElement).dataset.period);
          });
        });

        if (preClass) {
          const el = document.querySelector(`.class-item[data-id="${preClass}"]`) as HTMLElement;
          if (el) el.click();
        }
      }
    } catch {}
    showContent();
  })();
</script>
