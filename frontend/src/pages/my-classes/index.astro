---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
---
<DashboardLayout title="Mis clases — Academix" currentPath="/my-classes">
  <div id="page-loading" class="space-y-4 p-4 sm:p-6">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <div class="h-28 bg-card rounded-xl border border-border animate-pulse"></div>
      <div class="h-28 bg-card rounded-xl border border-border animate-pulse"></div>
      <div class="h-28 bg-card rounded-xl border border-border animate-pulse"></div>
      <div class="h-28 bg-card rounded-xl border border-border animate-pulse"></div>
    </div>
    <div class="h-64 bg-card rounded-xl border border-border animate-pulse"></div>
  </div>

  <div id="page-content" class="hidden">
    <div class="flex flex-col gap-3 border-b border-border px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <div>
        <h1 class="text-xl font-semibold text-foreground">Mis clases</h1>
        <p class="text-sm text-muted-foreground">Clases asignadas para este periodo</p>
      </div>
    </div>

    <div class="space-y-6 p-4 sm:p-6">
      <!-- Fila de KPI -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4" id="kpi-row"></div>

      <!-- Tabla de clases -->
      <div class="bg-card text-card-foreground rounded-xl border border-border p-4 sm:p-5">
        <h2 class="text-lg font-semibold text-foreground mb-4">Lista de clases</h2>
        <div class="hidden overflow-x-auto md:block">
          <table class="min-w-[920px] w-full">
            <thead>
              <tr class="border-b border-border">
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Asignatura</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">periodo</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Aula</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Estudiantes</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Pendientes</th>
          <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Nota mínima</th>
          <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Final visible</th>
          <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Acciones</th>
              </tr>
            </thead>
            <tbody id="classes-table-body"></tbody>
          </table>
        </div>
        <div id="classes-cards" class="space-y-3 md:hidden"></div>
        <div id="classes-empty" class="hidden py-10 text-center text-sm text-muted-foreground">
          No hay clases asignadas para el periodo actual
        </div>
      </div>
    </div>
  </div>

  <div id="policy-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
    <div class="w-full max-w-lg rounded-2xl border border-border bg-card p-5 text-card-foreground shadow-xl">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="text-lg font-semibold text-foreground">Editar política de clase</h2>
          <p id="policy-modal-class" class="text-sm text-muted-foreground"></p>
        </div>
        <button type="button" id="policy-modal-close" class="rounded-lg border border-border px-3 py-1 text-sm hover:bg-muted">Cerrar</button>
      </div>
      <form id="policy-form" class="mt-5 space-y-4">
        <input type="hidden" id="policy-class-id" />
        <label class="block space-y-1 text-sm">
          <span class="text-muted-foreground">Nota mínima para aprobar</span>
          <input id="policy-passing-grade" type="number" step="0.1" min="0" max="10" class="w-full rounded-lg border border-border bg-input px-3 py-2 text-sm text-foreground" />
        </label>
        <label class="flex items-center gap-2 rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground">
          <input id="policy-final-visible" type="checkbox" class="size-4 rounded border-border text-primary" />
          <span>Mostrar nota final al alumno</span>
        </label>
        <div class="flex justify-end gap-2">
          <button type="button" id="policy-modal-cancel" class="rounded-lg border border-border px-4 py-2 text-sm hover:bg-muted">Cancelar</button>
          <button type="submit" id="policy-modal-save" class="rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground">Guardar política</button>
        </div>
      </form>
    </div>
  </div>
</DashboardLayout>

<script>
  import API_BASE_URL from '@/config/api';
  const STORAGE_KEY = "user-storage";
  const TOKEN_KEY = "access_token";
  const API_URL = API_BASE_URL;

  function getUser() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY))?.state?.user ?? null; }
    catch { return null; }
  }

  const token = localStorage.getItem(TOKEN_KEY);
  if (!token) window.location.replace('/login');
  const user = getUser();
  if (!user) window.location.replace('/login');
  const role = user?.role ?? '';

  if (role !== 't') window.location.replace('/');

  async function apiFetch(path, options = {}) {
    const res = await fetch(`${API_URL}${path}`, {
      headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
      ...options,
    });
    if (res.status === 401) window.location.replace('/login');
    return res.json();
  }

  function showContent() {
    document.getElementById('page-loading')?.classList.add('hidden');
    document.getElementById('page-content')?.classList.remove('hidden');
  }

  function escHtml(str) {
    const d = document.createElement('div');
    d.textContent = String(str ?? '');
    return d.innerHTML;
  }

  const modal = document.getElementById('policy-modal');
  const modalClass = document.getElementById('policy-modal-class');
  const modalClose = document.getElementById('policy-modal-close');
  const modalCancel = document.getElementById('policy-modal-cancel');
  const modalForm = document.getElementById('policy-form');
  const modalClassId = document.getElementById('policy-class-id');
  const modalPassing = document.getElementById('policy-passing-grade');
  const modalVisible = document.getElementById('policy-final-visible');

  function openPolicyModal(c) {
    if (!modal || !modalClassId || !modalPassing || !modalVisible) return;
    modalClassId.value = String(c.id);
    modalPassing.value = c.passing_grade != null ? String(c.passing_grade) : '';
    modalVisible.checked = c.show_final_grade_to_students ?? c.final_grade_visible ?? true;
    if (modalClass) modalClass.textContent = `${c.subject_name || c.subject?.name || 'Asignatura'} · ${c.period_name || c.period?.name || '-'}`;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closePolicyModal() {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  modalClose?.addEventListener('click', closePolicyModal);
  modalCancel?.addEventListener('click', closePolicyModal);
  modal?.addEventListener('click', (e) => { if (e.target === modal) closePolicyModal(); });

  function renderClassCards(classes) {
    const cards = document.getElementById('classes-cards');
    if (!cards) return;
    cards.innerHTML = classes.map(c => {
      const subject = c.subject_name || c.subject?.name || 'Asignatura';
      const period = c.period_name || c.period?.name || '-';
      const classroom = c.classroom_name || c.classroom?.name || '-';
      const students = c.student_count || c.students_count || 0;
      const pend = c.pending_grades || c.pending_count || 0;
      const passing = c.passing_grade != null ? parseFloat(c.passing_grade).toFixed(1) : '-';
      const finalVisible = c.show_final_grade_to_students ?? c.final_grade_visible ?? true;
      return `<article class="rounded-xl border border-border bg-muted/20 p-4 space-y-3">
        <div class="flex items-start justify-between gap-3">
          <div>
            <p class="text-sm font-semibold text-foreground">${escHtml(subject)}</p>
            <p class="text-xs text-muted-foreground">${escHtml(period)}</p>
          </div>
          ${pend > 0 ? `<span class="inline-flex items-center rounded-full bg-yellow-500/15 text-yellow-400 px-2 py-0.5 text-xs font-medium">${pend} pendientes</span>` : '<span class="inline-flex items-center rounded-full bg-green-500/15 text-green-400 px-2 py-0.5 text-xs font-medium">Sin pendientes</span>'}
        </div>
        <dl class="grid grid-cols-2 gap-3 text-sm">
          <div><dt class="text-xs uppercase tracking-wide text-muted-foreground">Aula</dt><dd class="mt-1 text-foreground">${escHtml(classroom)}</dd></div>
          <div><dt class="text-xs uppercase tracking-wide text-muted-foreground">Estudiantes</dt><dd class="mt-1 text-foreground">${students}</dd></div>
          <div><dt class="text-xs uppercase tracking-wide text-muted-foreground">Nota mínima</dt><dd class="mt-1 text-foreground">${passing}</dd></div>
          <div><dt class="text-xs uppercase tracking-wide text-muted-foreground">Visible</dt><dd class="mt-1 text-foreground">${finalVisible ? 'Sí' : 'No'}</dd></div>
        </dl>
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          <div class="text-sm text-muted-foreground">Política actual: mínima ${passing}, final ${finalVisible ? 'visible' : 'oculta'}</div>
        </div>
        <div class="flex flex-wrap gap-2">
          <button type="button" class="class-policy-edit inline-flex items-center rounded-lg bg-primary/10 px-2.5 py-1 text-xs font-medium text-primary transition-colors hover:bg-primary/20" data-class-id="${c.id}">Editar política</button>
          <a href="/marking?class=${c.id}" class="inline-flex items-center rounded-lg bg-primary/10 px-2.5 py-1 text-xs font-medium text-primary transition-colors hover:bg-primary/20">Calificar</a>
          <a href="/material?class=${c.id}" class="inline-flex items-center rounded-lg border border-border px-2.5 py-1 text-xs font-medium text-foreground transition-colors hover:bg-muted">Materiales</a>
          <a href="/reports?class=${c.id}" class="inline-flex items-center rounded-lg border border-border px-2.5 py-1 text-xs font-medium text-foreground transition-colors hover:bg-muted">Reportes</a>
        </div>
      </article>`;
    }).join('');
  }

  (async () => {
    try {
      const data = await apiFetch('/academic/classes/my-classes/');
      const classes = Array.isArray(data) ? data : (data.results || []);

      const totalStudents = classes.reduce((s, c) => s + (c.student_count || c.students_count || 0), 0);
      const pending = classes.reduce((s, c) => s + (c.pending_grades || c.pending_count || 0), 0);
      const allAvgs = classes.filter(c => c.average_score != null || c.avg_score != null).map(c => parseFloat(c.average_score || c.avg_score || 0));
      const avgScore = allAvgs.length ? (allAvgs.reduce((a, b) => a + b, 0) / allAvgs.length).toFixed(1) : '-';

      const kpiRow = document.getElementById('kpi-row');
      if (kpiRow) {
        kpiRow.innerHTML = [
          { label: 'Clases activas', value: classes.length, icon: '<path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 6 3 6 3s3 0 6-3v-5"/>', color: 'text-primary' },
          { label: 'Total de estudiantes', value: totalStudents, icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>', color: 'text-blue-400' },
          { label: 'Calificaciones pendientes', value: pending, icon: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>', color: 'text-yellow-400' },
          { label: 'Promedio', value: avgScore === '-' ? '-' : avgScore + '%', icon: '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>', color: 'text-green-400' },
        ].map(k => `
          <div class="kpi-card bg-card text-card-foreground rounded-xl border border-border p-5">
            <div class="flex items-center justify-between mb-3">
              <p class="text-sm text-muted-foreground">${k.label}</p>
              <div class="flex size-8 items-center justify-center rounded-full bg-muted">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${k.color}">${k.icon}</svg>
              </div>
            </div>
            <p class="text-2xl font-bold ${k.color}">${k.value}</p>
          </div>
        `).join('');
      }

      const tbody = document.getElementById('classes-table-body');
      const empty = document.getElementById('classes-empty');

      if (classes.length === 0) {
        empty?.classList.remove('hidden');
        showContent();
        return;
      }

      tbody.innerHTML = classes.map(c => {
        const subject = c.subject_name || c.subject?.name || 'Asignatura';
        const period = c.period_name || c.period?.name || '-';
        const classroom = c.classroom_name || c.classroom?.name || '-';
        const students = c.student_count || c.students_count || 0;
        const pend = c.pending_grades || c.pending_count || 0;
        const passing = c.passing_grade != null ? parseFloat(c.passing_grade).toFixed(1) : '-';
        const finalVisible = c.show_final_grade_to_students ?? c.final_grade_visible ?? true;
        return `<tr class="border-b border-border hover:bg-muted/40 transition-colors">
          <td class="py-3 pr-4 text-sm font-medium text-foreground">${escHtml(subject)}</td>
          <td class="py-3 pr-4 text-sm text-muted-foreground">${escHtml(period)}</td>
          <td class="py-3 pr-4 text-sm text-muted-foreground">${escHtml(classroom)}</td>
          <td class="py-3 pr-4 text-sm text-muted-foreground">${students}</td>
          <td class="py-3 pr-4">
            ${pend > 0 ? `<span class="inline-flex items-center rounded-full bg-yellow-500/15 text-yellow-400 px-2 py-0.5 text-xs font-medium">${pend}</span>` : '<span class="text-sm text-muted-foreground">0</span>'}
          </td>
          <td class="py-3 pr-4 text-sm font-medium text-foreground">${passing}</td>
          <td class="py-3 pr-4 text-sm text-foreground">${finalVisible ? 'Sí' : 'No'}</td>
            <td class="py-3">
            <div class="flex flex-wrap gap-2">
              <button type="button" class="class-policy-edit inline-flex items-center rounded-lg bg-primary/10 px-2.5 py-1 text-xs font-medium text-primary transition-colors hover:bg-primary/20" data-class-id="${c.id}">Editar política</button>
              <a href="/marking?class=${c.id}" class="inline-flex items-center rounded-lg bg-primary/10 px-2.5 py-1 text-xs font-medium text-primary transition-colors hover:bg-primary/20">Calificar</a>
              <a href="/material?class=${c.id}" class="inline-flex items-center rounded-lg border border-border px-2.5 py-1 text-xs font-medium text-foreground transition-colors hover:bg-muted">Materiales</a>
              <a href="/reports?class=${c.id}" class="inline-flex items-center rounded-lg border border-border px-2.5 py-1 text-xs font-medium text-foreground transition-colors hover:bg-muted">Reportes</a>
            </div>
          </td>
        </tr>`;
      }).join('');
      renderClassCards(classes);

      async function savePolicy(classId) {
        const passingGrade = modalPassing?.value === '' ? null : parseFloat((modalPassing as HTMLInputElement)?.value || '');
        const showFinalGradeToStudents = !!(modalVisible as HTMLInputElement | null)?.checked;
        const res = await fetch(`${API_URL}/academic/classes/${classId}/grading-policy/`, {
          method: 'PATCH',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ passing_grade: passingGrade, show_final_grade_to_students: showFinalGradeToStudents }),
        });
        if (res.status === 401) window.location.replace('/login');
        return res.json();
      }

      document.querySelectorAll('.class-policy-edit').forEach(btn => {
        btn.addEventListener('click', async () => {
          const classId = (btn as HTMLElement).dataset.classId;
          if (!classId) return;
          const cls = classes.find(c => String(c.id) === String(classId));
          if (cls) openPolicyModal(cls);
        });
      });

      modalForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const classId = (modalClassId as HTMLInputElement | null)?.value;
        if (!classId) return;
        const saveBtn = document.getElementById('policy-modal-save') as HTMLButtonElement | null;
        const prevText = saveBtn?.textContent;
        if (saveBtn) {
          saveBtn.disabled = true;
          saveBtn.textContent = 'Guardando...';
        }
        try {
          await savePolicy(classId);
          closePolicyModal();
        } finally {
          if (saveBtn) {
            saveBtn.disabled = false;
            saveBtn.textContent = prevText || 'Guardar política';
          }
        }
      });
    } catch {
      document.getElementById('classes-empty')?.classList.remove('hidden');
    }
    showContent();
  })();
</script>

