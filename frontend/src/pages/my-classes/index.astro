---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
---
<DashboardLayout title="Mis clases — Academix" currentPath="/my-classes">
  <div id="page-loading" class="p-6 space-y-4">
    <div class="grid grid-cols-4 gap-4">
      <div class="h-28 bg-card rounded-xl border border-border animate-pulse"></div>
      <div class="h-28 bg-card rounded-xl border border-border animate-pulse"></div>
      <div class="h-28 bg-card rounded-xl border border-border animate-pulse"></div>
      <div class="h-28 bg-card rounded-xl border border-border animate-pulse"></div>
    </div>
    <div class="h-64 bg-card rounded-xl border border-border animate-pulse"></div>
  </div>

  <div id="page-content" class="hidden">
    <div class="flex items-center justify-between border-b border-border px-6 py-4">
      <div>
        <h1 class="text-xl font-semibold text-foreground">Mis clases</h1>
        <p class="text-sm text-muted-foreground">Clases asignadas para este periodo</p>
      </div>
    </div>

    <div class="p-6 space-y-6">
      <!-- Fila de KPI -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4" id="kpi-row"></div>

      <!-- Tabla de clases -->
      <div class="bg-card text-card-foreground rounded-xl border border-border p-5">
        <h2 class="text-lg font-semibold text-foreground mb-4">Lista de clases</h2>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-border">
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Asignatura</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">periodo</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Aula</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Estudiantes</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Pendientes</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Promedio</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Acciones</th>
              </tr>
            </thead>
            <tbody id="classes-table-body"></tbody>
          </table>
        </div>
        <div id="classes-empty" class="hidden py-10 text-center text-sm text-muted-foreground">
          No hay clases asignadas para el periodo actual
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  const STORAGE_KEY = "user-storage";
  const TOKEN_KEY = "access_token";
  const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8000/api";

  function getUser() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY))?.state?.user ?? null; }
    catch { return null; }
  }

  const token = localStorage.getItem(TOKEN_KEY);
  if (!token) window.location.replace('/login');
  const user = getUser();
  if (!user) window.location.replace('/login');
  const role = user?.role ?? '';

  if (role !== 't') window.location.replace('/');

  async function apiFetch(path, options = {}) {
    const res = await fetch(`${API_URL}${path}`, {
      headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
      ...options,
    });
    if (res.status === 401) window.location.replace('/login');
    return res.json();
  }

  function showContent() {
    document.getElementById('page-loading')?.classList.add('hidden');
    document.getElementById('page-content')?.classList.remove('hidden');
  }

  function escHtml(str) {
    const d = document.createElement('div');
    d.textContent = String(str ?? '');
    return d.innerHTML;
  }

  (async () => {
    try {
      const data = await apiFetch('/academic/classes/my-classes/');
      const classes = Array.isArray(data) ? data : (data.results || []);

      const totalStudents = classes.reduce((s, c) => s + (c.student_count || c.students_count || 0), 0);
      const pending = classes.reduce((s, c) => s + (c.pending_grades || c.pending_count || 0), 0);
      const allAvgs = classes.filter(c => c.average_score != null || c.avg_score != null).map(c => parseFloat(c.average_score || c.avg_score || 0));
      const avgScore = allAvgs.length ? (allAvgs.reduce((a, b) => a + b, 0) / allAvgs.length).toFixed(1) : '-';

      const kpiRow = document.getElementById('kpi-row');
      if (kpiRow) {
        kpiRow.innerHTML = [
          { label: 'Clases activas', value: classes.length, icon: '<path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 6 3 6 3s3 0 6-3v-5"/>', color: 'text-primary' },
          { label: 'Total de estudiantes', value: totalStudents, icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>', color: 'text-blue-400' },
          { label: 'Calificaciones pendientes', value: pending, icon: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>', color: 'text-yellow-400' },
          { label: 'Promedio', value: avgScore === '-' ? '-' : avgScore + '%', icon: '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>', color: 'text-green-400' },
        ].map(k => `
          <div class="kpi-card bg-card text-card-foreground rounded-xl border border-border p-5">
            <div class="flex items-center justify-between mb-3">
              <p class="text-sm text-muted-foreground">${k.label}</p>
              <div class="flex size-8 items-center justify-center rounded-full bg-muted">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${k.color}">${k.icon}</svg>
              </div>
            </div>
            <p class="text-2xl font-bold ${k.color}">${k.value}</p>
          </div>
        `).join('');
      }

      const tbody = document.getElementById('classes-table-body');
      const empty = document.getElementById('classes-empty');

      if (classes.length === 0) {
        empty?.classList.remove('hidden');
        showContent();
        return;
      }

      tbody.innerHTML = classes.map(c => {
        const subject = c.subject_name || c.subject?.name || 'Asignatura';
        const period = c.period_name || c.period?.name || '-';
        const classroom = c.classroom_name || c.classroom?.name || '-';
        const students = c.student_count || c.students_count || 0;
        const pend = c.pending_grades || c.pending_count || 0;
        const avg = c.average_score != null ? parseFloat(c.average_score).toFixed(1) + '%' : (c.avg_score != null ? parseFloat(c.avg_score).toFixed(1) + '%' : '-');
        return `<tr class="border-b border-border hover:bg-muted/40 transition-colors">
          <td class="py-3 pr-4 text-sm font-medium text-foreground">${escHtml(subject)}</td>
          <td class="py-3 pr-4 text-sm text-muted-foreground">${escHtml(period)}</td>
          <td class="py-3 pr-4 text-sm text-muted-foreground">${escHtml(classroom)}</td>
          <td class="py-3 pr-4 text-sm text-muted-foreground">${students}</td>
          <td class="py-3 pr-4">
            ${pend > 0 ? `<span class="inline-flex items-center rounded-full bg-yellow-500/15 text-yellow-400 px-2 py-0.5 text-xs font-medium">${pend}</span>` : '<span class="text-sm text-muted-foreground">0</span>'}
          </td>
          <td class="py-3 pr-4 text-sm font-medium text-foreground">${avg}</td>
          <td class="py-3">
            <div class="flex items-center gap-2">
              <a href="/marking?class=${c.id}" class="inline-flex items-center rounded-lg bg-primary/10 px-2.5 py-1 text-xs font-medium text-primary hover:bg-primary/20 transition-colors">Calificar</a>
              <a href="/material?class=${c.id}" class="inline-flex items-center rounded-lg border border-border px-2.5 py-1 text-xs font-medium text-foreground hover:bg-muted transition-colors">Materiales</a>
              <a href="/reports?class=${c.id}" class="inline-flex items-center rounded-lg border border-border px-2.5 py-1 text-xs font-medium text-foreground hover:bg-muted transition-colors">Reportes</a>
            </div>
          </td>
        </tr>`;
      }).join('');
    } catch {
      document.getElementById('classes-empty')?.classList.remove('hidden');
    }
    showContent();
  })();
</script>
