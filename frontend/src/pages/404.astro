---
const title = 'Página no encontrada — Academix';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-background text-foreground flex items-center justify-center p-6">
    <main class="max-w-md space-y-4 text-center">
      <p class="text-sm uppercase tracking-[0.3em] text-muted-foreground">404</p>
      <h1 class="text-3xl font-semibold">Página no encontrada</h1>
      <p class="text-base text-muted-foreground">La ruta que buscabas no existe o fue movida.</p>
      <a href="/" class="inline-flex items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground">Volver al inicio</a>
    </main>
  </body>
</html>
