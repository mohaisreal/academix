---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
---
<DashboardLayout title="Students — Academix" currentPath="/students">
  <div id="page-loading" class="p-6 space-y-4">
    <div class="h-12 bg-card rounded-xl border border-border animate-pulse"></div>
    <div class="h-64 bg-card rounded-xl border border-border animate-pulse"></div>
  </div>

  <div id="page-content" class="hidden">
    <div class="border-b border-border px-6 py-4">
      <h1 class="text-xl font-semibold text-foreground">Students</h1>
      <p class="text-sm text-muted-foreground">Browse and manage all students</p>
    </div>

    <div class="p-6 space-y-4">
      <!-- Search + filters -->
      <div class="flex flex-wrap gap-3">
        <div class="relative flex-1 min-w-48">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0"/></svg>
          <input id="search-input" type="text" placeholder="Search students..." class="pl-9 pr-4 py-2 w-full bg-input border border-border rounded-lg text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
        </div>
        <select id="filter-career" class="bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
          <option value="">All Careers</option>
        </select>
      </div>

      <div class="bg-card text-card-foreground rounded-xl border border-border overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-border bg-muted/50">
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide px-4 py-3">Student</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide px-4 py-3">Email</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide px-4 py-3">Career</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide px-4 py-3">GPA</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide px-4 py-3">Status</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide px-4 py-3">Actions</th>
              </tr>
            </thead>
            <tbody id="students-table"></tbody>
          </table>
        </div>
        <div id="students-empty" class="hidden py-10 text-center text-sm text-muted-foreground">No students found</div>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  const STORAGE_KEY = "user-storage";
  const TOKEN_KEY = "access_token";
  const API_URL = "http://localhost:8000/api";

  function getUser() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY))?.state?.user ?? null; }
    catch { return null; }
  }
  const token = localStorage.getItem(TOKEN_KEY);
  if (!token) window.location.replace('/login');
  const user = getUser();
  if (!user) window.location.replace('/login');
  if (!['m','a','t'].includes(user.role)) window.location.replace('/');

  async function apiFetch(path, options = {}) {
    const res = await fetch(`${API_URL}${path}`, {
      headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
      ...options,
    });
    if (res.status === 401) window.location.replace('/login');
    if (res.status === 204) return {};
    return res.json();
  }

  function escHtml(str) {
    const d = document.createElement('div');
    d.textContent = String(str ?? '');
    return d.innerHTML;
  }

  let allStudents = [];
  let searchQuery = '';
  let filterCareer = '';

  function renderTable() {
    let filtered = allStudents;
    if (searchQuery) {
      const q = searchQuery.toLowerCase();
      filtered = filtered.filter(s =>
        (s.first_name + ' ' + s.last_name).toLowerCase().includes(q) || s.email?.toLowerCase().includes(q)
      );
    }
    if (filterCareer) {
      filtered = filtered.filter(s => String(s.career_id ?? s.career) === filterCareer || s.career_name?.toLowerCase().includes(filterCareer));
    }

    const tbody = document.getElementById('students-table');
    const empty = document.getElementById('students-empty');
    if (!tbody) return;
    if (filtered.length === 0) {
      tbody.innerHTML = '';
      empty?.classList.remove('hidden');
      return;
    }
    empty?.classList.add('hidden');
    tbody.innerHTML = filtered.map(s => {
      const active = s.is_active !== false;
      const gpa = s.gpa != null ? Number(s.gpa).toFixed(2) : '—';
      const initials = ((s.first_name?.[0] ?? '') + (s.last_name?.[0] ?? '')).toUpperCase() || '?';
      return `<tr class="border-b border-border hover:bg-muted/40 transition-colors">
        <td class="px-4 py-3">
          <div class="flex items-center gap-3">
            <div class="size-8 rounded-full bg-primary/15 flex items-center justify-center text-xs font-semibold text-primary">
              ${escHtml(initials)}
            </div>
            <span class="text-sm font-medium text-foreground">${escHtml(s.first_name)} ${escHtml(s.last_name)}</span>
          </div>
        </td>
        <td class="px-4 py-3 text-sm text-muted-foreground">${escHtml(s.email ?? '—')}</td>
        <td class="px-4 py-3 text-sm text-muted-foreground">${escHtml(s.career_name ?? '—')}</td>
        <td class="px-4 py-3 text-sm font-medium ${Number(gpa) >= 70 ? 'text-green-400' : Number(gpa) >= 50 ? 'text-yellow-400' : 'text-muted-foreground'}">${gpa}</td>
        <td class="px-4 py-3">
          <span class="inline-flex items-center rounded-full ${active ? 'bg-green-500/15 text-green-400' : 'bg-muted text-muted-foreground'} px-2 py-0.5 text-xs font-medium">
            ${active ? 'Active' : 'Inactive'}
          </span>
        </td>
        <td class="px-4 py-3">
          <div class="flex items-center gap-2">
            <a href="/files?student=${s.id}" class="rounded-lg border border-border px-2.5 py-1 text-xs font-medium text-foreground hover:bg-muted transition-colors">View File</a>
          </div>
        </td>
      </tr>`;
    }).join('');
  }

  async function loadStudents() {
    const [sData, cData] = await Promise.all([
      apiFetch('/users/students/'),
      apiFetch('/academic/careers/'),
    ]);
    allStudents = Array.isArray(sData) ? sData : (sData?.results ?? []);
    const careers = Array.isArray(cData) ? cData : (cData?.results ?? []);

    const careerSel = document.getElementById('filter-career') as HTMLSelectElement;
    careers.forEach(c => {
      const opt = document.createElement('option');
      opt.value = c.id; opt.textContent = c.name;
      careerSel.appendChild(opt);
    });

    renderTable();
    document.getElementById('page-loading')?.classList.add('hidden');
    document.getElementById('page-content')?.classList.remove('hidden');
  }

  document.getElementById('search-input')?.addEventListener('input', e => {
    searchQuery = (e.target as HTMLInputElement).value;
    renderTable();
  });
  document.getElementById('filter-career')?.addEventListener('change', e => {
    filterCareer = (e.target as HTMLSelectElement).value;
    renderTable();
  });

  loadStudents();
</script>
