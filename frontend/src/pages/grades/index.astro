---
import API_BASE_URL from '@/config/api';
import DashboardLayout from '@/layouts/DashboardLayout.astro';
---
<DashboardLayout title="Mis calificaciones — Academix" currentPath="/grades">
  <div id="page-loading" class="p-6 space-y-4">
    <div class="grid grid-cols-4 gap-4">
      <div class="h-28 bg-card rounded-xl border border-border animate-pulse"></div>
      <div class="h-28 bg-card rounded-xl border border-border animate-pulse"></div>
      <div class="h-28 bg-card rounded-xl border border-border animate-pulse"></div>
      <div class="h-28 bg-card rounded-xl border border-border animate-pulse"></div>
    </div>
    <div class="h-64 bg-card rounded-xl border border-border animate-pulse"></div>
  </div>

  <div id="page-content" class="hidden">
    <div class="flex items-center justify-between border-b border-border px-6 py-4">
      <div>
        <h1 class="text-xl font-semibold text-foreground">Mis calificaciones</h1>
        <p class="text-sm text-muted-foreground">Sigue tu rendimiento académico</p>
      </div>
    </div>

    <div class="p-6 space-y-6">
      <!-- KPI row -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4" id="kpi-row"></div>

      <!-- Pestañas de asignaturas -->
      <div class="bg-card text-card-foreground rounded-xl border border-border p-5">
        <h2 class="text-lg font-semibold text-foreground mb-4">Evaluaciones por asignatura</h2>
        <div id="subject-tabs" class="flex gap-1 overflow-x-auto pb-2 mb-4 border-b border-border"></div>
        <div id="subject-panels"></div>
        <div id="grades-empty" class="hidden py-10 text-center text-sm text-muted-foreground">No hay datos de calificaciones disponibles</div>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  const STORAGE_KEY = "user-storage";
  const TOKEN_KEY = "access_token";
  const API_URL = API_BASE_URL;
  const RECENT_SUBJECTS_KEY = "academix:recent-subject-visits";

  function getUser() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY))?.state?.user ?? null; }
    catch { return null; }
  }

  const token = localStorage.getItem(TOKEN_KEY);
  if (!token) window.location.replace('/login');
  const user = getUser();
  if (!user) window.location.replace('/login');
  const role = user?.role ?? '';

  if (role !== 's') window.location.replace('/');

  async function apiFetch(path, options = {}) {
    const res = await fetch(`${API_URL}${path}`, {
      headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
      ...options,
    });
    if (res.status === 401) window.location.replace('/login');
    return res.json();
  }

  function showContent() {
    document.getElementById('page-loading')?.classList.add('hidden');
    document.getElementById('page-content')?.classList.remove('hidden');
  }

  function escHtml(str) {
    const d = document.createElement('div');
    d.textContent = String(str ?? '');
    return d.innerHTML;
  }

  function getClassId(item) {
    return String(item?.class_id ?? item?.class?.id ?? item?.cls?.id ?? item?.id ?? "");
  }

  function getRecentSubjectIds() {
    try {
      const parsed = JSON.parse(localStorage.getItem(RECENT_SUBJECTS_KEY) ?? "[]");
      if (!Array.isArray(parsed)) return [];
      return parsed.map(entry => String(entry?.classId ?? entry?.id ?? entry ?? "")).filter(Boolean);
    } catch {
      return [];
    }
  }

  function rememberSubjectVisit(classId) {
    if (!classId) return;
    const next = [
      { classId, visitedAt: new Date().toISOString() },
      ...getRecentSubjectIds()
        .filter(id => id !== classId)
        .map(id => ({ classId: id, visitedAt: null })),
    ].slice(0, 20);
    try { localStorage.setItem(RECENT_SUBJECTS_KEY, JSON.stringify(next)); } catch {}
  }

  function formatDate(str) {
    if (!str) return '-';
    return new Date(str).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  }

  function statusBadge(status) {
    const cfg = {
      graded: 'bg-green-500/15 text-green-400',
      pending: 'bg-yellow-500/15 text-yellow-400',
      late: 'bg-red-500/15 text-red-400',
    };
    const s = (status || 'pending').toLowerCase();
    return `<span class="inline-flex items-center rounded-full ${cfg[s] || cfg.pending} px-2 py-0.5 text-xs font-medium capitalize">${escHtml(s)}</span>`;
  }

  function typeBadge(type) {
    const colors = {
      exam: 'bg-purple-500/15 text-purple-400',
      quiz: 'bg-blue-500/15 text-blue-400',
      assignment: 'bg-orange-500/15 text-orange-400',
      project: 'bg-teal-500/15 text-teal-400',
      participation: 'bg-pink-500/15 text-pink-400',
    };
    const t = (type || 'other').toLowerCase();
    const c = colors[t] || 'bg-muted text-muted-foreground';
    return `<span class="inline-flex items-center rounded-full ${c} px-2 py-0.5 text-xs font-medium capitalize">${escHtml(t)}</span>`;
  }

  function buildMiniChart(scores) {
    if (scores.length < 2) return '';
    const max = Math.max(...scores, 100);
    const W = 300, H = 60;
    const pts = scores.map((s, i) => {
      const x = (i / (scores.length - 1)) * W;
      const y = H - (s / max) * H;
      return `${x},${y}`;
    });
    return `<svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" class="mt-3">
      <polyline points="${pts.join(' ')}" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linejoin="round"/>
      ${scores.map((s, i) => {
        const x = (i / (scores.length - 1)) * W;
        const y = H - (s / max) * H;
        return `<circle cx="${x}" cy="${y}" r="3" fill="var(--color-primary)"/>`;
      }).join('')}
    </svg>`;
  }

  (async () => {
    try {
      const data = await apiFetch('/grades/my-grades/');
      const gradesData = Array.isArray(data) ? data : (data.results || data.grades || []);

       // Calcula KPI
      const allScores = gradesData.flatMap(sub => (sub.evaluations || []).filter(e => e.score != null).map(e => parseFloat(e.score)));
      const overall = allScores.length ? (allScores.reduce((a, b) => a + b, 0) / allScores.length).toFixed(1) : '-';
      const highest = allScores.length ? Math.max(...allScores).toFixed(1) : '-';
      const lowest = allScores.length ? Math.min(...allScores).toFixed(1) : '-';
      const pending = gradesData.flatMap(sub => (sub.evaluations || [])).filter(e => e.score == null).length;

      const kpiRow = document.getElementById('kpi-row');
      if (kpiRow) {
        kpiRow.innerHTML = [
          { label: 'Promedio general', value: overall, color: 'text-primary', icon: '<path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/>' },
          { label: 'Calificación más alta', value: highest + (highest !== '-' ? '%' : ''), color: 'text-green-400', icon: '<polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>' },
          { label: 'Calificación más baja', value: lowest + (lowest !== '-' ? '%' : ''), color: 'text-red-400', icon: '<polyline points="23 18 13.5 8.5 8.5 13.5 1 6"/><polyline points="17 18 23 18 23 12"/>' },
          { label: 'Evaluaciones pendientes', value: String(pending), color: 'text-yellow-400', icon: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>' },
        ].map(k => `
          <div class="kpi-card bg-card text-card-foreground rounded-xl border border-border p-5">
            <div class="flex items-center justify-between mb-3">
              <p class="text-sm text-muted-foreground">${k.label}</p>
              <div class="flex size-8 items-center justify-center rounded-full bg-muted">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${k.color}">${k.icon}</svg>
              </div>
            </div>
            <p class="text-2xl font-bold ${k.color}">${k.value}</p>
          </div>
        `).join('');
      }

      if (gradesData.length === 0) {
        document.getElementById('grades-empty')?.classList.remove('hidden');
        showContent();
        return;
      }

      // Construye pestañas
      const tabsEl = document.getElementById('subject-tabs');
      const panelsEl = document.getElementById('subject-panels');
      const requestedClassId = new URLSearchParams(window.location.search).get('class');
      const requestedIdx = requestedClassId
        ? gradesData.findIndex(sub => getClassId(sub) === requestedClassId)
        : -1;
      const selectedIdx = requestedIdx >= 0 ? requestedIdx : 0;

      gradesData.forEach((sub, idx) => {
        const classId = getClassId(sub);
        const subjectName = sub.subject_name || sub.class_name || sub.name || `Asignatura ${idx + 1}`;
        const tabId = `tab-${idx}`;
        const panelId = `panel-${idx}`;

        const tab = document.createElement('button');
        tab.id = tabId;
        tab.dataset.panel = panelId;
        tab.dataset.subjectClassId = classId;
        tab.className = `subject-tab px-4 py-2 text-sm font-medium rounded-lg whitespace-nowrap transition-colors ${idx === selectedIdx ? 'bg-primary text-primary-foreground' : 'text-muted-foreground hover:text-foreground hover:bg-muted'}`;
        tab.textContent = subjectName;
        tab.addEventListener('click', () => {
          rememberSubjectVisit(tab.dataset.subjectClassId || '');
          document.querySelectorAll('.subject-tab').forEach(t => {
            t.className = 'subject-tab px-4 py-2 text-sm font-medium rounded-lg whitespace-nowrap transition-colors text-muted-foreground hover:text-foreground hover:bg-muted';
          });
          tab.className = 'subject-tab px-4 py-2 text-sm font-medium rounded-lg whitespace-nowrap transition-colors bg-primary text-primary-foreground';
          document.querySelectorAll('.subject-panel').forEach(p => p.classList.add('hidden'));
          document.getElementById(panelId)?.classList.remove('hidden');
        });
        tabsEl?.appendChild(tab);

        const evals = sub.evaluations || [];
        const gradedScores = evals.filter(e => e.score != null).map(e => parseFloat(e.score));

        const panel = document.createElement('div');
        panel.id = panelId;
        panel.className = `subject-panel ${idx !== selectedIdx ? 'hidden' : ''}`;
        panel.innerHTML = `
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="border-b border-border">
                  <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Evaluación</th>
                  <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Tipo</th>
                  <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Fecha límite</th>
                  <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Score</th>
                  <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Max</th>
                  <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">%</th>
                  <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Estado</th>
                </tr>
              </thead>
              <tbody>
                ${evals.map(e => {
                  const pct = e.score != null && e.max_score ? ((parseFloat(e.score) / parseFloat(e.max_score)) * 100).toFixed(1) : '-';
                  const status = e.score != null ? 'graded' : (e.due_date && new Date(e.due_date) < new Date() ? 'late' : 'pending');
                  return `<tr class="border-b border-border hover:bg-muted/40 transition-colors">
                    <td class="py-3 pr-4 text-sm font-medium text-foreground">${escHtml(e.name || e.evaluation_name || '-')}</td>
                    <td class="py-3 pr-4">${typeBadge(e.evaluation_type || e.type)}</td>
                    <td class="py-3 pr-4 text-sm text-muted-foreground">${formatDate(e.due_date)}</td>
                    <td class="py-3 pr-4 text-sm font-medium text-foreground">${e.score ?? '-'}</td>
                    <td class="py-3 pr-4 text-sm text-muted-foreground">${e.max_score ?? '-'}</td>
                    <td class="py-3 pr-4 text-sm text-muted-foreground">${pct}${pct !== '-' ? '%' : ''}</td>
                    <td class="py-3">${statusBadge(status)}</td>
                  </tr>`;
                }).join('')}
                ${evals.length === 0 ? `<tr><td colspan="7" class="py-6 text-center text-sm text-muted-foreground">Aún no hay evaluaciones</td></tr>` : ''}
              </tbody>
            </table>
          </div>
          ${gradedScores.length >= 2 ? `
            <div class="mt-4 pt-4 border-t border-border">
              <p class="text-xs font-medium text-muted-foreground uppercase tracking-wide mb-2">Tendencia de calificaciones</p>
              ${buildMiniChart(gradedScores)}
            </div>
          ` : ''}
        `;
        panelsEl?.appendChild(panel);
      });
      rememberSubjectVisit(getClassId(gradesData[selectedIdx]));

    } catch {
      document.getElementById('grades-empty')?.classList.remove('hidden');
    }
    showContent();
  })();
</script>
