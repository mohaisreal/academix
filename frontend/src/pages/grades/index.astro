---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
---
<DashboardLayout title="Mis calificaciones — Academix" currentPath="/grades">
  <div id="page-loading" class="space-y-4 p-4 sm:p-6">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <div class="h-28 bg-card rounded-xl border border-border animate-pulse"></div>
      <div class="h-28 bg-card rounded-xl border border-border animate-pulse"></div>
      <div class="h-28 bg-card rounded-xl border border-border animate-pulse"></div>
      <div class="h-28 bg-card rounded-xl border border-border animate-pulse"></div>
    </div>
    <div class="h-64 bg-card rounded-xl border border-border animate-pulse"></div>
  </div>

  <div id="page-content" class="hidden">
    <div class="flex flex-col gap-3 border-b border-border px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <div>
        <h1 class="text-xl font-semibold text-foreground">Mis calificaciones</h1>
        <p class="text-sm text-muted-foreground">Sigue tu rendimiento académico</p>
      </div>
      <span id="period-badge" data-active-period-label="true" class="inline-flex items-center rounded-full bg-primary/10 px-3 py-1 text-sm font-medium text-primary"></span>
    </div>

    <div class="space-y-6 p-4 sm:p-6">
      <!-- KPI row -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4" id="kpi-row"></div>

      <!-- Pestañas de asignaturas -->
      <div class="bg-card text-card-foreground rounded-xl border border-border p-4 sm:p-5">
        <h2 class="text-lg font-semibold text-foreground mb-4">Evaluaciones por asignatura</h2>
        <select id="subject-selector" class="mb-4 w-full rounded-lg border border-border bg-input px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary md:hidden"></select>
        <div id="subject-tabs" class="hidden gap-1 overflow-x-auto pb-2 mb-4 border-b border-border md:flex"></div>
        <div id="subject-panels"></div>
        <div id="grades-empty" class="hidden py-10 text-center text-sm text-muted-foreground">No hay datos de calificaciones disponibles</div>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  import API_BASE_URL from '@/config/api';
  import { fetchActivePeriodLabel } from '@/utils/period-display';
  const STORAGE_KEY = "user-storage";
  const TOKEN_KEY = "access_token";
  const API_URL = API_BASE_URL;
  const RECENT_SUBJECTS_KEY = "academix:recent-subject-visits";

  function getUser() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY))?.state?.user ?? null; }
    catch { return null; }
  }

  const token = localStorage.getItem(TOKEN_KEY);
  if (!token) window.location.replace('/login');
  const user = getUser();
  if (!user) window.location.replace('/login');
  const role = user?.role ?? '';

  if (role !== 's') window.location.replace('/');

  async function apiFetch(path, options = {}) {
    const res = await fetch(`${API_URL}${path}`, {
      headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
      ...options,
    });
    if (res.status === 401) window.location.replace('/login');
    return res.json();
  }

  function showContent() {
    document.getElementById('page-loading')?.classList.add('hidden');
    document.getElementById('page-content')?.classList.remove('hidden');
  }

  function escHtml(str) {
    const d = document.createElement('div');
    d.textContent = String(str ?? '');
    return d.innerHTML;
  }

  function getClassId(item) {
    return String(item?.class_id ?? item?.class?.id ?? item?.cls?.id ?? item?.id ?? "");
  }

  function getRecentSubjectIds() {
    try {
      const parsed = JSON.parse(localStorage.getItem(RECENT_SUBJECTS_KEY) ?? "[]");
      if (!Array.isArray(parsed)) return [];
      return parsed.map(entry => String(entry?.classId ?? entry?.id ?? entry ?? "")).filter(Boolean);
    } catch {
      return [];
    }
  }

  function rememberSubjectVisit(classId) {
    if (!classId) return;
    const next = [
      { classId, visitedAt: new Date().toISOString() },
      ...getRecentSubjectIds()
        .filter(id => id !== classId)
        .map(id => ({ classId: id, visitedAt: null })),
    ].slice(0, 20);
    try { localStorage.setItem(RECENT_SUBJECTS_KEY, JSON.stringify(next)); } catch {}
  }

  function formatDate(str) {
    if (!str) return '-';
    return new Date(str).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  }

  function formatDateTime(str) {
    if (!str) return '-';
    return new Date(str).toLocaleString('es-ES', {
      day: '2-digit', month: 'short', year: 'numeric',
      hour: '2-digit', minute: '2-digit',
      timeZone: 'Europe/Madrid',
    });
  }

  function submissionStatusLabel(e) {
    if (e?.submission_status === 'submitted' || e?.submitted_at || e?.submission_file_url) return 'Entregado';
    if (e?.submission_status === 'pending' && e?.upload_allowed) return 'Pendiente';
    if (e?.submission_status === 'late') return 'Fuera de plazo';
    if (e?.allows_file_submission) return e?.upload_allowed ? 'Pendiente' : 'Fuera de plazo';
    return 'Sin entrega de archivo';
  }

  function fileNameFromPath(path) {
    if (!path) return '';
    return String(path).split('/').pop() || String(path);
  }

  async function submitEvaluationFile(evalId, fileInput, statusEl) {
    const file = fileInput?.files?.[0];
    if (!file) return;
    const formData = new FormData();
    formData.append('file', file);
    const res = await fetch(`${API_URL}/grades/evaluations/${evalId}/submissions/`, {
      method: 'POST',
      headers: { 'Authorization': `Bearer ${token}` },
      body: formData,
    });
    if (res.status === 401) window.location.replace('/login');
    if (!res.ok) throw new Error('upload_failed');
    const data = await res.json();
    if (statusEl) {
      statusEl.textContent = data?.submission_label || 'Entregado';
    }
    return data;
  }

  function statusBadge(status) {
    const cfg = {
      submitted: 'bg-green-500/15 text-green-400',
      pending: 'bg-yellow-500/15 text-yellow-400',
      late: 'bg-red-500/15 text-red-400',
      not_applicable: 'bg-muted text-muted-foreground',
    };
    const s = (status || 'pending').toLowerCase();
    const labels = { submitted: 'Entregado', pending: 'Pendiente', late: 'Fuera de plazo', not_applicable: 'Sin entrega de archivo' };
    return `<span class="inline-flex items-center rounded-full ${cfg[s] || cfg.pending} px-2 py-0.5 text-xs font-medium">${escHtml(labels[s] || labels.pending)}</span>`;
  }

  function typeBadge(type) {
    const colors = {
      exam: 'bg-purple-500/15 text-purple-400',
      assignment: 'bg-orange-500/15 text-orange-400',
      project: 'bg-teal-500/15 text-teal-400',
      participation: 'bg-pink-500/15 text-pink-400',
    };
    const t = (type || 'other').toLowerCase();
    const c = colors[t] || 'bg-muted text-muted-foreground';
    return `<span class="inline-flex items-center rounded-full ${c} px-2 py-0.5 text-xs font-medium capitalize">${escHtml(t)}</span>`;
  }

  function buildMiniChart(scores) {
    if (scores.length < 2) return '';
    const max = Math.max(...scores, 100);
    const W = 300, H = 60;
    const pts = scores.map((s, i) => {
      const x = (i / (scores.length - 1)) * W;
      const y = H - (s / max) * H;
      return `${x},${y}`;
    });
    return `<svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" class="mt-3">
      <polyline points="${pts.join(' ')}" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linejoin="round"/>
      ${scores.map((s, i) => {
        const x = (i / (scores.length - 1)) * W;
        const y = H - (s / max) * H;
        return `<circle cx="${x}" cy="${y}" r="3" fill="var(--color-primary)"/>`;
      }).join('')}
    </svg>`;
  }

  async function setActivePeriodLabel() {
    const badge = document.getElementById('period-badge');
    if (!badge) return;
    badge.textContent = await fetchActivePeriodLabel(apiFetch);
  }

  (async () => {
    try {
      await setActivePeriodLabel();
      const data = await apiFetch('/grades/my-grades/');
      const gradesData = Array.isArray(data) ? data : (data.results || data.grades || []);

      const visibleFinals = gradesData.filter(sub => sub.final_grade_visible !== false && sub.show_final_grade_to_students !== false && sub.final_grade != null);
      const passedCount = gradesData.filter(sub => sub.passed === true).length;
      const pending = gradesData.flatMap(sub => (sub.evaluations || [])).filter(e => e.score == null).length;

      const kpiRow = document.getElementById('kpi-row');
      if (kpiRow) {
        kpiRow.innerHTML = [
           { label: 'Asignaturas aprobadas', value: String(passedCount), color: 'text-green-400', icon: '<polyline points="20 6 9 17 4 12"/>' },
           { label: 'Notas finales visibles', value: String(visibleFinals.length), color: 'text-primary', icon: '<path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/>' },
           { label: 'Evaluaciones pendientes', value: String(pending), color: 'text-yellow-400', icon: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>' },
        ].map(k => `
          <div class="kpi-card bg-card text-card-foreground rounded-xl border border-border p-5">
            <div class="flex items-center justify-between mb-3">
              <p class="text-sm text-muted-foreground">${k.label}</p>
              <div class="flex size-8 items-center justify-center rounded-full bg-muted">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${k.color}">${k.icon}</svg>
              </div>
            </div>
            <p class="text-2xl font-bold ${k.color}">${k.value}</p>
          </div>
        `).join('');
      }

      if (gradesData.length === 0) {
        document.getElementById('grades-empty')?.classList.remove('hidden');
        showContent();
        return;
      }

      // Construye pestañas
      const tabsEl = document.getElementById('subject-tabs');
      const panelsEl = document.getElementById('subject-panels');
      const selectorEl = document.getElementById('subject-selector') as HTMLSelectElement | null;
      const classQueryParam = new URLSearchParams(window.location.search).get('class');
      const requestedIdx = classQueryParam
        ? gradesData.findIndex(sub => getClassId(sub) === classQueryParam)
        : -1;
      const selectedIdx = requestedIdx >= 0 ? requestedIdx : 0;
      const selectedClassId = getClassId(gradesData[selectedIdx]);

      if (selectorEl) {
        selectorEl.innerHTML = gradesData.map((sub, idx) => {
          const classId = getClassId(sub);
          const subjectName = sub.subject_name || sub.class_name || sub.name || `Asignatura ${idx + 1}`;
          return `<option value="${escHtml(classId)}" ${idx === selectedIdx ? 'selected' : ''}>${escHtml(subjectName)}</option>`;
        }).join('');
      }

      function activateSubject(panelId, classId) {
        rememberSubjectVisit(classId || '');
        document.querySelectorAll('.subject-tab').forEach(t => {
          t.className = 'subject-tab px-4 py-2 text-sm font-medium rounded-lg whitespace-nowrap transition-colors text-muted-foreground hover:text-foreground hover:bg-muted';
        });
        document.querySelectorAll('.subject-panel').forEach(p => p.classList.add('hidden'));
        document.getElementById(panelId)?.classList.remove('hidden');
        const tab = document.querySelector(`.subject-tab[data-panel="${panelId}"]`) as HTMLElement | null;
        if (tab) tab.className = 'subject-tab px-4 py-2 text-sm font-medium rounded-lg whitespace-nowrap transition-colors bg-primary text-primary-foreground';
        if (selectorEl && selectorEl.value !== classId) selectorEl.value = classId;
      }

      gradesData.forEach((sub, idx) => {
        const classId = getClassId(sub);
        const subjectName = sub.subject_name || sub.class_name || sub.name || `Asignatura ${idx + 1}`;
        const tabId = `tab-${idx}`;
        const panelId = `panel-${idx}`;

        const tab = document.createElement('button');
        tab.id = tabId;
        tab.dataset.panel = panelId;
        tab.dataset.subjectClassId = classId;
        tab.className = `subject-tab px-4 py-2 text-sm font-medium rounded-lg whitespace-nowrap transition-colors ${idx === selectedIdx ? 'bg-primary text-primary-foreground' : 'text-muted-foreground hover:text-foreground hover:bg-muted'}`;
        tab.textContent = subjectName;
        tab.addEventListener('click', () => {
          activateSubject(panelId, tab.dataset.subjectClassId || '');
        });
        tabsEl?.appendChild(tab);

        const evals = sub.evaluations || [];
        const gradedScores = evals.filter(e => e.score != null).map(e => parseFloat(e.score));
        const finalVisible = sub.final_grade_visible !== false && sub.show_final_grade_to_students !== false;
        const finalGrade = sub.final_grade ?? sub.average ?? sub.grade ?? '-';
        const passed = sub.passed ?? false;

        const panel = document.createElement('div');
        panel.id = panelId;
        panel.className = `subject-panel ${idx !== selectedIdx ? 'hidden' : ''}`;
        panel.innerHTML = `
            <div class="space-y-4 md:hidden">
              <div class="rounded-xl border border-border bg-muted/20 p-4 flex items-center justify-between gap-3">
                <div>
                  <p class="text-xs uppercase tracking-wide text-muted-foreground">Nota final</p>
                  <p class="mt-1 text-sm font-semibold text-foreground">${finalVisible ? escHtml(String(finalGrade)) : 'Oculta por el profesor'}</p>
                </div>
                <span class="inline-flex items-center rounded-full ${passed ? 'bg-green-500/15 text-green-400' : 'bg-red-500/15 text-red-400'} px-2 py-0.5 text-xs font-medium">${passed ? 'Aprobada' : 'Suspensa'}</span>
              </div>
              ${evals.map(e => {
                const pct = e.score != null && e.max_score ? ((parseFloat(e.score) / parseFloat(e.max_score)) * 100).toFixed(1) : '-';
                const status = e.submission_status || (e.score != null ? 'submitted' : (e.due_date && new Date(e.due_date) < new Date() ? 'late' : 'pending'));
                const canUpload = !!e.upload_allowed && !e.submission_file_url;
                const uploadedUrl = e.submission_file_url || '';
                const uploadedName = e.submission_file_name || fileNameFromPath(uploadedUrl);
                const thresholdStatus = e.min_score != null ? (e.evaluation_passed ? 'Aprobada' : 'Suspensa') : null;
                return `<article class="rounded-xl border border-border bg-card p-4 shadow-sm" data-eval-row="${e.id}">
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <h3 class="text-sm font-semibold text-foreground">${escHtml(e.name || e.evaluation_name || '-')}</h3>
                    <p class="mt-1 text-xs text-muted-foreground">${formatDate(e.due_date)}</p>
                  </div>
                  ${statusBadge(status)}
                </div>
                <div class="mt-4 grid grid-cols-2 gap-3 text-sm">
                  <div>
                    <p class="text-xs uppercase tracking-wide text-muted-foreground">Tipo</p>
                    <div class="mt-1">${typeBadge(e.evaluation_type || e.type)}</div>
                  </div>
                  <div>
                    <p class="text-xs uppercase tracking-wide text-muted-foreground">Score</p>
                    <p class="mt-1 font-medium text-foreground">${e.score ?? '-'}</p>
                  </div>
                  <div>
                    <p class="text-xs uppercase tracking-wide text-muted-foreground">Max</p>
                    <p class="mt-1 text-muted-foreground">${e.max_score ?? '-'}</p>
                  </div>
                  <div>
                    <p class="text-xs uppercase tracking-wide text-muted-foreground">%</p>
                    <p class="mt-1 text-muted-foreground">${pct}${pct !== '-' ? '%' : ''}</p>
                  </div>
                  ${e.min_score != null ? `<div class="col-span-2"><p class="text-xs uppercase tracking-wide text-muted-foreground">Nota mínima</p><p class="mt-1 text-sm text-foreground">${escHtml(String(e.min_score))}</p><p class="mt-1 text-xs ${e.evaluation_passed ? 'text-green-400' : 'text-red-400'}">${thresholdStatus}</p></div>` : ''}
                  <div class="col-span-2">
                    <p class="text-xs uppercase tracking-wide text-muted-foreground">Entrega</p>
                    ${uploadedUrl ? `<a href="${escHtml(uploadedUrl)}" target="_blank" rel="noreferrer" class="mt-2 inline-flex items-center gap-2 text-xs text-primary hover:underline">${escHtml(uploadedName || 'Archivo entregado')}</a><p class="mt-1 text-xs text-muted-foreground">${formatDateTime(e.submitted_at)}${e.submission_file_name ? ` · ${escHtml(e.submission_file_name)}` : ''}</p>` : ''}
                     ${canUpload ? `<div class="mt-3 flex flex-col gap-2"><input type="file" accept="*/*" class="eval-upload-input block w-full text-xs text-muted-foreground file:mr-3 file:rounded-md file:border-0 file:bg-primary/10 file:px-3 file:py-1.5 file:text-xs file:font-medium file:text-primary hover:file:bg-primary/20" data-eval-id="${e.id}" /><button type="button" class="eval-upload-btn inline-flex items-center justify-center rounded-lg bg-primary/10 px-3 py-1.5 text-xs font-medium text-primary hover:bg-primary/20" data-eval-id="${e.id}">Subir archivo</button></div>` : ''}
                  </div>
                </div>
              </article>`;
            }).join('')}
            ${evals.length === 0 ? `<div class="rounded-xl border border-border bg-card p-6 text-center text-sm text-muted-foreground">Aún no hay evaluaciones</div>` : ''}
          </div>
          <div class="hidden overflow-x-auto md:block">
            <table class="w-full">
              <thead>
                <tr class="border-b border-border">
                  <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Evaluación</th>
                  <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Tipo</th>
                  <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Fecha límite</th>
                  <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Score</th>
                  <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Max</th>
                  <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">%</th>
                  <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Estado</th>
                </tr>
              </thead>
              <tbody>
                ${evals.map(e => {
                  const pct = e.score != null && e.max_score ? ((parseFloat(e.score) / parseFloat(e.max_score)) * 100).toFixed(1) : '-';
                  const status = e.submission_status || (e.score != null ? 'submitted' : (e.due_date && new Date(e.due_date) < new Date() ? 'late' : 'pending'));
                  const canUpload = !!e.upload_allowed && !e.submission_file_url;
                  const thresholdStatus = e.min_score != null ? (e.evaluation_passed ? 'Aprobada' : 'Suspensa') : null;
                    return `<tr class="border-b border-border hover:bg-muted/40 transition-colors" data-eval-row="${e.id}">
                    <td class="py-3 pr-4 text-sm font-medium text-foreground">${escHtml(e.name || e.evaluation_name || '-')}</td>
                    <td class="py-3 pr-4">${typeBadge(e.evaluation_type || e.type)}</td>
                    <td class="py-3 pr-4 text-sm text-muted-foreground">${formatDateTime(e.due_date)}</td>
                    <td class="py-3 pr-4 text-sm font-medium text-foreground">${e.score ?? '-'}</td>
                    <td class="py-3 pr-4 text-sm text-muted-foreground">${e.max_score ?? '-'}</td>
                    <td class="py-3 pr-4 text-sm text-muted-foreground">${pct}${pct !== '-' ? '%' : ''}</td>
                    <td class="py-3">
                      <div class="space-y-1">
                        ${statusBadge(status)}
                        ${e.min_score != null ? `<p class="text-xs ${e.evaluation_passed ? 'text-green-400' : 'text-red-400'}">Nota mínima: ${escHtml(String(e.min_score))} · ${thresholdStatus}</p>` : ''}
                        ${e.submission_file_url ? `<a href="${escHtml(e.submission_file_url)}" target="_blank" rel="noreferrer" class="text-xs text-primary hover:underline">${escHtml(e.submission_file_name || 'Archivo entregado')}</a>` : ''}
                        ${canUpload ? `<div class="pt-2 flex flex-col gap-2"><input type="file" accept="*/*" class="eval-upload-input block w-full text-xs text-muted-foreground file:mr-3 file:rounded-md file:border-0 file:bg-primary/10 file:px-3 file:py-1.5 file:text-xs file:font-medium file:text-primary hover:file:bg-primary/20" data-eval-id="${e.id}" /><button type="button" class="eval-upload-btn inline-flex items-center justify-center rounded-lg bg-primary/10 px-3 py-1.5 text-xs font-medium text-primary hover:bg-primary/20" data-eval-id="${e.id}">Subir archivo</button></div>` : ''}
                      </div>
                    </td>
                  </tr>`;
                }).join('')}
                ${evals.length === 0 ? `<tr><td colspan="7" class="py-6 text-center text-sm text-muted-foreground">Aún no hay evaluaciones</td></tr>` : ''}
              </tbody>
            </table>
          </div>
          ${gradedScores.length >= 2 ? `
            <div class="mt-4 pt-4 border-t border-border">
              <p class="text-xs font-medium text-muted-foreground uppercase tracking-wide mb-2">Tendencia de calificaciones</p>
              ${buildMiniChart(gradedScores)}
            </div>
          ` : ''}
        `;
        panelsEl?.appendChild(panel);
      });
      selectorEl?.addEventListener('change', () => {
        const nextClassId = selectorEl.value;
        const nextIdx = gradesData.findIndex(sub => getClassId(sub) === nextClassId);
        if (nextIdx >= 0) activateSubject(`panel-${nextIdx}`, nextClassId);
      });

      activateSubject(`panel-${selectedIdx}`, selectedClassId);

      document.querySelectorAll('.eval-upload-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const evalId = (btn as HTMLElement).dataset.evalId;
          const row = (btn as HTMLElement).closest('[data-eval-row]') as HTMLElement | null;
          const input = row?.querySelector(`.eval-upload-input[data-eval-id="${evalId}"]`) as HTMLInputElement | null;
          const statusEl = row?.querySelector('[data-testid="grade-submission-status"]') as HTMLElement | null;
          if (!evalId || !input) return;
          btn.setAttribute('disabled', 'true');
          try {
            await submitEvaluationFile(evalId, input, statusEl);
            statusEl && (statusEl.textContent = 'Entregado');
            input.disabled = true;
            btn.textContent = 'Entregado';
          } catch {
            btn.removeAttribute('disabled');
          }
        });
      });

    } catch {
      document.getElementById('grades-empty')?.classList.remove('hidden');
    }
    showContent();
  })();
</script>

