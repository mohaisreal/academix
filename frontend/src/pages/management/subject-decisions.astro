---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
---

<DashboardLayout title="Decisiones docentes — Academix" currentPath="/management/subject-decisions">
  <div class="p-6 space-y-4">
    <h1 class="text-xl font-semibold">Decisiones docentes</h1>
    <p class="text-sm text-muted-foreground">Revisa eligibilidad, edita decisiones y marca estados obsoletos.</p>
    <section id="subject-decisions-list" class="rounded-xl border border-border bg-card p-4">Sin decisiones cargadas.</section>
    <section id="subject-eligibility-editor" class="rounded-xl border border-border bg-card p-4">Editor de elegibilidad.</section>
  </div>
</DashboardLayout>
