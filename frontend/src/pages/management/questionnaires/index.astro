    }

    // ── Escuchadores de eventos ───────────────────────────────────────────────────────
    el("btn-create").addEventListener("click", openCreateModal);
    el("btn-import").addEventListener("click", openImportModal);
    el("btn-from-template").addEventListener("click", createFromTemplate);

    el("modal-close").addEventListener("click", closeModal);
    el("modal-cancel").addEventListener("click", closeModal);
    el("modal-save").addEventListener("click", saveQuestionnaire);

    el("modal-backdrop").addEventListener("click", (e) => {
        if (e.target === el("modal-backdrop")) closeModal();
    });

    el("import-modal-close").addEventListener("click", closeImportModal);
    el("import-modal-cancel").addEventListener("click", closeImportModal);
    el("import-modal-confirm").addEventListener("click", runImport);
    el("import-modal-backdrop").addEventListener("click", (e) => {
        if (e.target === el("import-modal-backdrop")) closeImportModal();
    });

    el("toggle-active").addEventListener("click", () => setActiveToggle(!isActiveToggle));

    el("search-input").addEventListener("input", () => { currentPage = 1; loadData(); });
    el("filter-type").addEventListener("change", () => { currentPage = 1; loadData(); });
    el("btn-prev-page").addEventListener("click", () => { if (pagination.previous) { currentPage -= 1; loadData(); } });
    el("btn-next-page").addEventListener("click", () => { if (pagination.next) { currentPage += 1; loadData(); } });

    // ── Inicialización ──────────────────────────────────────────────────────────────────
    loadData();
</script>
    let currentPage = 1;
    let pagination = { count: 0, next: null as string | null, previous: null as string | null };
