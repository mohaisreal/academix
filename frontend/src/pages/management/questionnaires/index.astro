        try {
            const res = await fetch(`${API_URL}/questionnaire/import/`, {
                method: "POST",
                headers: authHeaders(),
                body: JSON.stringify(PREINSCRIPCION_TEMPLATE),
            });
            if (!res.ok) {
                const err = await res.json().catch(() => ({}));
                showToast("error", "Error", err.detail ?? `Server error ${res.status}.`);
                return;
            }
            const created = await res.json();
            allQuestionnaires.unshift(created);
            filterAndRender();
            showToast("success", "Template created", `"${created.title}" is ready to edit.`);
        } catch {
            showToast("error", "Error de red", "No se pudo crear a partir de la plantilla.");
