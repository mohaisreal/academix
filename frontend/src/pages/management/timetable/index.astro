  q('timeslot-batch-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const day = q('timeslot-batch-day-of-week'); const start = q('timeslot-batch-start-time'); const end = q('timeslot-batch-end-time'); const interval = q('timeslot-batch-interval-minutes'); const breaks = q('timeslot-batch-breaks'); const error = q('timeslot-batch-form-error');
    error?.classList.add('hidden');
    if (!(day instanceof HTMLSelectElement) || !(start instanceof HTMLInputElement) || !(end instanceof HTMLInputElement) || !(interval instanceof HTMLInputElement) || !(breaks instanceof HTMLTextAreaElement)) return;
    try {
      const period = q('run-period-create');
      if (!(period instanceof HTMLSelectElement)) throw new Error('No se encontró el selector de periodo.');
      const batch = buildTimeslotBatch({ period: period.value, dayOfWeek: day.value, startTime: start.value, endTime: end.value, intervalMinutes: interval.value, breakRanges: parseTimeslotBreakRanges(breaks.value) });
      if (batch.length === 0) throw new Error('No se crearían franjas con el rango indicado.');
      const key = (x) => `${x.day_of_week}|${String(x.start_time).slice(0, 5)}|${String(x.end_time).slice(0, 5)}`;
      const existing = new Set(timeslots.map(key));
      const unique = batch.filter((s) => !existing.has(key(s)));
      let created = 0;
      for (const payload of unique) { await apiFetch('/academic/time-slots/', { method: 'POST', body: JSON.stringify(payload) }); created += 1; }
      toast.success(created ? `Creadas ${created} franjas${batch.length - created ? ` · omitidas ${batch.length - created} duplicadas` : ''}` : `No se crearon nuevas · ${batch.length} duplicadas`);
      if (event.currentTarget instanceof HTMLFormElement) event.currentTarget.reset();
      await loadTimeslots(timeslotsPage);
    } catch (e) { if (error) error.textContent = classifyTimetableActionError(e, 'timeslot'); error?.classList.remove('hidden'); }
  });

  q('timeslots-prev-btn')?.addEventListener('click', async () => {
    if (timeslotsPage <= 1) return;
    try { await loadTimeslots(timeslotsPage - 1); }
    catch (e) { toast.error(err(e, 'No se pudieron cargar las franjas horarias')); }
  });
  q('timeslots-next-btn')?.addEventListener('click', async () => {
    if (timeslotsPage >= timeslotsPages) return;
    try { await loadTimeslots(timeslotsPage + 1); }
    catch (e) { toast.error(err(e, 'No se pudieron cargar las franjas horarias')); }
  });
  q('timeslots-select-all')?.addEventListener('change', (event) => {
    if (!(event.currentTarget instanceof HTMLInputElement)) return;
    const visibleIds = timeslots.map((slot) => Number(slot.id));
    if (event.currentTarget.checked) visibleIds.forEach((id) => selectedTimeslotIds.add(id));
    else visibleIds.forEach((id) => selectedTimeslotIds.delete(id));
    renderTimeslots();
  });
  q('delete-timeslots-btn')?.addEventListener('click', async () => { await deleteSelectedTimeslots(); });

  q('constraint-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const error = q('constraint-form-error');
    error?.classList.add('hidden');
    const kindEl = q('constraint-kind'); const scopeEl = q('constraint-scope'); const periodEl = q('constraint-period');
    const teacherEl = q('constraint-teacher'); const classroomEl = q('constraint-classroom'); const careerEl = q('constraint-career');
    const dayEl = q('constraint-day'); const startEl = q('constraint-start'); const endEl = q('constraint-end');
    if (!(kindEl instanceof HTMLSelectElement) || !(scopeEl instanceof HTMLSelectElement) || !(periodEl instanceof HTMLSelectElement) || !(teacherEl instanceof HTMLSelectElement) || !(classroomEl instanceof HTMLSelectElement) || !(careerEl instanceof HTMLSelectElement) || !(dayEl instanceof HTMLSelectElement) || !(startEl instanceof HTMLInputElement) || !(endEl instanceof HTMLInputElement)) return;
    try {
      const payload = buildConstraintPayload({
        kind: kindEl.value,
        scope: scopeEl.value,
        period: periodEl.value,
        teacher: teacherEl.value,
        classroom: classroomEl.value,
        career: careerEl.value,
        dayOfWeek: dayEl.value,
        startTime: `${startEl.value}:00`,
        endTime: `${endEl.value}:00`,
        isActive: true,
      });
      await apiFetch('/academic/scheduling-constraints/', { method: 'POST', body: JSON.stringify(payload) });
      await loadConstraints();
      renderConstraints();
    } catch (e) {
      const fields = mapConstraintFieldErrors((e as any)?.payload);
      if (error) error.textContent = Object.entries(fields).map(([k, v]) => `${k}: ${v}`).join(' · ') || err(e, 'No se pudo guardar la restricción');
      error?.classList.remove('hidden');
    }
  });

  q('constraint-kind')?.addEventListener('change', syncConstraintSelectors);
  q('constraint-scope')?.addEventListener('change', syncConstraintSelectors);
  q('retry-management-timetable-btn')?.addEventListener('click', async () => {
    try { hidePageError(); await loadCatalogs(); await loadRuns(); await Promise.all([loadAssignments(), loadViolations(), loadConstraints()]); renderConstraints(); showContent(); }
    catch (e) { showPageError(err(e, 'No se pudo cargar la gestión de horarios')); toast.error(err(e, 'No se pudo cargar la gestión de horarios')); }
  });

  (async () => {
    try { hidePageError(); await loadCatalogs(); await loadRuns(); await Promise.all([loadAssignments(), loadViolations(), loadConstraints()]); renderConstraints(); showContent(); }
    catch (e) { showPageError(err(e, 'No se pudo cargar la gestión de horarios')); toast.error(err(e, 'No se pudo cargar la gestión de horarios')); }
  })();
</script>
