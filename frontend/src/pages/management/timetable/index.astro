  async function loadAllPages(path) {
    const first = await apiFetch(path);
    if (Array.isArray(first)) return first;
    const rows = Array.isArray(first?.results) ? [...first.results] : [];
    let nextUrl = first?.next;
    while (nextUrl) {
      const normalizedNext = String(nextUrl);
      const relativeNext = normalizedNext.startsWith(API_URL) ? normalizedNext.slice(API_URL.length) : normalizedNext;
      const page = await apiFetch(relativeNext);
      const nextRows = Array.isArray(page?.results) ? page.results : unwrap(page);
      rows.push(...nextRows);
      nextUrl = page?.next;
    }
    return rows.length ? rows : unwrap(first);
  }

  async function loadCatalogs() {
    const [periodRows, teacherRows, classroomRows, careerRows] = await Promise.all([
      loadAllPages('/academic/periods/'),
      loadAllPages('/users/teachers/'),
      loadAllPages('/academic/classrooms/'),
      loadAllPages('/academic/careers/'),
    ]);
    periods = periodRows;
    teachers = teacherRows;
    classrooms = classroomRows;
    careers = careerRows;
    renderPeriodSelects();
    renderConstraintCatalogSelects();
    syncConstraintSelectors();
    await loadTimeslots(1);
  }
  async function loadRuns() {
    const params = new URLSearchParams(); const p = q('run-period-filter'); const s = q('run-status-filter');
    if (p instanceof HTMLSelectElement && p.value) params.set('period', p.value);
    if (s instanceof HTMLSelectElement && s.value) params.set('status', s.value);
    runs = unwrap(await apiFetch(`/academic/timetable-runs/${params.toString() ? `?${params.toString()}` : ''}`));
    syncSelectedRun(); renderRuns();
  }
  async function loadTimeslots(page = 1) {
    const safePage = Number.isInteger(page) && page > 0 ? page : 1;
    const payload = await apiFetch(`/academic/time-slots/?page=${safePage}`);
    const rows = unwrap(payload);
    timeslots = rows;
    timeslotsPage = safePage;
    timeslotsCount = Array.isArray(payload?.results) ? Number(payload?.count || rows.length || 0) : rows.length;
    timeslotsPages = Array.isArray(payload?.results)
      ? Math.max(1, Math.ceil(timeslotsCount / TIMESLOTS_PAGE_SIZE))
      : 1;
    renderTimeslots();
  }
  async function loadAssignments() { if (!selectedRunId) { assignments = []; return; } assignments = await loadScheduleAssignmentsByRun(selectedRunId); }
  async function loadViolations() {
    if (!selectedRunId) { violations = []; renderViolations(); return; }
