---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
---

<DashboardLayout title="Gestión de horarios — Academix" currentPath="/management/timetable">
  <div id="page-loading" class="p-6 space-y-4">
    <div class="h-12 bg-card rounded-xl border border-border animate-pulse"></div>
    <div class="h-56 bg-card rounded-xl border border-border animate-pulse"></div>
    <div class="h-80 bg-card rounded-xl border border-border animate-pulse"></div>
  </div>

  <div id="page-content" class="hidden p-6 space-y-6">
    <div class="flex flex-col gap-3 border-b border-border pb-4 lg:flex-row lg:items-center lg:justify-between">
      <div>
        <h1 class="text-xl font-semibold text-foreground">Gestión de horarios</h1>
        <p class="text-sm text-muted-foreground">Genera borradores, publica ejecuciones y revisa asignaciones/conflictos.</p>
      </div>
      <div class="flex flex-col items-start gap-2 sm:flex-row sm:items-center">
        <span id="selected-run-badge" class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-sm font-medium text-primary">Ninguna ejecución seleccionada</span>
        <button id="cleanup-generated-classes-btn" type="button" class="rounded-lg border border-red-500/30 px-4 py-2 text-sm font-medium text-red-300 transition hover:bg-red-500/10" title="Elimina las clases generadas automáticamente del periodo de la ejecución seleccionada">
          Eliminar clases generadas
        </button>
      </div>
    </div>

    <section class="bg-card border border-border rounded-xl p-5 space-y-4">
      <div class="flex flex-col gap-3 xl:flex-row xl:items-end xl:justify-between">
        <div>
          <h2 class="text-lg font-semibold">Ejecuciones</h2>
          <p class="text-sm text-muted-foreground">Crear, filtrar, generar, publicar o eliminar borradores.</p>
        </div>
        <div class="flex flex-col gap-2 sm:flex-row">
          <select id="run-period-filter" class="bg-input border border-border rounded-lg px-3 py-2 text-sm"><option value="">Todos los periodos</option></select>
          <select id="run-status-filter" class="bg-input border border-border rounded-lg px-3 py-2 text-sm">
            <option value="">Todos los estados</option><option value="draft">Borrador</option><option value="running">En ejecución</option><option value="completed">Completada</option><option value="partial">Parcial</option><option value="failed">Fallida</option><option value="published">Publicada</option>
          </select>
          <button id="reload-runs-btn" class="rounded-lg border border-border px-4 py-2 text-sm">Recargar</button>
        </div>
      </div>

      <div class="grid gap-6 xl:grid-cols-[1.8fr,1fr]">
        <div>
          <div class="overflow-x-auto hidden md:block"><table class="w-full"><thead><tr class="border-b border-border"><th class="text-left text-xs uppercase pb-3">Ejecución</th><th class="text-left text-xs uppercase pb-3">Estado</th><th class="text-left text-xs uppercase pb-3">Asignaciones</th><th class="text-left text-xs uppercase pb-3">Infracciones</th><th class="text-left text-xs uppercase pb-3">Acciones</th></tr></thead><tbody id="runs-table-body"></tbody></table></div>
          <div id="runs-mobile-list" class="space-y-3 md:hidden"></div>
          <div id="runs-empty" class="hidden rounded-lg border border-dashed border-border px-4 py-10 text-center text-sm text-muted-foreground">No se encontraron ejecuciones.</div>
        </div>
        <form id="run-form" class="rounded-xl border border-border bg-background p-4 space-y-3">
          <h3 class="text-sm font-semibold">Crear ejecución borrador</h3>
          <div><label class="text-xs text-muted-foreground">periodo *</label><select id="run-period-create" required class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm"><option value="">Selecciona un periodo</option></select></div>
          <div id="run-form-error" class="hidden rounded-lg border border-red-500/20 bg-red-500/10 px-3 py-2 text-xs text-red-300"></div>
          <button class="w-full rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground">Crear ejecución</button>
        </form>
      </div>
    </section>

    <section class="bg-card border border-border rounded-xl p-5 space-y-4">
      <h2 class="text-lg font-semibold">Franjas horarias</h2>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <label class="inline-flex items-center gap-2 text-sm text-muted-foreground"><input id="timeslots-select-all" type="checkbox" class="rounded border-border bg-input" /> Seleccionar todas</label>
        <button id="delete-timeslots-btn" type="button" disabled class="rounded-lg border border-red-500/30 px-4 py-2 text-sm font-medium text-red-300 transition hover:bg-red-500/10 disabled:opacity-50">Eliminar</button>
      </div>
      <div class="grid gap-6 xl:grid-cols-[1.5fr,1fr]">
        <div>
          <div class="overflow-x-auto"><table class="w-full"><thead><tr class="border-b border-border"><th class="text-left text-xs uppercase pb-3 w-10"><span class="sr-only">Seleccionar</span></th><th class="text-left text-xs uppercase pb-3">Día</th><th class="text-left text-xs uppercase pb-3">Inicio</th><th class="text-left text-xs uppercase pb-3">Fin</th></tr></thead><tbody id="timeslots-table-body"></tbody></table></div>
          <div id="timeslots-pagination" class="mt-3 hidden items-center justify-between gap-2 rounded-lg border border-border px-3 py-2 text-xs text-muted-foreground sm:text-sm">
            <button id="timeslots-prev-btn" class="rounded border border-border px-2 py-1 disabled:opacity-50" disabled>Anterior</button>
            <span id="timeslots-page-info">Página 1 de 1 · 0 franjas</span>
            <button id="timeslots-next-btn" class="rounded border border-border px-2 py-1 disabled:opacity-50" disabled>Siguiente</button>
          </div>
          <div id="timeslots-empty" class="hidden rounded-lg border border-dashed border-border px-4 py-10 text-center text-sm text-muted-foreground">No hay franjas horarias aún.</div>
        </div>
        <div class="space-y-4">
          <form id="timeslot-form" class="rounded-xl border border-border bg-background p-4 space-y-3">
            <h3 class="text-sm font-semibold">Crear franja</h3>
            <select id="timeslot-day-of-week" required class="w-full bg-input border border-border rounded-lg px-3 py-2 text-sm"><option value="">Día</option><option value="0">Lunes</option><option value="1">Martes</option><option value="2">Miércoles</option><option value="3">Jueves</option><option value="4">Viernes</option><option value="5">Sábado</option><option value="6">Domingo</option></select>
            <div class="grid gap-2 sm:grid-cols-2"><input id="timeslot-start-time" type="time" required class="bg-input border border-border rounded-lg px-3 py-2 text-sm" /><input id="timeslot-end-time" type="time" required class="bg-input border border-border rounded-lg px-3 py-2 text-sm" /></div>
            <div id="timeslot-form-error" class="hidden rounded-lg border border-red-500/20 bg-red-500/10 px-3 py-2 text-xs text-red-300"></div>
            <button class="w-full rounded-lg border border-border px-4 py-2 text-sm">Crear franja</button>
          </form>

          <form id="timeslot-batch-form" class="rounded-xl border border-border bg-background p-4 space-y-3">
            <h3 class="text-sm font-semibold">Crear lote por intervalos</h3>
            <select id="timeslot-batch-day-of-week" required class="w-full bg-input border border-border rounded-lg px-3 py-2 text-sm"><option value="">Día</option><option value="0">Lunes</option><option value="1">Martes</option><option value="2">Miércoles</option><option value="3">Jueves</option><option value="4">Viernes</option><option value="5">Sábado</option><option value="6">Domingo</option></select>
            <div class="grid gap-2 sm:grid-cols-2"><input id="timeslot-batch-start-time" type="time" required class="bg-input border border-border rounded-lg px-3 py-2 text-sm" /><input id="timeslot-batch-end-time" type="time" required class="bg-input border border-border rounded-lg px-3 py-2 text-sm" /></div>
            <input id="timeslot-batch-interval-minutes" type="number" min="1" required placeholder="Intervalo (min)" class="w-full bg-input border border-border rounded-lg px-3 py-2 text-sm" />
            <textarea id="timeslot-batch-breaks" rows="2" placeholder="11:00-11:30, 13:00-14:00" class="w-full bg-input border border-border rounded-lg px-3 py-2 text-sm"></textarea>
            <div id="timeslot-batch-form-error" class="hidden rounded-lg border border-red-500/20 bg-red-500/10 px-3 py-2 text-xs text-red-300"></div>
            <button class="w-full rounded-lg border border-border px-4 py-2 text-sm">Crear franjas por intervalo</button>
          </form>
        </div>
      </div>
    </section>

    <section class="bg-card border border-border rounded-xl p-5 space-y-4">
      <h2 class="text-lg font-semibold">Restricciones</h2>
      <p class="text-sm text-muted-foreground">Configura y desactiva restricciones globales o por periodo.</p>
      <div id="constraints-list" class="space-y-2 text-sm">
        <p id="constraints-empty" class="text-muted-foreground">Sin restricciones activas.</p>
      </div>
      <form id="constraint-form" class="rounded-xl border border-border bg-background p-4 space-y-3">
        <div class="grid gap-2 sm:grid-cols-2">
          <select id="constraint-kind" class="w-full bg-input border border-border rounded-lg px-3 py-2 text-sm"><option value="teacher_unavailable">Docente no disponible</option><option value="classroom_unavailable">Aula no disponible</option><option value="career_unavailable">Carrera no disponible</option></select>
          <select id="constraint-scope" class="w-full bg-input border border-border rounded-lg px-3 py-2 text-sm"><option value="period">Periodo</option><option value="global">Global</option></select>
        </div>
        <div class="grid gap-2 sm:grid-cols-2">
          <select id="constraint-period" class="w-full bg-input border border-border rounded-lg px-3 py-2 text-sm"><option value="">Selecciona periodo</option></select>
          <select id="constraint-teacher" class="w-full bg-input border border-border rounded-lg px-3 py-2 text-sm" disabled><option value="">Selecciona docente</option></select>
          <select id="constraint-classroom" class="w-full bg-input border border-border rounded-lg px-3 py-2 text-sm" disabled><option value="">Selecciona aula</option></select>
          <select id="constraint-career" class="w-full bg-input border border-border rounded-lg px-3 py-2 text-sm" disabled><option value="">Selecciona carrera</option></select>
        </div>
        <div class="grid gap-2 sm:grid-cols-3">
          <select id="constraint-day" class="w-full bg-input border border-border rounded-lg px-3 py-2 text-sm"><option value="0">Lunes</option><option value="1">Martes</option><option value="2">Miércoles</option><option value="3">Jueves</option><option value="4">Viernes</option></select>
          <input id="constraint-start" type="time" class="bg-input border border-border rounded-lg px-3 py-2 text-sm" />
          <input id="constraint-end" type="time" class="bg-input border border-border rounded-lg px-3 py-2 text-sm" />
        </div>
        <div id="constraint-form-error" class="hidden rounded-lg border border-red-500/20 bg-red-500/10 px-3 py-2 text-xs text-red-300"></div>
        <button class="w-full rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground">Guardar restricción</button>
      </form>
    </section>

    <section class="bg-card border border-border rounded-xl p-5 space-y-4">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="text-lg font-semibold">Infracciones</h2>
          <p class="text-sm text-muted-foreground">Revisa el resumen de infracciones detectadas para la ejecución seleccionada.</p>
        </div>
        <select id="violations-severity-filter" class="bg-input border border-border rounded-lg px-3 py-2 text-sm">
          <option value="">Todas las severidades</option>
          <option value="hard">Duras</option>
          <option value="soft">Blandas</option>
        </select>
      </div>
      <div class="grid gap-3 sm:grid-cols-3">
        <div class="rounded-xl border border-border/80 bg-muted/20 p-3">
          <p class="text-xs uppercase tracking-wide text-muted-foreground">Total</p>
          <p id="violations-total" class="mt-1 text-lg font-semibold">0 total</p>
        </div>
        <div class="rounded-xl border border-border/80 bg-muted/20 p-3">
          <p class="text-xs uppercase tracking-wide text-muted-foreground">Duras</p>
          <p id="violations-hard" class="mt-1 text-lg font-semibold">0 duras</p>
        </div>
        <div class="rounded-xl border border-border/80 bg-muted/20 p-3">
          <p class="text-xs uppercase tracking-wide text-muted-foreground">Blandas</p>
          <p id="violations-soft" class="mt-1 text-lg font-semibold">0 blandas</p>
        </div>
      </div>
      <ul id="violations-table-body" class="space-y-2 text-sm">
        <li class="text-sm text-muted-foreground">No hay infracciones para esta ejecución.</li>
      </ul>
    </section>
  </div>

  <div id="page-error" class="hidden p-6">
    <div class="rounded-xl border border-red-500/30 bg-red-500/10 p-4 text-sm text-red-300">
      <p id="page-error-message">No se pudo cargar la gestión de horarios.</p>
      <button id="retry-management-timetable-btn" type="button" class="mt-3 rounded-md border border-red-500/30 px-3 py-1.5 text-xs font-medium text-red-200 hover:bg-red-500/10">Reintentar</button>
    </div>
  </div>
  <div id="preview-modal" class="hidden fixed inset-0 z-50 bg-black/60 p-4">
    <div class="mx-auto mt-6 max-w-6xl rounded-xl border border-border bg-card p-4">
      <div class="mb-3 flex items-center justify-between">
        <h3 class="text-lg font-semibold">Preview semanal (L-V)</h3>
        <button id="preview-modal-close" class="rounded border border-border px-3 py-1 text-sm">Cerrar</button>
      </div>
      <div id="preview-warning-summary" class="hidden mb-3 rounded-lg border border-amber-500/20 bg-amber-500/10 px-3 py-2 text-sm text-amber-200"></div>
      <div class="mb-3 flex gap-2">
        <select id="preview-career-filter" class="rounded border border-border bg-input px-3 py-2 text-sm"><option value="">Todas las carreras</option></select>
      </div>
      <div id="preview-modal-error" class="hidden mb-2 rounded border border-red-500/20 bg-red-500/10 px-3 py-2 text-xs text-red-300"></div>
      <div id="preview-modal-empty" class="hidden mb-2 text-sm text-muted-foreground">Sin bloques para el filtro seleccionado.</div>
      <div class="overflow-auto">
        <table class="w-full text-xs">
          <thead><tr><th class="p-2 text-left">Hora</th><th class="p-2">Lunes</th><th class="p-2">Martes</th><th class="p-2">Miércoles</th><th class="p-2">Jueves</th><th class="p-2">Viernes</th></tr></thead>
          <tbody id="preview-grid-body"></tbody>
        </table>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  import API_BASE_URL from '@/config/api';
  import { toast } from '@/components/starwind/toast';
  import { buildTimeslotBatch, parseTimeslotBreakRanges, summarizeViolations, getRunDisplayName, classifyTimetableActionError, buildDraftRunPayload, buildManualTimeslotPayload, extractCareerOptions, normalizeAssignmentsToWeekGrid, buildWeekGridRows, buildConstraintPayload, mapConstraintFieldErrors, formatConstraintKind, formatConstraintScope, formatConstraintDay, formatConstraintEntity, formatConstraintTimeRange, canDeleteTimetableRunStatus, resolveTimetableRunPeriodId, filterClassesForRunPeriod } from '@/utils/timetable-management-utils';

  const API_URL = API_BASE_URL;
  const token = localStorage.getItem('access_token');
  const user = JSON.parse(localStorage.getItem('user-storage') || '{}')?.state?.user;
  if (!token) window.location.replace('/login');
  if (!user || !['a', 'm'].includes(user.role)) window.location.replace('/');

  const DAY_NAMES = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'];
  const TIMESLOTS_PAGE_SIZE = 20;
  const RUN_STATUS_LABELS = { draft: 'Borrador', running: 'En ejecución', completed: 'Completada', partial: 'Parcial', failed: 'Fallida', published: 'Publicada' };
  const RUN_BADGES = { published: 'bg-green-500/10 text-green-300', completed: 'bg-blue-500/10 text-blue-300', running: 'bg-cyan-500/10 text-cyan-300', partial: 'bg-amber-500/10 text-amber-300', failed: 'bg-red-500/10 text-red-300', draft: 'bg-muted text-foreground' };

  const q = (id) => document.getElementById(id);
  const unwrap = (x) => (Array.isArray(x) ? x : (x?.results || []));
  const esc = (v) => { const e = document.createElement('div'); e.textContent = String(v ?? ''); return e.innerHTML; };
  const err = (e, fb) => (e instanceof Error && e.message ? e.message : fb);

  let periods = []; let teachers = []; let classrooms = []; let careers = []; let runs = []; let timeslots = []; let assignments = []; let violations = []; let constraints = []; let selectedRunId = null;
  let selectedCareerId = null;
  let selectedTimeslotIds = new Set();
  let timeslotsPage = 1; let timeslotsPages = 1; let timeslotsCount = 0;

  async function apiFetch(path, options: RequestInit = {}) {
    const res = await fetch(`${API_URL}${path}`, { ...options, headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json', ...(options.headers || {}) } });
    if (res.status === 401) window.location.replace('/login');
    const ct = res.headers.get('content-type') || '';
    const payload = ct.includes('application/json') ? await res.json() : null;
    if (!res.ok) {
      const apiError = new Error(payload?.detail || payload?.mensaje || `HTTP ${res.status}`) as Error & { status?: number; payload?: any };
      apiError.status = res.status;
      apiError.payload = payload;
      throw apiError;
    }
    return payload;
  }

  async function loadScheduleAssignmentsByRun(runId) {
    const firstPage = await apiFetch(`/academic/schedule-assignments/?run=${runId}`);
    if (!firstPage || Array.isArray(firstPage) || !Array.isArray(firstPage.results)) return unwrap(firstPage);

    const merged = [...firstPage.results];
    let nextUrl = firstPage.next;
    while (nextUrl) {
      const normalizedNext = String(nextUrl);
      const relativeNext = normalizedNext.startsWith(API_URL) ? normalizedNext.slice(API_URL.length) : normalizedNext;
      const page = await apiFetch(relativeNext);
      const rows = Array.isArray(page?.results) ? page.results : unwrap(page);
      merged.push(...rows);
      nextUrl = page?.next;
    }
    return merged;
  }

  function showContent() { q('page-loading')?.classList.add('hidden'); q('page-content')?.classList.remove('hidden'); }
  function showPageError(message) {
    const error = q('page-error');
    const errorMessage = q('page-error-message');
    if (errorMessage) errorMessage.textContent = message;
    q('page-loading')?.classList.add('hidden');
    q('page-content')?.classList.add('hidden');
    error?.classList.remove('hidden');
  }
  function hidePageError() { q('page-error')?.classList.add('hidden'); }
  function selectedRun() { return runs.find((r) => Number(r.id) === Number(selectedRunId)) || null; }
  function selectedRunPeriodId() { return resolveTimetableRunPeriodId(selectedRun()); }
  function selectedTimeslotsOnPage() { return timeslots.filter((slot) => selectedTimeslotIds.has(Number(slot.id))); }
  function isTimeslotPageFullySelected() { return timeslots.length > 0 && timeslots.every((slot) => selectedTimeslotIds.has(Number(slot.id))); }
  function syncTimeslotSelectionToPage() {
    const visibleIds = new Set(timeslots.map((slot) => Number(slot.id)));
    selectedTimeslotIds = new Set(Array.from(selectedTimeslotIds).filter((id) => visibleIds.has(Number(id))));
  }

  function getRunWarningSummary(run) {
    return run?.warning_summary || run?.metadata?.generator?.warning_summary || null;
  }

  function buildWarningSummaryText(summary) {
    if (!summary || (!summary.total && !summary.hard_violations && !summary.soft_violations && !summary.precondition_errors?.length && !summary.class_preparation_errors?.length && !summary.unresolved_teachers?.length)) return '';
    const parts = [];
    if (summary.hard_violations) parts.push(`${summary.hard_violations} duras`);
    if (summary.soft_violations) parts.push(`${summary.soft_violations} blandas`);
    const preconditions = (summary.precondition_errors || []).length;
    if (preconditions) parts.push(`${preconditions} precondición${preconditions === 1 ? '' : 'es'}`);
    const preparations = (summary.class_preparation_errors || []).length;
    if (preparations) parts.push(`${preparations} preparación${preparations === 1 ? '' : 'es'}`);
    const unresolved = (summary.unresolved_teachers || []).length;
    if (unresolved) parts.push(`${unresolved} docentes sin resolver`);
    return parts.join(' · ');
  }

  function shouldBlockByWarnings(summary) {
    return Boolean(summary?.blocks_publish || summary?.hard_violations > 0);
  }

  function hasSoftOnlyWarnings(summary) {
    return Boolean(summary && !shouldBlockByWarnings(summary) && (summary.soft_violations > 0 || (summary.precondition_errors || []).length > 0 || (summary.class_preparation_errors || []).length > 0 || (summary.unresolved_teachers || []).length > 0));
  }

  function renderPeriodSelects() {
    const a = q('run-period-filter'); const b = q('run-period-create');
    if (!(a instanceof HTMLSelectElement) || !(b instanceof HTMLSelectElement)) return;
    const av = a.value; const bv = b.value;
    const opts = periods.map((p) => `<option value="${p.id}">${esc(p.name)}</option>`).join('');
    a.innerHTML = `<option value="">Todos los periodos</option>${opts}`;
    b.innerHTML = `<option value="">Selecciona un periodo</option>${opts}`;
    a.value = av; b.value = bv;
  }

  function renderConstraintCatalogSelects() {
    const period = q('constraint-period'); const teacher = q('constraint-teacher'); const classroom = q('constraint-classroom'); const career = q('constraint-career');
    if (!(period instanceof HTMLSelectElement) || !(teacher instanceof HTMLSelectElement) || !(classroom instanceof HTMLSelectElement) || !(career instanceof HTMLSelectElement)) return;
    const periodValue = period.value; const teacherValue = teacher.value; const classroomValue = classroom.value; const careerValue = career.value;
    period.innerHTML = `<option value="">Selecciona periodo</option>${periods.map((x) => `<option value="${x.id}">${esc(x.name || `periodo #${x.id}`)}</option>`).join('')}`;
    teacher.innerHTML = `<option value="">Selecciona docente</option>${teachers.map((x) => `<option value="${x.id}">${esc(x.full_name || x.username || `Docente #${x.id}`)}</option>`).join('')}`;
    classroom.innerHTML = `<option value="">Selecciona aula</option>${classrooms.map((x) => `<option value="${x.id}">${esc(x.name || x.code || `Aula #${x.id}`)}</option>`).join('')}`;
    career.innerHTML = `<option value="">Selecciona carrera</option>${careers.map((x) => `<option value="${x.id}">${esc(x.name || `Carrera #${x.id}`)}</option>`).join('')}`;
    period.value = periodValue; teacher.value = teacherValue; classroom.value = classroomValue; career.value = careerValue;
  }

  function syncConstraintSelectors() {
    const kind = q('constraint-kind'); const scope = q('constraint-scope'); const period = q('constraint-period'); const teacher = q('constraint-teacher'); const classroom = q('constraint-classroom'); const career = q('constraint-career');
    if (!(kind instanceof HTMLSelectElement) || !(scope instanceof HTMLSelectElement) || !(period instanceof HTMLSelectElement) || !(teacher instanceof HTMLSelectElement) || !(classroom instanceof HTMLSelectElement) || !(career instanceof HTMLSelectElement)) return;
    const globalScope = scope.value === 'global';
    period.disabled = globalScope;
    if (globalScope) period.value = '';
    const teacherEnabled = kind.value === 'teacher_unavailable';
    const classroomEnabled = kind.value === 'classroom_unavailable';
    const careerEnabled = kind.value === 'career_unavailable';
    teacher.disabled = !teacherEnabled;
    classroom.disabled = !classroomEnabled;
    career.disabled = !careerEnabled;
    if (!teacherEnabled) teacher.value = '';
    if (!classroomEnabled) classroom.value = '';
    if (!careerEnabled) career.value = '';
  }

  function renderRunBadge() {
