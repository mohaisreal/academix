    if (sf instanceof HTMLSelectElement && sf.value) params.set('severity', sf.value);
    violations = unwrap(await apiFetch(`/academic/constraint-violations/?${params.toString()}`)); renderViolations();
  }

  async function publishRun(id) {
    const run = runs.find((r) => Number(r.id) === Number(id)) || null;
    const summary = getRunWarningSummary(run);
    if (shouldBlockByWarnings(summary)) { toast.error('No se puede publicar: hay infracciones duras pendientes.'); return; }
    if (hasSoftOnlyWarnings(summary) && !window.confirm(`Esta ejecución tiene infracciones blandas (${summary.soft_violations || 0}). ¿Deseas publicar de todos modos?`)) return;
    try { await apiFetch(`/academic/timetable-runs/${id}/publish/`, { method: 'POST' }); toast.success('Ejecución publicada'); await Promise.all([loadRuns(), loadAssignments(), loadViolations()]); } catch (e) { toast.error(classifyTimetableActionError(e, 'publish')); }
  }
  async function generateRun(id) {
    const run = runs.find((r) => Number(r.id) === Number(id)) || null;
    const summary = getRunWarningSummary(run);
    if (shouldBlockByWarnings(summary)) { toast.error('No se puede generar: hay infracciones duras pendientes.'); return; }
    if (hasSoftOnlyWarnings(summary) && !window.confirm(`Esta ejecución tiene advertencias blandas (${summary.soft_violations || 0}). ¿Deseas continuar con la generación?`)) return;
    try { selectedRunId = id; await apiFetch(`/academic/timetable-runs/${id}/generate/`, { method: 'POST' }); toast.success('Horario generado'); await Promise.all([loadRuns(), loadAssignments(), loadViolations()]); } catch (e) { toast.error(classifyTimetableActionError(e, 'generate')); }
  }
  async function deleteRun(id) { try { await apiFetch(`/academic/timetable-runs/${id}/`, { method: 'DELETE' }); if (Number(selectedRunId) === Number(id)) selectedRunId = null; toast.success('Ejecución eliminada'); await Promise.all([loadRuns(), loadAssignments(), loadViolations()]); } catch (e) { toast.error(classifyTimetableActionError(e, 'delete')); } }
  async function cleanupGeneratedClasses() {
    const periodId = selectedRunPeriodId();
    if (!periodId) {
      toast.error('Selecciona una ejecución con periodo antes de limpiar las clases generadas.');
      return;
    }
    const confirmed = window.confirm('¿Eliminar todas las clases generadas automáticamente para el periodo seleccionado? Esta acción no se puede deshacer.');
    if (!confirmed) return;
    try {
      await apiFetch('/academic/timetable-runs/cleanup/generated-classes/', { method: 'POST', body: JSON.stringify({ period: periodId }) });
      toast.success('Clases generadas eliminadas');
      await Promise.all([loadRuns(), loadAssignments(), loadViolations()]);
    } catch (e) {
      toast.error(err(e, 'No se pudieron eliminar las clases generadas'));
    }
  }

