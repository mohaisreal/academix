  function renderTimeslots() {
    const tbody = q('timeslots-table-body'); const empty = q('timeslots-empty'); const pager = q('timeslots-pagination'); if (!tbody) return;
    syncTimeslotSelectionToPage();
    const prevBtn = q('timeslots-prev-btn'); const nextBtn = q('timeslots-next-btn'); const info = q('timeslots-page-info');
    const bulkDeleteBtn = q('delete-timeslots-btn');
    const selectAll = q('timeslots-select-all');
    if (timeslots.length === 0) {
      tbody.innerHTML = '';
      empty?.classList.remove('hidden');
      pager?.classList.add('hidden');
      if (bulkDeleteBtn instanceof HTMLButtonElement) bulkDeleteBtn.disabled = true;
      if (selectAll instanceof HTMLInputElement) selectAll.checked = false;
      if (info) info.textContent = 'Página 1 de 1 · 0 franjas';
      return;
    }
    empty?.classList.add('hidden');
    if (timeslotsPages > 1) {
      pager?.classList.remove('hidden');
