  async function deleteSelectedTimeslots() {
    if (selectedTimeslotIds.size === 0) return;
    const confirmed = window.confirm('Eliminar las franjas horarias seleccionadas puede afectar a asignaciones de horario relacionadas. ¿Deseas continuar?');
    if (!confirmed) return;
    const ids = Array.from(selectedTimeslotIds);
    const currentPage = timeslotsPage;
    try {
      const results = await Promise.allSettled(ids.map((id) => apiFetch(`/academic/time-slots/${id}/`, { method: 'DELETE' })));
      const failedIds = results.flatMap((result, index) => result.status === 'rejected' ? [ids[index]] : []);
      const deletedCount = ids.length - failedIds.length;
      if (deletedCount > 0) toast.success('Franjas horarias eliminadas');
      if (failedIds.length > 0) {
        selectedTimeslotIds = new Set(failedIds);
        toast.error(`No se pudieron eliminar ${failedIds.length} franja(s)`);
      } else {
        selectedTimeslotIds.clear();
      }
      await loadTimeslots(currentPage);
      if (currentPage > 1 && timeslots.length === 0) await loadTimeslots(currentPage - 1);
    } catch (e) {
      toast.error(classifyTimetableActionError(e, 'delete'));
    }
  }

  function renderViolations() {
    const list = q('violations-table-body'); if (!list) return;
    const sum = summarizeViolations(violations);
    const total = q('violations-total'); const hard = q('violations-hard'); const soft = q('violations-soft');
    if (total) total.textContent = `${sum.total} total`; if (hard) hard.textContent = `${sum.hard} duras`; if (soft) soft.textContent = `${sum.soft} blandas`;
    if (!selectedRunId || violations.length === 0) { list.innerHTML = '<li class="text-sm text-muted-foreground">No hay infracciones para esta ejecución.</li>'; return; }
    const findAssignment = (id) => assignments.find((a) => Number(a.id) === Number(id)) || null;
    const describeViolationTarget = (v) => {
      const assignment = v.assignment ? findAssignment(v.assignment) : null;
      const subject = v.metadata?.subject_code || v.metadata?.subject_name || assignment?.subject_code || assignment?.subject_name || 'Asignatura desconocida';
      const teacher = v.metadata?.teacher_name || assignment?.teacher_name || assignment?.teacher?.full_name || assignment?.teacher?.username || 'Docente no resuelto';
      return `${subject} · ${teacher}`;
    };
    const reasonEs = (v) => String(v.reason || v.mensaje || v.message || 'Motivo no disponible').trim();
    list.innerHTML = violations.map((v) => `<li class="rounded-lg border border-border p-2 space-y-1"><div><strong>${esc(v.severity === 'hard' ? 'Dura' : 'Blanda')}</strong> · ${esc(describeViolationTarget(v))} · penalización ${Number(v.penalty ?? 0)}</div><div class="text-muted-foreground">${esc(reasonEs(v))}</div></li>`).join('');
  }

