---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
---
<DashboardLayout title="Usuarios — Academix" currentPath="/management/users">
  <div id="page-loading" class="p-6 space-y-4">
    <div class="h-12 bg-card rounded-xl border border-border animate-pulse"></div>
    <div class="h-64 bg-card rounded-xl border border-border animate-pulse"></div>
  </div>

  <div id="page-content" class="hidden">
      <div class="border-b border-border px-4 py-4 sm:px-6">
      <h1 class="text-xl font-semibold text-foreground">Gestión de usuarios</h1>
      <p class="text-sm text-muted-foreground">Creá, editá y administrá usuarios con búsqueda y paginación</p>
    </div>

    <div class="space-y-6 p-4 sm:p-6">
      <section class="bg-card text-card-foreground rounded-xl border border-border overflow-hidden">
        <div class="flex flex-col gap-3 border-b border-border px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-5">
          <div>
            <h2 class="text-sm font-semibold text-foreground">Usuarios del sistema</h2>
            <p class="text-xs text-muted-foreground mt-0.5">Listado paginado conectado a la API</p>
          </div>
          <button id="new-user-btn" class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90 sm:w-auto">
            Nuevo usuario
          </button>
        </div>

        <div class="flex flex-col gap-3 border-b border-border px-4 py-3 sm:flex-row sm:flex-wrap sm:px-5">
          <input id="user-search" type="text" placeholder="Buscar por nombre o correo..." class="w-full min-w-0 flex-1 bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
          <select id="role-filter" class="w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary sm:w-auto">
            <option value="">Todos los roles</option>
            <option value="s">Estudiante</option>
            <option value="t">Profesor</option>
            <option value="m">Gestión</option>
            <option value="a">Admin</option>
          </select>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-border bg-muted/50">
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide px-5 py-3">Usuario</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide px-5 py-3">Correo electrónico</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide px-5 py-3">Rol</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide px-5 py-3">Estado</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide px-5 py-3">Acciones</th>
              </tr>
            </thead>
            <tbody id="users-table"></tbody>
          </table>
        </div>

        <div class="flex flex-col gap-3 border-t border-border px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:px-5">
          <p id="pagination-summary" class="text-xs text-muted-foreground">Página 1 de 1</p>
          <div class="flex items-center gap-2">
            <button id="prev-page" type="button" class="rounded-lg border border-border px-3 py-1.5 text-xs text-foreground hover:bg-muted disabled:opacity-50 disabled:cursor-not-allowed">Anterior</button>
            <button id="next-page" type="button" class="rounded-lg border border-border px-3 py-1.5 text-xs text-foreground hover:bg-muted disabled:opacity-50 disabled:cursor-not-allowed">Siguiente</button>
          </div>
        </div>

        <div id="users-empty" class="hidden py-10 text-center text-sm text-muted-foreground">No se encontraron usuarios</div>
      </section>
    </div>
  </div>

  <div id="modal-backdrop" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="w-full max-w-lg rounded-xl border border-border bg-background shadow-2xl max-h-[90vh] flex flex-col">
      <div class="flex items-center justify-between px-5 py-4 border-b border-border shrink-0">
        <h2 id="modal-title" class="text-base font-semibold text-foreground">Nuevo usuario</h2>
        <button id="modal-close" type="button" class="rounded-md p-1.5 text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">×</button>
      </div>
      <div class="overflow-y-auto flex-1 px-5 py-4">
        <form id="user-form" class="space-y-4">
          <input id="edit-id" type="hidden" value="" />
          <div>
            <label class="text-xs font-medium text-muted-foreground">Nombre *</label>
            <input id="user-first" type="text" required placeholder="Juan" class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Apellido *</label>
            <input id="user-last" type="text" required placeholder="Pérez" class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Correo electrónico *</label>
            <input id="user-email" type="email" required placeholder="usuario@academix.edu" class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Nombre de usuario *</label>
            <input id="user-username" type="text" required placeholder="juan.perez" class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Contraseña</label>
            <input id="user-password" type="password" placeholder="Mínimo 8 caracteres" class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Rol *</label>
            <select id="user-role" required class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
              <option value="s">Estudiante</option>
              <option value="t">Profesor</option>
              <option value="m">Gestión</option>
              <option value="a">Administración</option>
            </select>
          </div>
          <div id="user-department-wrapper" class="hidden">
            <label class="text-xs font-medium text-muted-foreground">Departamento</label>
            <select id="user-department" class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
              <option value="">Selecciona un departamento</option>
            </select>
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Teléfono</label>
            <input id="user-phone" type="tel" placeholder="+34 600 000 000" class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
          </div>
          <div class="flex items-center gap-3">
            <input id="user-active" type="checkbox" checked class="size-4 rounded border-border" />
            <label for="user-active" class="text-sm text-foreground">Activo</label>
          </div>
          <div id="form-error" class="hidden text-xs text-red-400 bg-red-500/10 rounded-lg p-3"></div>
        </form>
      </div>
      <div class="flex items-center justify-end gap-3 px-5 py-4 border-t border-border shrink-0">
        <button id="modal-cancel" type="button" class="inline-flex items-center justify-center rounded-md border border-input bg-background px-4 py-2 text-sm font-medium text-foreground hover:bg-muted transition-colors">Cancelar</button>
        <button id="modal-save" type="submit" form="user-form" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary/90 transition-colors">Guardar</button>
      </div>
    </div>
  </div>

  <div id="exceptional-backdrop" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="w-full max-w-lg rounded-xl border border-border bg-background shadow-2xl max-h-[90vh] flex flex-col">
      <div class="flex items-center justify-between px-5 py-4 border-b border-border shrink-0">
        <h2 class="text-base font-semibold text-foreground">Casos excepcionales</h2>
        <button id="exceptional-close" type="button" class="rounded-md p-1.5 text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">×</button>
      </div>
      <div class="overflow-y-auto flex-1 px-5 py-4 space-y-4">
        <p id="exceptional-student" class="text-sm text-muted-foreground"></p>
        <div class="grid gap-3 sm:grid-cols-2">
          <div>
            <label class="text-xs font-medium text-muted-foreground">ID asignatura</label>
            <input id="exceptional-subject-id" type="number" min="1" class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">ID periodo</label>
            <input id="exceptional-period-id" type="number" min="1" class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
          </div>
        </div>
        <div>
          <label class="text-xs font-medium text-muted-foreground">Motivo</label>
          <textarea id="exceptional-reason" rows="4" class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary"></textarea>
        </div>
        <div id="exceptional-error" class="hidden text-xs text-red-400 bg-red-500/10 rounded-lg p-3"></div>
      </div>
      <div class="flex items-center justify-end gap-3 px-5 py-4 border-t border-border shrink-0">
        <button id="exceptional-cancel" type="button" class="inline-flex items-center justify-center rounded-md border border-input bg-background px-4 py-2 text-sm font-medium text-foreground hover:bg-muted transition-colors">Cancelar</button>
        <button id="exceptional-save" type="button" class="inline-flex items-center justify-center rounded-md bg-amber-500 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-400 transition-colors">Guardar</button>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  import { buildUsersListEndpoint, buildUserWritePayload, canOpenExceptionalCases, getTotalPages, resetPageOnFilterChange, shouldRecoverToLastPage, shouldShowDepartmentField } from '@/utils/users-page-utils';
  import API_BASE_URL from '@/config/api';

  const STORAGE_KEY = 'user-storage';
  const TOKEN_KEY = 'access_token';
  const API_URL = API_BASE_URL;
  const PAGE_SIZE = 20;
  const ROLE_LABELS: Record<string, string> = { s: 'Estudiante', t: 'Profesor', m: 'Gestión', a: 'Administración' };
  let departments: { id: number; name: string }[] = [];

  function getUser() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY))?.state?.user ?? null; } catch { return null; }
  }

  const token = localStorage.getItem(TOKEN_KEY);
  if (!token) window.location.replace('/login');
  const user = getUser();
  if (!user) window.location.replace('/login');
  if (!['a', 'm'].includes(user.role)) window.location.replace('/');

  async function apiFetch(path, options = {}) {
    const res = await fetch(`${API_URL}${path}`, {
      headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
      ...options,
    });
    if (res.status === 401) { window.location.replace('/login'); throw new Error('No autorizado'); }
    if (res.status === 204) return {};
    if (!res.ok) throw new Error(`La solicitud falló (${res.status})`);
    return res.json();
  }

  function escHtml(str) {
    const d = document.createElement('div');
    d.textContent = String(str ?? '');
    return d.innerHTML;
  }

  let users: any[] = [];
  let searchQuery = '';
  let roleFilter = '';
  let currentPage = 1;
  let totalCount = 0;
  let exceptionalStudent: any = null;
  let exceptionalStudentId: number | null = null;

  function renderPagination() {
    const totalPages = getTotalPages(totalCount, PAGE_SIZE);
    const summary = document.getElementById('pagination-summary');
    if (summary) summary.textContent = `Página ${currentPage} de ${totalPages} (${totalCount} resultados)`;

    const prevBtn = document.getElementById('prev-page') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('next-page') as HTMLButtonElement | null;
    if (prevBtn) prevBtn.disabled = currentPage <= 1;
    if (nextBtn) nextBtn.disabled = currentPage >= totalPages;
  }

  function renderTable() {
    const tbody = document.getElementById('users-table');
    const empty = document.getElementById('users-empty');
    if (!tbody) return;

    if (users.length === 0) {
      tbody.innerHTML = '';
      empty?.classList.remove('hidden');
      return;
    }

    empty?.classList.add('hidden');
    tbody.innerHTML = users.map((u) => {
      const active = u.is_active !== false;
      const isSelf = u.id === user.id;
      return `<tr class="border-b border-border hover:bg-muted/40 transition-colors">
        <td class="px-5 py-3">${escHtml(u.first_name)} ${escHtml(u.last_name)} ${isSelf ? '<span class="text-xs text-muted-foreground">(tu cuenta)</span>' : ''}</td>
        <td class="px-5 py-3 text-sm text-muted-foreground">${escHtml(u.email ?? '—')}</td>
        <td class="px-5 py-3"><span class="text-xs">${escHtml(ROLE_LABELS[u.role] ?? u.role ?? '—')}</span></td>
        <td class="px-5 py-3">${active ? 'Activo' : 'Inactivo'}</td>
        <td class="px-5 py-3">
          <div class="flex items-center gap-2">
            <button class="edit-btn rounded-lg border border-border px-2.5 py-1 text-xs font-medium text-foreground hover:bg-muted transition-colors" data-id="${u.id}">Editar</button>
            ${canOpenExceptionalCases(u.role, isSelf) ? `<button class="exceptional-btn rounded-lg border border-border px-2.5 py-1 text-xs font-medium text-amber-400 hover:bg-amber-500/10 hover:border-amber-500/30 transition-colors" data-id="${u.id}" data-name="${escHtml(u.first_name ?? '')} ${escHtml(u.last_name ?? '')}">Casos excepcionales</button>` : ''}
            ${!isSelf ? `<button class="delete-btn rounded-lg border border-border px-2.5 py-1 text-xs font-medium text-red-400 hover:bg-red-500/10 hover:border-red-500/30 transition-colors" data-id="${u.id}">Eliminar</button>` : ''}
            ${!isSelf ? `<button class="toggle-btn rounded-lg border border-border px-2.5 py-1 text-xs font-medium transition-colors ${active ? 'text-amber-400 hover:bg-amber-500/10 hover:border-amber-500/30' : 'text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/30'}" data-id="${u.id}" data-active="${active}">${active ? 'Desactivar' : 'Activar'}</button>` : ''}
          </div>
        </td>
      </tr>`;
    }).join('');

    tbody.querySelectorAll('.edit-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = users.find((x) => x.id == (btn as HTMLElement).dataset.id);
        if (target) openPanel(target);
      });
    });

    tbody.querySelectorAll('.toggle-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.id;
        const active = (btn as HTMLElement).dataset.active === 'true';
        (window as any).confirmAction?.({
          title: active ? 'Desactivar usuario' : 'Activar usuario',
          description: active
            ? 'El usuario perderá acceso al sistema hasta que vuelva a activarse.'
            : 'El usuario recuperará acceso al sistema.',
          confirmLabel: active ? 'Desactivar' : 'Activar',
          variant: active ? 'default' : 'default',
          onConfirm: async () => {
            await apiFetch(`/users/${id}/`, { method: 'PATCH', body: JSON.stringify({ is_active: !active }) });
            await loadUsers(currentPage);
          },
        });
      });
    });

    tbody.querySelectorAll('.delete-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.id;
        (window as any).confirmAction?.({
          title: 'Eliminar usuario',
          description: '¿Eliminar este usuario de forma permanente? Esta acción no se puede deshacer.',
          confirmLabel: 'Eliminar',
          variant: 'destructive',
          onConfirm: async () => {
            await apiFetch(`/users/${id}/`, { method: 'DELETE' });
            await loadUsers(currentPage);
          },
        });
      });
    });

    tbody.querySelectorAll('.exceptional-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = users.find((x) => x.id == (btn as HTMLElement).dataset.id);
        if (target) openExceptionalCases(target);
      });
    });

  }

  async function loadUsers(page = 1) {
    try {
      currentPage = Math.max(1, page);
      const endpoint = buildUsersListEndpoint({ page: currentPage, search: searchQuery, role: roleFilter });
      const data = await apiFetch(endpoint);
      users = Array.isArray(data?.results) ? data.results : [];
      totalCount = Number(data?.count ?? users.length ?? 0);

      if (shouldRecoverToLastPage({ requestedPage: currentPage, count: totalCount, resultsLength: users.length, pageSize: PAGE_SIZE })) {
        currentPage = getTotalPages(totalCount, PAGE_SIZE);
        const recoveryEndpoint = buildUsersListEndpoint({ page: currentPage, search: searchQuery, role: roleFilter });
        const recovered = await apiFetch(recoveryEndpoint);
        users = Array.isArray(recovered?.results) ? recovered.results : [];
        totalCount = Number(recovered?.count ?? users.length ?? 0);
      }

      renderTable();
      renderPagination();
    } catch (err) {
      console.error('No se pudieron cargar los usuarios:', err);
      users = [];
      totalCount = 0;
      renderTable();
      renderPagination();
      const empty = document.getElementById('users-empty');
      if (empty) empty.textContent = 'No se pudieron cargar los usuarios.';
    } finally {
      document.getElementById('page-loading')?.classList.add('hidden');
      document.getElementById('page-content')?.classList.remove('hidden');
    }
  }

  async function loadAllDepartments() {
    const collected: { id: number; name: string }[] = [];
    let nextPath: string | null = '/academic/departments/?page=1';
    while (nextPath) {
      const data = await apiFetch(nextPath);
      const pageItems = Array.isArray(data?.results) ? data.results : [];
      collected.push(...pageItems.map((department: any) => ({ id: Number(department.id), name: String(department.name ?? '') })));
      nextPath = typeof data?.next === 'string' && data.next ? new URL(data.next, window.location.origin).pathname + new URL(data.next, window.location.origin).search : null;
    }
    departments = collected;
  }

  function renderDepartmentOptions(selectedId: number | null = null) {
    const select = document.getElementById('user-department') as HTMLSelectElement | null;
    if (!select) return;
    select.innerHTML = ['<option value="">Selecciona un departamento</option>', ...departments.map((department) => `<option value="${department.id}" ${selectedId === department.id ? 'selected' : ''}>${escHtml(department.name)}</option>`)].join('');
  }

  function syncDepartmentVisibility() {
    const role = (document.getElementById('user-role') as HTMLSelectElement)?.value ?? '';
    const wrapper = document.getElementById('user-department-wrapper');
    const select = document.getElementById('user-department') as HTMLSelectElement | null;
    const visible = shouldShowDepartmentField(role);
    wrapper?.classList.toggle('hidden', !visible);
    if (!visible && select) select.value = '';
  }

  function openPanel(u: any = null) {
    document.getElementById('form-error')?.classList.add('hidden');
    const pwInput = document.getElementById('user-password') as HTMLInputElement;
    if (u) {
      (document.getElementById('edit-id') as HTMLInputElement).value = u.id;
      (document.getElementById('user-first') as HTMLInputElement).value = u.first_name ?? '';
      (document.getElementById('user-last') as HTMLInputElement).value = u.last_name ?? '';
      (document.getElementById('user-email') as HTMLInputElement).value = u.email ?? '';
      (document.getElementById('user-username') as HTMLInputElement).value = u.username ?? '';
      (document.getElementById('user-role') as HTMLSelectElement).value = u.role ?? 's';
      renderDepartmentOptions(u.department ?? null);
      (document.getElementById('user-department') as HTMLSelectElement).value = u.department ? String(u.department) : '';
      (document.getElementById('user-phone') as HTMLInputElement).value = u.phone ?? '';
      (document.getElementById('user-active') as HTMLInputElement).checked = u.is_active !== false;
      pwInput.value = '';
      pwInput.removeAttribute('required');
    } else {
      (document.getElementById('edit-id') as HTMLInputElement).value = '';
      (document.getElementById('user-form') as HTMLFormElement).reset();
      (document.getElementById('user-active') as HTMLInputElement).checked = true;
      pwInput.setAttribute('required', '');
      renderDepartmentOptions(null);
    }
    syncDepartmentVisibility();
    document.getElementById('modal-backdrop')?.classList.remove('hidden');
  }

  function closePanel() { document.getElementById('modal-backdrop')?.classList.add('hidden'); }

  function openExceptionalCases(u: any) {
    if (!u || u.role !== 's') return;
    exceptionalStudent = u;
    exceptionalStudentId = u.id;
    (document.getElementById('exceptional-student') as HTMLElement).textContent = `Alumno: ${u.first_name ?? ''} ${u.last_name ?? ''} (${u.email ?? u.username})`;
    (document.getElementById('exceptional-error') as HTMLElement).classList.add('hidden');
    (document.getElementById('exceptional-subject-id') as HTMLInputElement).value = '';
    (document.getElementById('exceptional-period-id') as HTMLInputElement).value = '';
    (document.getElementById('exceptional-reason') as HTMLTextAreaElement).value = '';
    document.getElementById('exceptional-backdrop')?.classList.remove('hidden');
  }

  function closeExceptionalCases() { document.getElementById('exceptional-backdrop')?.classList.add('hidden'); }

  document.getElementById('new-user-btn')?.addEventListener('click', () => openPanel());
  document.getElementById('modal-close')?.addEventListener('click', closePanel);
  document.getElementById('modal-cancel')?.addEventListener('click', closePanel);
  document.getElementById('modal-backdrop')?.addEventListener('click', (e) => { if (e.target === e.currentTarget) closePanel(); });
  document.getElementById('exceptional-close')?.addEventListener('click', closeExceptionalCases);
  document.getElementById('exceptional-cancel')?.addEventListener('click', closeExceptionalCases);
  document.getElementById('exceptional-backdrop')?.addEventListener('click', (e) => { if (e.target === e.currentTarget) closeExceptionalCases(); });

  document.getElementById('prev-page')?.addEventListener('click', () => { if (currentPage > 1) loadUsers(currentPage - 1); });
  document.getElementById('next-page')?.addEventListener('click', () => { loadUsers(currentPage + 1); });

  document.getElementById('user-search')?.addEventListener('input', (e) => {
    const nextSearch = (e.target as HTMLInputElement).value;
    currentPage = resetPageOnFilterChange({
      currentPage,
      prevSearch: searchQuery,
      nextSearch,
      prevRole: roleFilter,
      nextRole: roleFilter,
    });
    searchQuery = nextSearch;
    loadUsers(currentPage);
  });

  document.getElementById('role-filter')?.addEventListener('change', (e) => {
    const nextRole = (e.target as HTMLSelectElement).value;
    currentPage = resetPageOnFilterChange({
      currentPage,
      prevSearch: searchQuery,
      nextSearch: searchQuery,
      prevRole: roleFilter,
      nextRole,
    });
    roleFilter = nextRole;
    loadUsers(currentPage);
  });

  document.getElementById('user-role')?.addEventListener('change', syncDepartmentVisibility);

  document.getElementById('user-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const errEl = document.getElementById('form-error');
    const id = (document.getElementById('edit-id') as HTMLInputElement).value;
    const body: any = {
      first_name: (document.getElementById('user-first') as HTMLInputElement).value.trim(),
      last_name: (document.getElementById('user-last') as HTMLInputElement).value.trim(),
      email: (document.getElementById('user-email') as HTMLInputElement).value.trim(),
      username: (document.getElementById('user-username') as HTMLInputElement).value.trim(),
      role: (document.getElementById('user-role') as HTMLSelectElement).value,
      phone: (document.getElementById('user-phone') as HTMLInputElement).value.trim(),
      is_active: (document.getElementById('user-active') as HTMLInputElement).checked,
    };
    const departmentValue = (document.getElementById('user-department') as HTMLSelectElement).value;
    Object.assign(body, buildUserWritePayload({ role: body.role, department: departmentValue ? Number(departmentValue) : null }));
    const pw = (document.getElementById('user-password') as HTMLInputElement).value;
    if (pw) body.password = pw;
    try {
      const url = id ? `/users/${id}/` : '/users/';
      const method = id ? 'PATCH' : 'POST';
      await apiFetch(url, { method, body: JSON.stringify(body) });
      closePanel();
      await loadUsers(currentPage);
    } catch (err: any) {
      errEl?.classList.remove('hidden');
      if (errEl) errEl.textContent = String(err?.message || 'No se ha podido guardar el usuario');
    }
  });

  document.getElementById('exceptional-save')?.addEventListener('click', async () => {
    const errEl = document.getElementById('exceptional-error');
    if (!exceptionalStudent || exceptionalStudent.role !== 's') return;
    const subjectId = Number((document.getElementById('exceptional-subject-id') as HTMLInputElement).value);
    const periodId = Number((document.getElementById('exceptional-period-id') as HTMLInputElement).value);
    const reason = (document.getElementById('exceptional-reason') as HTMLTextAreaElement).value.trim();
    if (!subjectId || !periodId || !reason) {
      errEl?.classList.remove('hidden');
      if (errEl) errEl.textContent = 'Completa asignatura, periodo y motivo.';
      return;
    }
    try {
      await apiFetch(`/enrollment/students/${exceptionalStudentId}/convocation-graces/`, {
        method: 'POST',
        body: JSON.stringify({ subject_id: subjectId, period_id: periodId, reason }),
      });
      closeExceptionalCases();
      await loadUsers(currentPage);
    } catch (err: any) {
      errEl?.classList.remove('hidden');
      if (errEl) errEl.textContent = String(err?.message || 'No se ha podido guardar el caso excepcional');
    }
  });

  

  await loadAllDepartments();
  loadUsers(1);
</script>
    

