---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
---
<DashboardLayout title="My Enrolment — Academix" currentPath="/my-enrolment">
  <div id="page-loading" class="p-6 space-y-4">
    <div class="h-28 bg-card rounded-xl border border-border animate-pulse"></div>
    <div class="grid grid-cols-3 gap-4">
      <div class="h-20 bg-card rounded-xl border border-border animate-pulse"></div>
      <div class="h-20 bg-card rounded-xl border border-border animate-pulse"></div>
      <div class="h-20 bg-card rounded-xl border border-border animate-pulse"></div>
    </div>
    <div class="h-64 bg-card rounded-xl border border-border animate-pulse"></div>
  </div>

  <div id="page-content" class="hidden">
    <div class="flex items-center justify-between border-b border-border px-6 py-4">
      <div>
        <h1 class="text-xl font-semibold text-foreground">My Enrolment</h1>
        <p class="text-sm text-muted-foreground">Your current academic enrollment status</p>
      </div>
    </div>

    <div class="p-6 space-y-6">
      <!-- Status card -->
      <div id="enrollment-status-card" class="bg-card text-card-foreground rounded-xl border border-border p-5"></div>

      <!-- Stats row -->
      <div class="grid grid-cols-3 gap-4" id="stats-row"></div>

      <!-- Classes table -->
      <div class="bg-card text-card-foreground rounded-xl border border-border p-5">
        <h2 class="text-lg font-semibold text-foreground mb-4">Enrolled Classes</h2>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-border">
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Subject</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Code</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Teacher</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Schedule</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Classroom</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Credits</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Status</th>
              </tr>
            </thead>
            <tbody id="classes-table-body"></tbody>
          </table>
        </div>
        <div id="classes-empty" class="hidden py-10 text-center text-sm text-muted-foreground">No classes found</div>
      </div>

      <!-- Empty state -->
      <div id="enrollment-empty" class="hidden bg-card text-card-foreground rounded-xl border border-border p-10 text-center">
        <div class="flex size-16 items-center justify-center rounded-full bg-muted mx-auto mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        </div>
        <p class="text-lg font-medium text-foreground">No active enrollment found</p>
        <p class="text-sm text-muted-foreground mt-1">Contact administration to get enrolled</p>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  const STORAGE_KEY = "user-storage";
  const TOKEN_KEY = "access_token";
  const API_URL = "http://localhost:8000/api";

  function getUser() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY))?.state?.user ?? null; }
    catch { return null; }
  }

  const token = localStorage.getItem(TOKEN_KEY);
  if (!token) window.location.replace('/login');
  const user = getUser();
  if (!user) window.location.replace('/login');
  const role = user?.role ?? '';

  if (role !== 's') window.location.replace('/');

  async function apiFetch(path, options = {}) {
    const res = await fetch(`${API_URL}${path}`, {
      headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
      ...options,
    });
    if (res.status === 401) window.location.replace('/login');
    return res.json();
  }

  function showContent() {
    document.getElementById('page-loading')?.classList.add('hidden');
    document.getElementById('page-content')?.classList.remove('hidden');
  }

  function escHtml(str) {
    const d = document.createElement('div');
    d.textContent = String(str ?? '');
    return d.innerHTML;
  }

  function formatDate(str) {
    if (!str) return '-';
    return new Date(str).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  }

  const STATUS_COLORS = {
    active: 'bg-green-500/15 text-green-400',
    pending: 'bg-yellow-500/15 text-yellow-400',
    completed: 'bg-blue-500/15 text-blue-400',
    dropped: 'bg-red-500/15 text-red-400',
  };

  (async () => {
    try {
      const data = await apiFetch('/enrollment/my-enrollment/');
      const enrollment = Array.isArray(data) ? data[0] : data;

      if (!enrollment || !enrollment.id) {
        document.getElementById('enrollment-status-card')?.classList.add('hidden');
        document.getElementById('stats-row')?.classList.add('hidden');
        document.getElementById('enrollment-empty')?.classList.remove('hidden');
        showContent();
        return;
      }

      const statusColor = STATUS_COLORS[enrollment.status] || 'bg-muted text-muted-foreground';
      const statusCard = document.getElementById('enrollment-status-card');
      if (statusCard) {
        statusCard.innerHTML = `
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xl font-bold text-foreground">${escHtml(enrollment.career_name || enrollment.career?.name || 'Unknown Career')}</p>
              <p class="text-sm text-muted-foreground mt-1">${escHtml(enrollment.period_name || enrollment.period?.name || 'Unknown Period')}</p>
              <p class="text-xs text-muted-foreground mt-1">Enrolled: ${formatDate(enrollment.enrolled_at || enrollment.created_at)}</p>
            </div>
            <span class="inline-flex items-center rounded-full ${statusColor} px-3 py-1 text-sm font-medium capitalize">${escHtml(enrollment.status || 'unknown')}</span>
          </div>
        `;
      }

      const classes = enrollment.classes || enrollment.enrolled_classes || [];
      const totalCredits = classes.reduce((sum, c) => sum + (parseFloat(c.credits) || 0), 0);

      const statsRow = document.getElementById('stats-row');
      if (statsRow) {
        statsRow.innerHTML = [
          { label: 'Total Credits', value: totalCredits, icon: '<circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/>' },
          { label: 'Total Classes', value: classes.length, icon: '<path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 6 3 6 3s3 0 6-3v-5"/>' },
          { label: 'Status', value: enrollment.status || '-', icon: '<path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>' },
        ].map(s => `
          <div class="bg-card text-card-foreground rounded-xl border border-border p-5">
            <div class="flex items-center gap-3">
              <div class="flex size-9 items-center justify-center rounded-full bg-primary/10">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">${s.icon}</svg>
              </div>
              <div>
                <p class="text-xs text-muted-foreground">${s.label}</p>
                <p class="text-lg font-bold text-foreground capitalize">${s.value}</p>
              </div>
            </div>
          </div>
        `).join('');
      }

      const tbody = document.getElementById('classes-table-body');
      const emptyEl = document.getElementById('classes-empty');
      if (classes.length === 0) {
        emptyEl?.classList.remove('hidden');
      } else {
        const DAY_NAMES = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
        tbody.innerHTML = classes.map(c => {
          const subject = c.subject_name || c.subject?.name || 'Subject';
          const code = c.subject_code || c.code || '-';
          const teacher = c.teacher_name || c.teacher?.full_name || '-';
          const classroom = c.classroom_name || c.classroom?.name || '-';
          const credits = c.credits || '-';
          const classStatus = c.status || 'active';
          const schedules = c.schedules || c.schedule || [];
          const schedText = schedules.map(s => `${DAY_NAMES[s.day_of_week]} ${s.start_time}`).join(', ') || '-';
          const sc = STATUS_COLORS[classStatus] || 'bg-muted text-muted-foreground';
          return `<tr class="border-b border-border hover:bg-muted/40 transition-colors">
            <td class="py-3 pr-4 text-sm font-medium text-foreground">${escHtml(subject)}</td>
            <td class="py-3 pr-4 text-sm text-muted-foreground">${escHtml(code)}</td>
            <td class="py-3 pr-4 text-sm text-muted-foreground">${escHtml(teacher)}</td>
            <td class="py-3 pr-4 text-sm text-muted-foreground">${escHtml(schedText)}</td>
            <td class="py-3 pr-4 text-sm text-muted-foreground">${escHtml(classroom)}</td>
            <td class="py-3 pr-4 text-sm text-muted-foreground">${credits}</td>
            <td class="py-3"><span class="inline-flex items-center rounded-full ${sc} px-2 py-0.5 text-xs font-medium capitalize">${escHtml(classStatus)}</span></td>
          </tr>`;
        }).join('');
      }
    } catch {
      document.getElementById('enrollment-empty')?.classList.remove('hidden');
    }
    showContent();
  })();
</script>
