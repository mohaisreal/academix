---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
---
<DashboardLayout title="Estadísticas — Academix" currentPath="/statistics">
  <div id="page-loading" class="p-6 space-y-4">
    <div class="h-12 bg-card rounded-xl border border-border animate-pulse"></div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="h-24 bg-card rounded-xl border border-border animate-pulse"></div>
      <div class="h-24 bg-card rounded-xl border border-border animate-pulse"></div>
      <div class="h-24 bg-card rounded-xl border border-border animate-pulse"></div>
      <div class="h-24 bg-card rounded-xl border border-border animate-pulse"></div>
    </div>
  </div>

  <div id="page-content" class="hidden">
    <div class="border-b border-border px-6 py-4">
      <div class="flex items-center justify-between gap-4">
        <div>
          <h1 class="text-xl font-semibold text-foreground">Estadísticas de la plataforma</h1>
          <p class="text-sm text-muted-foreground">Métricas generales de rendimiento académico</p>
        </div>
        <span id="period-badge" data-active-period-label="true" class="inline-flex items-center rounded-full bg-primary/10 px-3 py-1 text-sm font-medium text-primary"></span>
      </div>
    </div>

    <div class="p-6 space-y-6">
      <!-- Fila de KPI -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-card text-card-foreground rounded-xl border border-border p-5">
          <p class="text-xs text-muted-foreground uppercase tracking-wide">Total de estudiantes</p>
          <p id="kpi-students" class="mt-2 text-3xl font-bold text-foreground">—</p>
        </div>
        <div class="bg-card text-card-foreground rounded-xl border border-border p-5">
          <p class="text-xs text-muted-foreground uppercase tracking-wide">Total Profesores</p>
          <p id="kpi-teachers" class="mt-2 text-3xl font-bold text-foreground">—</p>
        </div>
        <div class="bg-card text-card-foreground rounded-xl border border-border p-5">
          <p class="text-xs text-muted-foreground uppercase tracking-wide">Matrículas activas</p>
          <p id="kpi-enrolments" class="mt-2 text-3xl font-bold text-foreground">—</p>
        </div>
        <div class="bg-card text-card-foreground rounded-xl border border-border p-5">
          <p class="text-xs text-muted-foreground uppercase tracking-wide">Promedio general de la plataforma</p>
          <p id="kpi-gpa" class="mt-2 text-3xl font-bold text-primary">—</p>
        </div>
      </div>

      <!-- Tabla de rendimiento de titulaciones -->
      <div class="bg-card text-card-foreground rounded-xl border border-border overflow-hidden">
        <div class="px-5 py-4 border-b border-border">
          <h2 class="text-sm font-semibold text-foreground">Rendimiento por carrera</h2>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-border bg-muted/50">
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide px-4 py-3">Carrera</th>
                <th class="text-right text-xs font-medium text-muted-foreground uppercase tracking-wide px-4 py-3">Estudiantes</th>
                <th class="text-right text-xs font-medium text-muted-foreground uppercase tracking-wide px-4 py-3">Clases activas</th>
                <th class="text-right text-xs font-medium text-muted-foreground uppercase tracking-wide px-4 py-3">Promedio</th>
                <th class="text-right text-xs font-medium text-muted-foreground uppercase tracking-wide px-4 py-3">Tasa de aprobación</th>
              </tr>
            </thead>
            <tbody id="career-stats-table"></tbody>
          </table>
        </div>
        <div id="stats-empty" class="hidden py-10 text-center text-sm text-muted-foreground">No hay estadísticas disponibles</div>
      </div>

      <!-- Distribución de estados de matrícula -->
      <div class="bg-card text-card-foreground rounded-xl border border-border p-5">
        <h2 class="text-sm font-semibold text-foreground mb-4">Distribución de estados de matrícula</h2>
        <div id="status-bars" class="space-y-3"></div>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  import API_BASE_URL from '@/config/api';
  import { fetchActivePeriodLabel } from '@/utils/period-display';
  const STORAGE_KEY = "user-storage";
  const TOKEN_KEY = "access_token";
  const API_URL = API_BASE_URL;

  function getUser() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY))?.state?.user ?? null; }
    catch { return null; }
  }
  const token = localStorage.getItem(TOKEN_KEY);
  if (!token) window.location.replace('/login');
  const user = getUser();
  if (!user) window.location.replace('/login');
  if (user.role !== 'm' && user.role !== 'a') window.location.replace('/');

  async function apiFetch(path, options = {}) {
    const res = await fetch(`${API_URL}${path}`, {
      headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
      ...options,
    });
    if (res.status === 401) window.location.replace('/login');
    return res.json();
  }

  function escHtml(str) {
    const d = document.createElement('div');
    d.textContent = String(str ?? '');
    return d.innerHTML;
  }

  async function setActivePeriodLabel() {
    const badge = document.getElementById('period-badge');
    if (!badge) return;
    badge.textContent = await fetchActivePeriodLabel(apiFetch);
  }

  async function loadStats() {
    await setActivePeriodLabel();
    const data = await apiFetch('/grades/statistics/');
    document.getElementById('page-loading')?.classList.add('hidden');
    document.getElementById('page-content')?.classList.remove('hidden');

    // KPIs
    (document.getElementById('kpi-students') as HTMLElement).textContent = data.total_students ?? '0';
    (document.getElementById('kpi-teachers') as HTMLElement).textContent = data.total_teachers ?? '0';
    (document.getElementById('kpi-enrolments') as HTMLElement).textContent = data.active_enrolments ?? '0';
    (document.getElementById('kpi-gpa') as HTMLElement).textContent = data.platform_gpa != null ? Number(data.platform_gpa).toFixed(1) + '%' : '—';

    // Estadísticas de titulaciones
    const tbody = document.getElementById('career-stats-table');
    const empty = document.getElementById('stats-empty');
    const careers: any[] = data.career_stats ?? [];
    if (careers.length === 0) {
      empty?.classList.remove('hidden');
    } else {
      empty?.classList.add('hidden');
      if (tbody) {
        tbody.innerHTML = careers.map(c => {
          const gpa = c.avg_gpa != null ? Number(c.avg_gpa).toFixed(1) + '%' : '—';
          const pass = c.pass_rate != null ? Number(c.pass_rate).toFixed(0) + '%' : '—';
          const passColor = Number(c.pass_rate ?? 0) >= 60 ? 'text-green-400' : 'text-red-400';
          return `<tr class="border-b border-border hover:bg-muted/40 transition-colors">
            <td class="px-4 py-3 text-sm font-medium text-foreground">${escHtml(c.name)}</td>
            <td class="px-4 py-3 text-sm text-muted-foreground text-right">${c.student_count ?? '—'}</td>
            <td class="px-4 py-3 text-sm text-muted-foreground text-right">${c.active_classes ?? '—'}</td>
            <td class="px-4 py-3 text-sm text-primary font-medium text-right">${gpa}</td>
            <td class="px-4 py-3 text-sm font-medium text-right ${passColor}">${pass}</td>
          </tr>`;
        }).join('');
      }
    }

    // Distribución de estados de matrícula
    const statuses: any = data.enrolment_by_status ?? {};
    const statusLabels: Record<string,string> = { pending: 'Pendiente', active: 'Activa', completed: 'Completada', dropped: 'Abandonada' };
    const statusColors: Record<string,string> = { pending: 'bg-yellow-400', active: 'bg-green-400', completed: 'bg-blue-400', dropped: 'bg-red-400' };
    const total = Object.values(statuses).reduce((a: number, b: any) => a + Number(b), 0) || 1;
    const barsEl = document.getElementById('status-bars');
    if (barsEl) {
      barsEl.innerHTML = Object.entries(statuses).map(([key, val]) => {
        const pct = Math.round((Number(val) / Number(total)) * 100);
        const label = statusLabels[key] ?? key;
        const color = statusColors[key] ?? 'bg-primary';
        return `<div>
          <div class="flex items-center justify-between text-xs mb-1">
            <span class="text-muted-foreground">${label}</span>
            <span class="text-foreground font-medium">${val} <span class="text-muted-foreground">(${pct}%)</span></span>
          </div>
          <div class="h-2 bg-muted rounded-full overflow-hidden">
            <div class="h-full ${color} rounded-full transition-all" style="width:${pct}%"></div>
          </div>
        </div>`;
      }).join('') || '<p class="text-sm text-muted-foreground">No hay datos de matrículas</p>';
    }
  }

  loadStats();
</script>

