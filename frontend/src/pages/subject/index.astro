---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
---
<DashboardLayout title="Asignaturas — Academix" currentPath="/subject">
  <div id="page-loading" class="p-6 space-y-4">
    <div class="h-12 bg-card rounded-xl border border-border animate-pulse"></div>
    <div class="h-64 bg-card rounded-xl border border-border animate-pulse"></div>
  </div>

  <div id="page-content" class="hidden">
    <div class="flex items-center justify-between border-b border-border px-6 py-4">
      <div>
        <h1 class="text-xl font-semibold text-foreground">Asignaturas</h1>
        <p class="text-sm text-muted-foreground">Gestiona las asignaturas del plan de estudios</p>
      </div>
      <div class="flex items-center gap-3">
        <select id="career-filter" class="bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
          <option value="">Todas las carreras</option>
        </select>
        <button id="new-subject-btn" class="inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Nueva asignatura
        </button>
      </div>
    </div>

    <div class="p-6">
      <div class="bg-card text-card-foreground rounded-xl border border-border p-5">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-border">
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Nombre</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Código</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Carrera</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Departamento</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Créditos</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Hs/semana</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Estado</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Acciones</th>
              </tr>
            </thead>
            <tbody id="subjects-table-body"></tbody>
          </table>
        </div>
        <div id="subjects-empty" class="hidden py-10 text-center text-sm text-muted-foreground">No se encontraron asignaturas</div>
        <div id="subjects-pagination" class="hidden mt-4 items-center justify-between">
          <p id="subjects-pagination-summary" class="text-sm text-muted-foreground"></p>
          <div class="flex items-center gap-2">
            <button id="subjects-prev" class="rounded-md border border-border px-3 py-1 text-sm disabled:opacity-50">Anterior</button>
            <span id="subjects-page" class="text-sm"></span>
            <button id="subjects-next" class="rounded-md border border-border px-3 py-1 text-sm disabled:opacity-50">Siguiente</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal centrado -->
  <div id="modal-backdrop" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="w-full max-w-lg rounded-xl border border-border bg-background shadow-2xl max-h-[90vh] flex flex-col">
      <!-- Cabecera -->
      <div class="flex items-center justify-between px-5 py-4 border-b border-border shrink-0">
        <h2 id="modal-title" class="text-base font-semibold text-foreground">Nueva asignatura</h2>
        <button id="modal-close" type="button" class="rounded-md p-1.5 text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <!-- Scrollable body -->
      <div class="overflow-y-auto flex-1 px-5 py-4">
        <form id="subject-form" class="space-y-4">
          <input id="edit-id" type="hidden" value="" />
          <div>
            <label class="text-xs font-medium text-muted-foreground">Nombre *</label>
            <input id="subject-name" type="text" required class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" placeholder="Calculus I" />
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Código *</label>
            <input id="subject-code" type="text" required class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" placeholder="MATH101" />
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Carrera *</label>
            <select id="subject-career" required class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
              <option value="">Selecciona una carrera</option>
            </select>
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Departamento</label>
            <select id="subject-department" class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
              <option value="">Sin departamento</option>
            </select>
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Créditos (1–10)</label>
            <input id="subject-credits" type="number" min="1" max="10" value="3" class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
          </div>
          <div class="rounded-lg border border-border bg-muted/20 p-3 space-y-3">
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Precio por crédito según intento</p>
              <p class="text-xs text-muted-foreground mt-0.5">La 4ª tarifa se aplica también a cualquier matrícula posterior.</p>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="text-xs font-medium text-muted-foreground">1ª matrícula</label>
                <input id="price-first" type="number" min="0" step="0.01" value="16.00" class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
              </div>
              <div>
                <label class="text-xs font-medium text-muted-foreground">2ª matrícula</label>
                <input id="price-second" type="number" min="0" step="0.01" value="28.00" class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
              </div>
              <div>
                <label class="text-xs font-medium text-muted-foreground">3ª matrícula</label>
                <input id="price-third" type="number" min="0" step="0.01" value="45.00" class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
              </div>
              <div>
                <label class="text-xs font-medium text-muted-foreground">4ª o más</label>
                <input id="price-fourth" type="number" min="0" step="0.01" value="60.00" class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
              </div>
            </div>
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Horas/semana (1–20)</label>
            <input id="subject-hours" type="number" min="1" max="20" value="4" class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Descripción</label>
            <textarea id="subject-desc" rows="3" class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary resize-none" placeholder="Descripción breve..."></textarea>
          </div>
          <div class="flex items-center gap-3">
            <input id="subject-active" type="checkbox" checked class="size-4 rounded border-border" />
            <label for="subject-active" class="text-sm text-foreground">Activa</label>
          </div>
          <div id="form-error" class="hidden text-xs text-red-400"></div>
        </form>
      </div>
      <!-- Pie fijo -->
      <div class="flex items-center justify-end gap-3 px-5 py-4 border-t border-border shrink-0">
        <button id="modal-cancel" type="button" class="inline-flex items-center justify-center rounded-md border border-input bg-background px-4 py-2 text-sm font-medium text-foreground hover:bg-muted transition-colors">Cancelar</button>
        <button id="modal-save" type="submit" form="subject-form" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary/90 transition-colors">Guardar</button>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  import { toast } from "@/components/starwind/toast";
  import { buildPaginatedEndpoint, getTotalPages, normalizePaginatedResponse, paginationSummary } from '@/utils/pagination-utils';
  const STORAGE_KEY = "user-storage";
  const TOKEN_KEY = "access_token";
  const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8000/api";

  function getUser() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY))?.state?.user ?? null; }
    catch { return null; }
  }

  const token = localStorage.getItem(TOKEN_KEY);
  if (!token) window.location.replace('/login');
  const user = getUser();
  if (!user) window.location.replace('/login');
  const role = user?.role ?? '';

  if (role !== 'm' && role !== 'a') window.location.replace('/');

  async function apiFetch(path, options = {}) {
    const res = await fetch(`${API_URL}${path}`, {
      headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
      ...options,
    });
    if (res.status === 401) window.location.replace('/login');
    return res.json();
  }

  function showContent() {
    document.getElementById('page-loading')?.classList.add('hidden');
    document.getElementById('page-content')?.classList.remove('hidden');
  }

  function escHtml(str) {
    const d = document.createElement('div');
    d.textContent = String(str ?? '');
    return d.innerHTML;
  }

  function formatMoney(value) {
    const n = Number(value ?? 0);
    return Number.isFinite(n) ? n.toFixed(2) : '0.00';
  }

  function formatCreditPrices(subject) {
    return [
      `1ª ${formatMoney(subject.credit_price_first_enrollment)}`,
      `2ª ${formatMoney(subject.credit_price_second_enrollment)}`,
      `3ª ${formatMoney(subject.credit_price_third_enrollment)}`,
      `4ª+ ${formatMoney(subject.credit_price_fourth_or_more_enrollment)}`,
    ].join(' · ');
  }

  let subjects = [];
  let careersList = [];
  let departmentsList = [];
  let currentPage = 1;
  let pagination = { count: 0, next: null, previous: null };

  function renderTable() {
    const tbody = document.getElementById('subjects-table-body');
    const empty = document.getElementById('subjects-empty');
    if (!tbody) return;
    if (subjects.length === 0) {
      tbody.innerHTML = '';
      empty?.classList.remove('hidden');
      return;
    }
    empty?.classList.add('hidden');
    tbody.innerHTML = subjects.map(s => {
      const active = s.is_active !== false;
      const careerName = s.career_name || careersList.find(c => c.id === s.career)?.name || '-';
      const departmentName = s.department_name || '-';
      const departmentTeacher = s.department_teacher_name || 'No asignado';
      return `<tr class="border-b border-border hover:bg-muted/40 transition-colors">
        <td class="py-3 pr-4 text-sm font-medium text-foreground">${escHtml(s.name)}</td>
        <td class="py-3 pr-4 text-sm text-muted-foreground font-mono">${escHtml(s.code)}</td>
        <td class="py-3 pr-4 text-sm text-muted-foreground">${escHtml(careerName)}</td>
        <td class="py-3 pr-4 text-sm text-muted-foreground">${escHtml(departmentName)}</td>
        <td class="py-3 pr-4 text-sm text-muted-foreground">${s.credits || '-'}</td>
        <td class="py-3 pr-4 text-sm text-muted-foreground">${s.hours_per_week || s.hours_week || '-'}</td>
        <td class="py-3 pr-4">
          <span class="inline-flex items-center rounded-full ${active ? 'bg-green-500/15 text-green-400' : 'bg-muted text-muted-foreground'} px-2 py-0.5 text-xs font-medium">${active ? 'Activa' : 'Inactiva'}</span>
        </td>
        <td class="py-3">
          <div class="flex items-center gap-2">
            <button class="edit-btn rounded-lg border border-border px-2.5 py-1 text-xs font-medium text-foreground hover:bg-muted transition-colors" data-id="${s.id}">Editar</button>
            <button class="delete-btn rounded-lg border border-border px-2.5 py-1 text-xs font-medium text-red-400 hover:bg-red-500/10 hover:border-red-500/30 transition-colors" data-id="${s.id}">Eliminar</button>
          </div>
        </td>
      </tr>`;
    }).join('');

    tbody.querySelectorAll('.edit-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const subject = subjects.find(s => s.id == (btn as HTMLElement).dataset.id);
        if (subject) openPanel(subject);
      });
    });

    tbody.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.id;
        (window as any).confirmAction?.({
          title: 'Eliminar asignatura',
          description: 'Esto eliminará la asignatura y todos sus datos asociados de forma permanente. Esta acción no se puede deshacer.',
          confirmLabel: 'Eliminar',
          variant: 'destructive',
          onConfirm: async () => {
            try {
              await apiFetch(`/academic/subjects/${id}/`, { method: 'DELETE' });
              await loadSubjects((document.getElementById('career-filter') as HTMLSelectElement)?.value || '');
            } catch { (window as any).showToast?.('error', 'No se pudo eliminar la asignatura'); }
          },
        });
      });
    });
    renderPagination();
  }

  function renderPagination() {
    const wrapper = document.getElementById('subjects-pagination');
    const summary = document.getElementById('subjects-pagination-summary');
    const page = document.getElementById('subjects-page');
    const prev = document.getElementById('subjects-prev') as HTMLButtonElement;
    const next = document.getElementById('subjects-next') as HTMLButtonElement;
    if (!wrapper || !summary || !page || !prev || !next) return;
    summary.textContent = paginationSummary({ count: pagination.count, currentPage, pageSize: 20 });
    page.textContent = `Página ${currentPage} de ${getTotalPages(pagination.count, 20)}`;
    prev.disabled = !pagination.previous;
    next.disabled = !pagination.next;
    wrapper.classList.toggle('hidden', pagination.count <= 20);
    wrapper.classList.toggle('flex', pagination.count > 20);
  }

  async function loadSubjects(careerId = '', page = currentPage) {
    try {
      currentPage = page;
      const data = await apiFetch(buildPaginatedEndpoint('/academic/subjects/', currentPage, { career: careerId }));
      const normalized = normalizePaginatedResponse(data);
      subjects = normalized.results;
      pagination = { count: normalized.count, next: normalized.next, previous: normalized.previous };
      renderTable();
    } catch { subjects = []; }
  }

  function openPanel(subject = null) {
    document.getElementById('form-error')?.classList.add('hidden');
    const title = document.getElementById('modal-title');
    const idEl = document.getElementById('edit-id') as HTMLInputElement;

    const careerSel = document.getElementById('subject-career') as HTMLSelectElement;
    const departmentSel = document.getElementById('subject-department') as HTMLSelectElement;
    careerSel.innerHTML = '<option value="">Selecciona una carrera</option>';
    departmentSel.innerHTML = '<option value="">Sin departamento</option>';
    careersList.forEach(c => {
      const opt = document.createElement('option');
      opt.value = c.id;
      opt.textContent = c.name;
      careerSel.appendChild(opt);
    });
    departmentsList.forEach(d => {
      const opt = document.createElement('option');
      opt.value = d.id;
      opt.textContent = d.name;
      departmentSel.appendChild(opt);
    });

    if (subject) {
      if (title) title.textContent = 'Editar asignatura';
      if (idEl) idEl.value = subject.id;
      (document.getElementById('subject-name') as HTMLInputElement).value = subject.name || '';
      (document.getElementById('subject-code') as HTMLInputElement).value = subject.code || '';
      careerSel.value = subject.career || '';
      departmentSel.value = subject.department ? String(subject.department) : '';
      (document.getElementById('subject-credits') as HTMLInputElement).value = subject.credits || 3;
      (document.getElementById('price-first') as HTMLInputElement).value = formatMoney(subject.credit_price_first_enrollment ?? 16);
      (document.getElementById('price-second') as HTMLInputElement).value = formatMoney(subject.credit_price_second_enrollment ?? 28);
      (document.getElementById('price-third') as HTMLInputElement).value = formatMoney(subject.credit_price_third_enrollment ?? 45);
      (document.getElementById('price-fourth') as HTMLInputElement).value = formatMoney(subject.credit_price_fourth_or_more_enrollment ?? 60);
      (document.getElementById('subject-hours') as HTMLInputElement).value = subject.hours_per_week || subject.hours_week || 4;
      (document.getElementById('subject-desc') as HTMLTextAreaElement).value = subject.description || '';
      (document.getElementById('subject-active') as HTMLInputElement).checked = subject.is_active !== false;
    } else {
      if (title) title.textContent = 'Nueva asignatura';
      if (idEl) idEl.value = '';
      (document.getElementById('subject-form') as HTMLFormElement)?.reset();
      departmentSel.value = '';
      (document.getElementById('subject-active') as HTMLInputElement).checked = true;
    }
    document.getElementById('modal-backdrop')?.classList.remove('hidden');
  }

  function closePanel() {
    document.getElementById('modal-backdrop')?.classList.add('hidden');
  }

  document.getElementById('new-subject-btn')?.addEventListener('click', () => openPanel());
  document.getElementById('modal-close')?.addEventListener('click', closePanel);
  document.getElementById('modal-cancel')?.addEventListener('click', closePanel);
  document.getElementById('modal-backdrop')?.addEventListener('click', e => { if (e.target === e.currentTarget) closePanel(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closePanel(); });

  document.getElementById('career-filter')?.addEventListener('change', (e) => {
    currentPage = 1;
    loadSubjects((e.target as HTMLSelectElement).value, 1);
  });
  document.getElementById('subjects-prev')?.addEventListener('click', () => {
    if (pagination.previous) loadSubjects((document.getElementById('career-filter') as HTMLSelectElement).value, currentPage - 1);
  });
  document.getElementById('subjects-next')?.addEventListener('click', () => {
    if (pagination.next) loadSubjects((document.getElementById('career-filter') as HTMLSelectElement).value, currentPage + 1);
  });

  document.getElementById('subject-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const errEl = document.getElementById('form-error');
    const id = (document.getElementById('edit-id') as HTMLInputElement).value;
    const name = (document.getElementById('subject-name') as HTMLInputElement).value;
    const code = (document.getElementById('subject-code') as HTMLInputElement).value;
    const career = (document.getElementById('subject-career') as HTMLSelectElement).value;
    const departmentRaw = (document.getElementById('subject-department') as HTMLSelectElement).value;
    const credits = parseInt((document.getElementById('subject-credits') as HTMLInputElement).value);
    const credit_price_first_enrollment = (document.getElementById('price-first') as HTMLInputElement).value;
    const credit_price_second_enrollment = (document.getElementById('price-second') as HTMLInputElement).value;
    const credit_price_third_enrollment = (document.getElementById('price-third') as HTMLInputElement).value;
    const credit_price_fourth_or_more_enrollment = (document.getElementById('price-fourth') as HTMLInputElement).value;
    const hours_per_week = parseInt((document.getElementById('subject-hours') as HTMLInputElement).value);
    const description = (document.getElementById('subject-desc') as HTMLTextAreaElement).value;
    const is_active = (document.getElementById('subject-active') as HTMLInputElement).checked;
    const payload = {
      name,
      code,
      career,
      department: departmentRaw ? Number(departmentRaw) : null,
      credits,
      credit_price_first_enrollment,
      credit_price_second_enrollment,
      credit_price_third_enrollment,
      credit_price_fourth_or_more_enrollment,
      hours_per_week,
      description,
      is_active,
    };
    try {
      if (id) {
        await apiFetch(`/academic/subjects/${id}/`, { method: 'PATCH', body: JSON.stringify(payload) });
      } else {
        await apiFetch('/academic/subjects/', { method: 'POST', body: JSON.stringify(payload) });
      }
      closePanel();
      await loadSubjects((document.getElementById('career-filter') as HTMLSelectElement)?.value || '');
    } catch {
      errEl?.classList.remove('hidden');
      if (errEl) errEl.textContent = 'No se ha podido guardar subject';
    }
  });

  (async () => {
    try {
      const [careersData, departmentsData] = await Promise.all([
        apiFetch('/academic/careers/'),
        apiFetch('/academic/departments/'),
      ]);
      careersList = Array.isArray(careersData) ? careersData : (careersData.results || []);
      departmentsList = Array.isArray(departmentsData) ? departmentsData : (departmentsData.results || []);
      const sel = document.getElementById('career-filter') as HTMLSelectElement;
      careersList.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.id;
        opt.textContent = c.name;
        sel?.appendChild(opt);
      });
    } catch {}
    await loadSubjects();
    showContent();
  })();
</script>
