---
import API_BASE_URL from '@/config/api';
import DashboardLayout from '@/layouts/DashboardLayout.astro';
---
<DashboardLayout title="periodos académicos — Academix" currentPath="/periods">
  <div id="page-loading" class="p-6 space-y-4">
    <div class="h-12 bg-card rounded-xl border border-border animate-pulse"></div>
    <div class="h-64 bg-card rounded-xl border border-border animate-pulse"></div>
  </div>

  <div id="page-content" class="hidden">
    <div class="flex items-center justify-between border-b border-border px-6 py-4">
      <div>
        <h1 class="text-xl font-semibold text-foreground">periodos académicos</h1>
        <p class="text-sm text-muted-foreground">Gestiona semestres y periodos académicos</p>
      </div>
      <button id="new-period-btn" class="inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Nuevo periodo
      </button>
    </div>

    <div class="p-6 space-y-4">
      <!-- Aviso de advertencia -->
      <div class="flex items-start gap-3 rounded-xl border border-yellow-500/30 bg-yellow-500/5 p-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-yellow-500 mt-0.5 shrink-0"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <p class="text-sm text-yellow-400">Activar un periodo desactivará todos los demás. Solo un periodo puede estar activo a la vez.</p>
      </div>

      <div class="bg-card text-card-foreground rounded-xl border border-border p-5">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-border">
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Nombre</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Código</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Fecha de inicio</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Fecha de fin</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Ventana de admisión</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Estado</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Acciones</th>
              </tr>
            </thead>
            <tbody id="periods-table-body"></tbody>
          </table>
        </div>
        <div id="periods-empty" class="hidden py-10 text-center text-sm text-muted-foreground">No se encontraron periodos</div>
        <div id="periods-pagination" class="hidden mt-4 items-center justify-between">
          <p id="periods-pagination-summary" class="text-sm text-muted-foreground"></p>
          <div class="flex gap-2 items-center">
            <button id="periods-prev" class="rounded-md border border-border px-3 py-1 text-sm disabled:opacity-50">Anterior</button>
            <span id="periods-page" class="text-sm"></span>
            <button id="periods-next" class="rounded-md border border-border px-3 py-1 text-sm disabled:opacity-50">Siguiente</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal centrado -->
  <div id="modal-backdrop" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="w-full max-w-lg rounded-xl border border-border bg-background shadow-2xl max-h-[90vh] flex flex-col">
      <!-- Cabecera -->
      <div class="flex items-center justify-between px-5 py-4 border-b border-border shrink-0">
        <h2 id="modal-title" class="text-base font-semibold text-foreground">Nuevo periodo</h2>
        <button id="modal-close" type="button" class="rounded-md p-1.5 text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <!-- Scrollable body -->
      <div class="overflow-y-auto flex-1 px-5 py-4">
        <form id="period-form" class="space-y-4">
          <input id="edit-id" type="hidden" value="" />
          <div>
            <label class="text-xs font-medium text-muted-foreground">Nombre *</label>
            <input id="period-name" type="text" required class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" placeholder="Primavera 2026" />
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Código *</label>
            <input id="period-code" type="text" required class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" placeholder="SP2026" />
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Fecha de inicio *</label>
            <input id="period-start" type="date" required class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Fecha de fin *</label>
            <input id="period-end" type="date" required class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Fecha de apertura de admisión</label>
            <input id="period-admission-open" type="datetime-local" class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Fecha de cierre de admisión</label>
            <input id="period-admission-close" type="datetime-local" class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
          </div>
          <div class="flex items-center gap-3">
            <input id="period-active" type="checkbox" class="size-4 rounded border-border" />
            <label for="period-active" class="text-sm text-foreground">Activo (desactivará los demás)</label>
          </div>
          <div id="form-error" class="hidden text-xs text-red-400"></div>
        </form>
      </div>
      <!-- Pie fijo -->
      <div class="flex items-center justify-end gap-3 px-5 py-4 border-t border-border shrink-0">
        <button id="modal-cancel" type="button" class="inline-flex items-center justify-center rounded-md border border-input bg-background px-4 py-2 text-sm font-medium text-foreground hover:bg-muted transition-colors">Cancelar</button>
        <button id="modal-save" type="submit" form="period-form" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary/90 transition-colors">Guardar</button>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  import { toast } from "@/components/starwind/toast";
  import { buildPaginatedEndpoint, getTotalPages, normalizePaginatedResponse, paginationSummary } from '@/utils/pagination-utils';
  const STORAGE_KEY = "user-storage";
  const TOKEN_KEY = "access_token";
  const API_URL = API_BASE_URL;

  function getUser() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY))?.state?.user ?? null; }
    catch { return null; }
  }

  const token = localStorage.getItem(TOKEN_KEY);
  if (!token) window.location.replace('/login');
  const user = getUser();
  if (!user) window.location.replace('/login');
  const role = user?.role ?? '';

  if (role !== 'm' && role !== 'a') window.location.replace('/');

  async function apiFetch(path, options = {}) {
    const res = await fetch(`${API_URL}${path}`, {
      headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
      ...options,
    });
    if (res.status === 401) window.location.replace('/login');
    return res.json();
  }

  function showContent() {
    document.getElementById('page-loading')?.classList.add('hidden');
    document.getElementById('page-content')?.classList.remove('hidden');
  }

  function escHtml(str) {
    const d = document.createElement('div');
    d.textContent = String(str ?? '');
    return d.innerHTML;
  }

  function formatDate(str) {
    if (!str) return '-';
    return new Date(str).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  }

  function formatDatetime(str) {
    if (!str) return '-';
    return new Date(str).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }

  let periods = [];
  let currentPage = 1;
  let pagination = { count: 0, next: null, previous: null };

  function renderTable() {
    const tbody = document.getElementById('periods-table-body');
    const empty = document.getElementById('periods-empty');
    if (!tbody) return;
    if (periods.length === 0) {
      tbody.innerHTML = '';
      empty?.classList.remove('hidden');
      return;
    }
    empty?.classList.add('hidden');
    tbody.innerHTML = periods.map(p => {
      const active = p.is_active === true;
      return `<tr class="border-b border-border hover:bg-muted/40 transition-colors">
        <td class="py-3 pr-4 text-sm font-medium text-foreground">${escHtml(p.name)}</td>
        <td class="py-3 pr-4 text-sm text-muted-foreground font-mono">${escHtml(p.code)}</td>
        <td class="py-3 pr-4 text-sm text-muted-foreground">${formatDate(p.start_date)}</td>
        <td class="py-3 pr-4 text-sm text-muted-foreground">${formatDate(p.end_date)}</td>
        <td class="py-3 pr-4 text-sm text-muted-foreground">${
          p.admission_open_date && p.admission_close_date
            ? `${formatDatetime(p.admission_open_date)} → ${formatDatetime(p.admission_close_date)}`
            : '—'
        }</td>
        <td class="py-3 pr-4">
          ${active ? '<span class="inline-flex items-center rounded-full bg-green-500/15 text-green-400 px-2 py-0.5 text-xs font-medium">Activo</span>' : '<span class="inline-flex items-center rounded-full bg-muted text-muted-foreground px-2 py-0.5 text-xs font-medium">Inactivo</span>'}
        </td>
        <td class="py-3">
          <div class="flex items-center gap-2">
            <button class="edit-btn rounded-lg border border-border px-2.5 py-1 text-xs font-medium text-foreground hover:bg-muted transition-colors" data-id="${p.id}">Editar</button>
            ${!active ? `<button class="activate-btn rounded-lg border border-border px-2.5 py-1 text-xs font-medium text-green-400 hover:bg-green-500/10 hover:border-green-500/30 transition-colors" data-id="${p.id}">Activar</button>` : ''}
            <button class="delete-btn rounded-lg border border-border px-2.5 py-1 text-xs font-medium text-red-400 hover:bg-red-500/10 hover:border-red-500/30 transition-colors" data-id="${p.id}">Eliminar</button>
          </div>
        </td>
      </tr>`;
    }).join('');

    tbody.querySelectorAll('.edit-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const period = periods.find(p => p.id == (btn as HTMLElement).dataset.id);
        if (period) openPanel(period);
      });
    });

    tbody.querySelectorAll('.activate-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.id;
        window.confirmAction({
          title: "Activar periodo",
          description: "Todos los demás periodos se desactivarán. ¿Continuar?",
          confirmLabel: "Activar",
          onConfirm: async () => {
            try {
              await apiFetch(`/academic/periods/${id}/`, { method: 'PATCH', body: JSON.stringify({ is_active: true }) });
              await loadPeriods();
            } catch { toast.error('No se pudo activar el periodo'); }
          },
        });
      });
    });

    tbody.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.id;
        window.confirmAction({
          title: "Eliminar periodo",
          description: "Esta acción no se puede deshacer.",
          confirmLabel: "Eliminar",
          variant: "destructive",
          onConfirm: async () => {
            try {
              await apiFetch(`/academic/periods/${id}/`, { method: 'DELETE' });
              await loadPeriods();
            } catch { toast.error('No se pudo eliminar el periodo'); }
          },
        });
      });
    });
    const wrapper = document.getElementById('periods-pagination');
    const summary = document.getElementById('periods-pagination-summary');
    const page = document.getElementById('periods-page');
    const prev = document.getElementById('periods-prev') as HTMLButtonElement;
    const next = document.getElementById('periods-next') as HTMLButtonElement;
    if (wrapper && summary && page && prev && next) {
      summary.textContent = paginationSummary({ count: pagination.count, currentPage, pageSize: 20 });
      page.textContent = `Página ${currentPage} de ${getTotalPages(pagination.count, 20)}`;
      prev.disabled = !pagination.previous;
      next.disabled = !pagination.next;
      wrapper.classList.toggle('hidden', pagination.count <= 20);
      wrapper.classList.toggle('flex', pagination.count > 20);
    }
  }

  async function loadPeriods(page = currentPage) {
    try {
      currentPage = page;
      const data = await apiFetch(buildPaginatedEndpoint('/academic/periods/', currentPage));
      const normalized = normalizePaginatedResponse(data);
      periods = normalized.results;
      pagination = { count: normalized.count, next: normalized.next, previous: normalized.previous };
      renderTable();
    } catch { periods = []; }
  }

  function openPanel(period = null) {
    document.getElementById('form-error')?.classList.add('hidden');
    const title = document.getElementById('modal-title');
    const idEl = document.getElementById('edit-id') as HTMLInputElement;

    if (period) {
      if (title) title.textContent = 'Editar periodo';
      if (idEl) idEl.value = period.id;
      (document.getElementById('period-name') as HTMLInputElement).value = period.name || '';
      (document.getElementById('period-code') as HTMLInputElement).value = period.code || '';
      (document.getElementById('period-start') as HTMLInputElement).value = period.start_date || '';
      (document.getElementById('period-end') as HTMLInputElement).value = period.end_date || '';
      (document.getElementById('period-admission-open') as HTMLInputElement).value = period.admission_open_date?.slice(0, 16) ?? '';
      (document.getElementById('period-admission-close') as HTMLInputElement).value = period.admission_close_date?.slice(0, 16) ?? '';
      (document.getElementById('period-active') as HTMLInputElement).checked = period.is_active === true;
    } else {
      if (title) title.textContent = 'Nuevo periodo';
      if (idEl) idEl.value = '';
      (document.getElementById('period-form') as HTMLFormElement)?.reset();
    }
    document.getElementById('modal-backdrop')?.classList.remove('hidden');
  }

  function closePanel() {
    document.getElementById('modal-backdrop')?.classList.add('hidden');
  }

  document.getElementById('new-period-btn')?.addEventListener('click', () => openPanel());
  document.getElementById('modal-close')?.addEventListener('click', closePanel);
  document.getElementById('modal-cancel')?.addEventListener('click', closePanel);
  document.getElementById('modal-backdrop')?.addEventListener('click', e => { if (e.target === e.currentTarget) closePanel(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closePanel(); });
  document.getElementById('periods-prev')?.addEventListener('click', () => { if (pagination.previous) loadPeriods(currentPage - 1); });
  document.getElementById('periods-next')?.addEventListener('click', () => { if (pagination.next) loadPeriods(currentPage + 1); });

  document.getElementById('period-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const errEl = document.getElementById('form-error');
    const id = (document.getElementById('edit-id') as HTMLInputElement).value;
    const name = (document.getElementById('period-name') as HTMLInputElement).value;
    const code = (document.getElementById('period-code') as HTMLInputElement).value;
    const start_date = (document.getElementById('period-start') as HTMLInputElement).value;
    const end_date = (document.getElementById('period-end') as HTMLInputElement).value;
    const is_active = (document.getElementById('period-active') as HTMLInputElement).checked;
    const admissionOpenRaw = (document.getElementById('period-admission-open') as HTMLInputElement).value;
    const admissionCloseRaw = (document.getElementById('period-admission-close') as HTMLInputElement).value;
    const admission_open_date = admissionOpenRaw.trim() || null;
    const admission_close_date = admissionCloseRaw.trim() || null;

    const doSave = async () => {
      try {
        if (id) {
          await apiFetch(`/academic/periods/${id}/`, { method: 'PATCH', body: JSON.stringify({ name, code, start_date, end_date, is_active, admission_open_date, admission_close_date }) });
        } else {
          await apiFetch('/academic/periods/', { method: 'POST', body: JSON.stringify({ name, code, start_date, end_date, is_active, admission_open_date, admission_close_date }) });
        }
        closePanel();
        await loadPeriods();
      } catch {
        errEl?.classList.remove('hidden');
        if (errEl) errEl.textContent = 'No se pudo guardar el periodo';
      }
    };

    if (is_active && !id) {
      window.confirmAction({
        title: "Activar periodo",
        description: "Activar este periodo desactivará todos los demás. ¿Continuar?",
        confirmLabel: "Activar",
        onConfirm: doSave,
      });
      return;
    }

    await doSave();
  });

  (async () => {
    await loadPeriods();
    showContent();
  })();
</script>
