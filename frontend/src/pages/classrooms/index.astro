---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
---
<DashboardLayout title="Aulas — Academix" currentPath="/classrooms">
  <div id="page-loading" class="p-6 space-y-4">
    <div class="h-12 bg-card rounded-xl border border-border animate-pulse"></div>
    <div class="h-64 bg-card rounded-xl border border-border animate-pulse"></div>
  </div>

  <div id="page-content" class="hidden">
    <div class="flex items-center justify-between border-b border-border px-6 py-4">
      <div>
        <h1 class="text-xl font-semibold text-foreground">Aulas</h1>
        <p class="text-sm text-muted-foreground">Gestioná aulas y espacios de enseñanza</p>
      </div>
      <div class="flex items-center gap-3">
        <select id="type-filter" class="bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
          <option value="">Todos los tipos</option>
          <option value="lecture">Teórica</option>
          <option value="lab">Laboratorio</option>
          <option value="seminar">Seminario</option>
        </select>
        <button id="new-classroom-btn" class="inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Nueva aula
        </button>
      </div>
    </div>

    <div class="p-6">
      <div class="bg-card text-card-foreground rounded-xl border border-border p-5">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-border">
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Nombre</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Edificio</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Capacidad</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Tipo</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Acciones</th>
              </tr>
            </thead>
            <tbody id="classrooms-table-body"></tbody>
          </table>
        </div>
        <div id="classrooms-empty" class="hidden py-10 text-center text-sm text-muted-foreground">No se encontraron aulas</div>
        <div id="classrooms-pagination" class="hidden mt-4 items-center justify-between">
          <p id="classrooms-pagination-summary" class="text-sm text-muted-foreground"></p>
          <div class="flex items-center gap-2">
            <button id="classrooms-prev" class="rounded-md border border-border px-3 py-1 text-sm disabled:opacity-50">Anterior</button>
            <span id="classrooms-page" class="text-sm"></span>
            <button id="classrooms-next" class="rounded-md border border-border px-3 py-1 text-sm disabled:opacity-50">Siguiente</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal centrado -->
  <div id="modal-backdrop" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="w-full max-w-lg rounded-xl border border-border bg-background shadow-2xl max-h-[90vh] flex flex-col">
      <!-- Cabecera -->
      <div class="flex items-center justify-between px-5 py-4 border-b border-border shrink-0">
        <h2 id="modal-title" class="text-base font-semibold text-foreground">Nueva aula</h2>
        <button id="modal-close" type="button" class="rounded-md p-1.5 text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <!-- Scrollable body -->
      <div class="overflow-y-auto flex-1 px-5 py-4">
        <form id="classroom-form" class="space-y-4">
          <input id="edit-id" type="hidden" value="" />
          <div>
            <label class="text-xs font-medium text-muted-foreground">Nombre *</label>
            <input id="classroom-name" type="text" required class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" placeholder="Aula 101" />
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Edificio *</label>
            <input id="classroom-building" type="text" required class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" placeholder="Edificio principal" />
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Capacidad *</label>
            <input id="classroom-capacity" type="number" required min="1" value="30" class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Tipo *</label>
            <select id="classroom-type" required class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
              <option value="lecture">Teórica</option>
              <option value="lab">Laboratorio</option>
              <option value="seminar">Seminario</option>
            </select>
          </div>
          <div id="form-error" class="hidden text-xs text-red-400"></div>
        </form>
      </div>
      <!-- Pie fijo -->
      <div class="flex items-center justify-end gap-3 px-5 py-4 border-t border-border shrink-0">
        <button id="modal-cancel" type="button" class="inline-flex items-center justify-center rounded-md border border-input bg-background px-4 py-2 text-sm font-medium text-foreground hover:bg-muted transition-colors">Cancelar</button>
        <button id="modal-save" type="submit" form="classroom-form" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary/90 transition-colors">Guardar</button>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  import API_BASE_URL from '@/config/api';
  import { toast } from "@/components/starwind/toast";
  import { buildPaginatedEndpoint, getTotalPages, normalizePaginatedResponse, paginationSummary } from '@/utils/pagination-utils';
  const STORAGE_KEY = "user-storage";
  const TOKEN_KEY = "access_token";
  const API_URL = API_BASE_URL;

  function getUser() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY))?.state?.user ?? null; }
    catch { return null; }
  }

  const token = localStorage.getItem(TOKEN_KEY);
  if (!token) window.location.replace('/login');
  const user = getUser();
  if (!user) window.location.replace('/login');
  const role = user?.role ?? '';

  if (role !== 'm' && role !== 'a') window.location.replace('/');

  async function apiFetch(path, options = {}) {
    const res = await fetch(`${API_URL}${path}`, {
      headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
      ...options,
    });
    if (res.status === 401) window.location.replace('/login');
    return res.json();
  }

  function showContent() {
    document.getElementById('page-loading')?.classList.add('hidden');
    document.getElementById('page-content')?.classList.remove('hidden');
  }

  function escHtml(str) {
    const d = document.createElement('div');
    d.textContent = String(str ?? '');
    return d.innerHTML;
  }

  const TYPE_BADGES = {
    lecture: 'bg-blue-500/15 text-blue-400',
    lab: 'bg-green-500/15 text-green-400',
    seminar: 'bg-purple-500/15 text-purple-400',
  };

  let allClassrooms = [];
  let currentPage = 1;
  let pagination = { count: 0, next: null, previous: null };
  let filterType = '';

  function renderTable(classrooms) {
    const tbody = document.getElementById('classrooms-table-body');
    const empty = document.getElementById('classrooms-empty');
    if (!tbody) return;
    if (classrooms.length === 0) {
      tbody.innerHTML = '';
      empty?.classList.remove('hidden');
      return;
    }
    empty?.classList.add('hidden');
    tbody.innerHTML = classrooms.map(c => {
      const type = c.room_type || c.type || 'lecture';
      const badge = TYPE_BADGES[type] || 'bg-muted text-muted-foreground';
      return `<tr class="border-b border-border hover:bg-muted/40 transition-colors">
        <td class="py-3 pr-4 text-sm font-medium text-foreground">${escHtml(c.name)}</td>
        <td class="py-3 pr-4 text-sm text-muted-foreground">${escHtml(c.building || '-')}</td>
        <td class="py-3 pr-4 text-sm text-muted-foreground">${c.capacity || '-'}</td>
        <td class="py-3 pr-4">
          <span class="inline-flex items-center rounded-full ${badge} px-2 py-0.5 text-xs font-medium capitalize">${type}</span>
        </td>
        <td class="py-3">
          <div class="flex items-center gap-2">
            <button class="edit-btn rounded-lg border border-border px-2.5 py-1 text-xs font-medium text-foreground hover:bg-muted transition-colors" data-id="${c.id}">Editar</button>
            <button class="delete-btn rounded-lg border border-border px-2.5 py-1 text-xs font-medium text-red-400 hover:bg-red-500/10 hover:border-red-500/30 transition-colors" data-id="${c.id}">Eliminar</button>
          </div>
        </td>
      </tr>`;
    }).join('');

    tbody.querySelectorAll('.edit-btn').forEach(btn => {
      btn.addEventListener('click', () => {
            const classroom = allClassrooms.find(c => c.id == (btn as HTMLElement).dataset.id);
        if (classroom) openPanel(classroom);
      });
    });

    tbody.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.id;
        window.confirmAction({
          title: "Eliminar aula",
          description: "Esta acción no se puede deshacer.",
          confirmLabel: "Eliminar",
          variant: "destructive",
          onConfirm: async () => {
            try {
              await apiFetch(`/academic/classrooms/${id}/`, { method: 'DELETE' });
              await loadClassrooms();
            } catch { toast.error('No se pudo eliminar el aula'); }
          },
        });
      });
    });
  }

  async function loadClassrooms(page = currentPage) {
    try {
      currentPage = page;
      const data = await apiFetch(buildPaginatedEndpoint('/academic/classrooms/', currentPage, { type: filterType }));
      const normalized = normalizePaginatedResponse(data);
      allClassrooms = normalized.results;
      pagination = { count: normalized.count, next: normalized.next, previous: normalized.previous };
      renderTable(allClassrooms);
      const wrapper = document.getElementById('classrooms-pagination');
      const summary = document.getElementById('classrooms-pagination-summary');
      const pageLabel = document.getElementById('classrooms-page');
      const prev = document.getElementById('classrooms-prev') as HTMLButtonElement;
      const next = document.getElementById('classrooms-next') as HTMLButtonElement;
      if (wrapper && summary && pageLabel && prev && next) {
        summary.textContent = paginationSummary({ count: pagination.count, currentPage, pageSize: 20 });
        pageLabel.textContent = `Página ${currentPage} de ${getTotalPages(pagination.count, 20)}`;
        prev.disabled = !pagination.previous;
        next.disabled = !pagination.next;
        wrapper.classList.toggle('hidden', pagination.count <= 20);
        wrapper.classList.toggle('flex', pagination.count > 20);
      }
    } catch { allClassrooms = []; }
  }

  document.getElementById('type-filter')?.addEventListener('change', (e) => {
    filterType = (e.target as HTMLSelectElement).value;
    currentPage = 1;
    loadClassrooms(1);
  });
  document.getElementById('classrooms-prev')?.addEventListener('click', () => { if (pagination.previous) loadClassrooms(currentPage - 1); });
  document.getElementById('classrooms-next')?.addEventListener('click', () => { if (pagination.next) loadClassrooms(currentPage + 1); });

  function openPanel(classroom = null) {
    document.getElementById('form-error')?.classList.add('hidden');
    const title = document.getElementById('modal-title');
    const idEl = document.getElementById('edit-id') as HTMLInputElement;

    if (classroom) {
      if (title) title.textContent = 'Editar aula';
      if (idEl) idEl.value = classroom.id;
      (document.getElementById('classroom-name') as HTMLInputElement).value = classroom.name || '';
      (document.getElementById('classroom-building') as HTMLInputElement).value = classroom.building || '';
      (document.getElementById('classroom-capacity') as HTMLInputElement).value = classroom.capacity || 30;
      (document.getElementById('classroom-type') as HTMLSelectElement).value = classroom.room_type || classroom.type || 'lecture';
    } else {
      if (title) title.textContent = 'Nueva aula';
      if (idEl) idEl.value = '';
      (document.getElementById('classroom-form') as HTMLFormElement)?.reset();
    }
    document.getElementById('modal-backdrop')?.classList.remove('hidden');
  }

  function closePanel() {
    document.getElementById('modal-backdrop')?.classList.add('hidden');
  }

  document.getElementById('new-classroom-btn')?.addEventListener('click', () => openPanel());
  document.getElementById('modal-close')?.addEventListener('click', closePanel);
  document.getElementById('modal-cancel')?.addEventListener('click', closePanel);
  document.getElementById('modal-backdrop')?.addEventListener('click', e => { if (e.target === e.currentTarget) closePanel(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closePanel(); });

  document.getElementById('classroom-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const errEl = document.getElementById('form-error');
    const id = (document.getElementById('edit-id') as HTMLInputElement).value;
    const name = (document.getElementById('classroom-name') as HTMLInputElement).value;
    const building = (document.getElementById('classroom-building') as HTMLInputElement).value;
    const capacity = parseInt((document.getElementById('classroom-capacity') as HTMLInputElement).value);
    const type = (document.getElementById('classroom-type') as HTMLSelectElement).value;
    try {
      if (id) {
        await apiFetch(`/academic/classrooms/${id}/`, { method: 'PATCH', body: JSON.stringify({ name, building, capacity, type }) });
      } else {
        await apiFetch('/academic/classrooms/', { method: 'POST', body: JSON.stringify({ name, building, capacity, type }) });
      }
      closePanel();
      await loadClassrooms();
    } catch {
      errEl?.classList.remove('hidden');
      if (errEl) errEl.textContent = 'No se ha podido guardar classroom';
    }
  });

  (async () => {
    await loadClassrooms();
    showContent();
  })();
</script>

