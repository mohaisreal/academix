---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
---

<DashboardLayout title="Departamentos — Academix" currentPath="/departments">
  <div id="page-loading" class="p-6 space-y-4">
    <div class="h-12 bg-card rounded-xl border border-border animate-pulse"></div>
    <div class="h-64 bg-card rounded-xl border border-border animate-pulse"></div>
  </div>

  <div id="page-error" class="hidden p-6">
    <div class="rounded-xl border border-red-500/30 bg-red-500/10 p-4 text-sm text-red-300">
      No se pudo cargar la página de departamentos. Reintentá en unos segundos.
    </div>
  </div>

  <div id="page-content" class="hidden">
    <div class="flex flex-col gap-3 border-b border-border px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <div>
        <h1 class="text-xl font-semibold text-foreground">Departamentos</h1>
        <p class="text-sm text-muted-foreground">Base de gestión de departamentos académicos</p>
      </div>
      <button id="new-department-btn" class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90 sm:w-auto">
        Nuevo departamento
      </button>
    </div>

    <div class="p-4 sm:p-6">
      <div class="bg-card text-card-foreground rounded-xl border border-border p-4 sm:p-5">
        <div class="overflow-x-auto">
          <table class="min-w-[900px] w-full">
            <thead>
              <tr class="border-b border-border">
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Nombre</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Código</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Responsable</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Asignaturas</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Decisiones</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Estado</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Acciones</th>
              </tr>
            </thead>
            <tbody id="departments-table-body"></tbody>
          </table>
        </div>
        <div id="departments-empty" class="hidden py-10 text-center text-sm text-muted-foreground">No se encontraron departamentos</div>
        <div id="departments-pagination" class="hidden mt-4 flex-col items-start justify-between gap-3 sm:flex-row sm:items-center">
          <p id="departments-pagination-summary" class="text-sm text-muted-foreground"></p>
          <div class="flex items-center gap-2">
            <button id="departments-prev" class="rounded-md border border-border px-3 py-1 text-sm disabled:opacity-50">Anterior</button>
            <span id="departments-page" class="text-sm"></span>
            <button id="departments-next" class="rounded-md border border-border px-3 py-1 text-sm disabled:opacity-50">Siguiente</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="modal-backdrop" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="w-full max-w-lg rounded-xl border border-border bg-background shadow-2xl max-h-[90vh] flex flex-col">
      <div class="flex items-center justify-between px-5 py-4 border-b border-border shrink-0">
        <h2 id="modal-title" class="text-base font-semibold text-foreground">Nuevo departamento</h2>
        <button id="modal-close" type="button" class="rounded-md p-1.5 text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="overflow-y-auto flex-1 px-5 py-4">
        <form id="department-form" class="space-y-4">
          <input id="edit-id" type="hidden" value="" />
          <div>
            <label class="text-xs font-medium text-muted-foreground">Nombre *</label>
            <input id="department-name" type="text" required class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground" placeholder="Ciencias Básicas" />
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Código *</label>
            <input id="department-code" type="text" required class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground" placeholder="CBAS" />
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Descripción</label>
            <textarea id="department-description" rows="3" class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground resize-none" placeholder="Descripción breve..."></textarea>
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Responsable</label>
            <select id="department-teacher" class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground">
              <option value="">Sin responsable</option>
            </select>
          </div>
          <div class="flex items-center gap-3">
            <input id="department-active" type="checkbox" checked class="size-4 rounded border-border" />
            <label for="department-active" class="text-sm text-foreground">Activo</label>
          </div>
          <div id="crud-error" class="hidden rounded-md border border-red-500/30 bg-red-500/10 px-3 py-2 text-xs text-red-300"></div>
        </form>
      </div>
      <div class="flex flex-col gap-3 px-5 py-4 border-t border-border shrink-0 sm:flex-row sm:items-center sm:justify-end">
        <button id="modal-cancel" type="button" class="inline-flex items-center justify-center rounded-md border border-input bg-background px-4 py-2 text-sm font-medium text-foreground transition-colors hover:bg-muted">Cancelar</button>
        <button id="modal-save" type="submit" form="department-form" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90">Guardar</button>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  import API_BASE_URL from '@/config/api';
  import { toast } from "@/components/starwind/toast";
  import { buildPaginatedEndpoint, getTotalPages, normalizePaginatedResponse, paginationSummary } from '@/utils/pagination-utils';

  const STORAGE_KEY = "user-storage";
  const TOKEN_KEY = "access_token";
  const API_URL = API_BASE_URL;

  function getUser() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY))?.state?.user ?? null; }
    catch { return null; }
  }

  const token = localStorage.getItem(TOKEN_KEY);
  if (!token) window.location.replace('/login');
  const user = getUser();
  if (!user) window.location.replace('/login');
  const role = user?.role ?? '';
  if (role !== 'm' && role !== 'a') window.location.replace('/');

  async function apiFetch(path, options = {}) {
    const res = await fetch(`${API_URL}${path}`, {
      headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
      ...options,
    });
    if (res.status === 401) window.location.replace('/login');
    if (!res.ok) {
      let message = `HTTP ${res.status}`;
      try {
        const data = await res.json();
        if (typeof data?.detail === 'string' && data.detail.trim()) message = data.detail;
      } catch {}
      throw new Error(message);
    }
    if (res.status === 204) return null;
    return res.json();
  }

  function showContent() {
    document.getElementById('page-loading')?.classList.add('hidden');
    document.getElementById('page-content')?.classList.remove('hidden');
  }

  function escHtml(str) {
    const d = document.createElement('div');
    d.textContent = String(str ?? '');
    return d.innerHTML;
  }

  function setCrudError(message = '') {
    const errEl = document.getElementById('crud-error');
    if (!errEl) return;
    if (!message) {
      errEl.classList.add('hidden');
      errEl.textContent = '';
      return;
    }
    errEl.textContent = message;
    errEl.classList.remove('hidden');
  }

  let departments = [];
  let teachers = [];
  let currentPage = 1;
  let pagination = { count: 0, next: null, previous: null };

  function renderPagination() {
    const wrapper = document.getElementById('departments-pagination');
    const summary = document.getElementById('departments-pagination-summary');
    const pageLabel = document.getElementById('departments-page');
    const prev = document.getElementById('departments-prev');
    const next = document.getElementById('departments-next');
    if (!(wrapper instanceof HTMLElement) || !(summary instanceof HTMLElement) || !(pageLabel instanceof HTMLElement) || !(prev instanceof HTMLButtonElement) || !(next instanceof HTMLButtonElement)) return;
    const totalPages = getTotalPages(pagination.count, 20);
    summary.textContent = paginationSummary({ count: pagination.count, currentPage, pageSize: 20 });
    pageLabel.textContent = `Página ${currentPage} de ${totalPages}`;
    prev.disabled = !pagination.previous;
    next.disabled = !pagination.next;
    wrapper.classList.toggle('hidden', pagination.count <= 20);
    wrapper.classList.toggle('flex', pagination.count > 20);
  }

  function renderTable() {
    const tbody = document.getElementById('departments-table-body');
    const empty = document.getElementById('departments-empty');
    if (!(tbody instanceof HTMLElement)) return;

    if (departments.length === 0) {
      tbody.innerHTML = '';
      empty?.classList.remove('hidden');
      renderPagination();
      return;
    }

    empty?.classList.add('hidden');
    tbody.innerHTML = departments.map(d => {
      const active = d.is_active !== false;
      const teacherName = d.teacher_name || 'Sin responsable';
      return `<tr class="border-b border-border hover:bg-muted/40 transition-colors">
        <td class="py-3 pr-4 text-sm font-medium text-foreground">${escHtml(d.name)}</td>
        <td class="py-3 pr-4 text-sm text-muted-foreground font-mono">${escHtml(d.code || '-')}</td>
        <td class="py-3 pr-4 text-sm text-muted-foreground">${escHtml(teacherName)}</td>
        <td class="py-3 pr-4 text-sm text-muted-foreground">${d.subjects_count ?? 0}</td>
        <td class="py-3 pr-4 text-sm text-muted-foreground">${d.pending_subject_decisions ?? 0} pendientes</td>
        <td class="py-3 pr-4"><span class="inline-flex items-center rounded-full ${active ? 'bg-green-500/15 text-green-400' : 'bg-muted text-muted-foreground'} px-2 py-0.5 text-xs font-medium">${active ? 'Activo' : 'Inactivo'}</span></td>
        <td class="py-3"><div class="flex items-center gap-2"><button class="edit-btn rounded-lg border border-border px-2.5 py-1 text-xs font-medium text-foreground hover:bg-muted transition-colors" data-id="${d.id}">Editar</button><button class="delete-btn rounded-lg border border-border px-2.5 py-1 text-xs font-medium text-red-400 hover:bg-red-500/10 hover:border-red-500/30 transition-colors" data-id="${d.id}">Eliminar</button></div></td>
      </tr>`;
    }).join('');

    tbody.querySelectorAll('.edit-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const department = departments.find(d => String(d.id) === (btn as HTMLElement).dataset.id);
        if (department) openPanel(department);
      });
    });

    tbody.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.id;
        (window as any).confirmAction?.({
          title: 'Eliminar departamento',
          description: 'Esta acción no se puede deshacer.',
          confirmLabel: 'Eliminar',
          variant: 'destructive',
          onConfirm: async () => {
            try {
              await apiFetch(`/academic/departments/${id}/`, { method: 'DELETE' });
              await loadDepartments();
              toast.success('Departamento eliminado');
            } catch {
              toast.error('No se pudo eliminar el departamento');
            }
          },
        });
      });
    });

    renderPagination();
  }

  function renderTeachers() {
    const teacherEl = document.getElementById('department-teacher');
    if (!(teacherEl instanceof HTMLSelectElement)) return;
    const current = teacherEl.value;
    teacherEl.innerHTML = '<option value="">Sin responsable</option>' + teachers.map(t => `<option value="${t.id}">${escHtml(t.full_name || `${t.first_name || ''} ${t.last_name || ''}`.trim() || t.username || `Docente #${t.id}`)}</option>`).join('');
    if (current && teachers.some(t => String(t.id) === current)) teacherEl.value = current;
  }

  async function loadDepartments(page = currentPage) {
    currentPage = page;
    const data = await apiFetch(buildPaginatedEndpoint('/academic/departments/', currentPage));
    const normalized = normalizePaginatedResponse(data);
    departments = normalized.results;
    pagination = { count: normalized.count, next: normalized.next, previous: normalized.previous };
    renderTable();
  }

  async function loadTeachers() {
    const data = await apiFetch('/users/teachers/');
    teachers = Array.isArray(data) ? data : (Array.isArray(data?.results) ? data.results : []);
    renderTeachers();
  }

  function openPanel(department = null) {
    const title = document.getElementById('modal-title');
    const idEl = document.getElementById('edit-id');
    const nameEl = document.getElementById('department-name');
    const codeEl = document.getElementById('department-code');
    const descEl = document.getElementById('department-description');
    const teacherEl = document.getElementById('department-teacher');
    const activeEl = document.getElementById('department-active');
    if (!(idEl instanceof HTMLInputElement) || !(nameEl instanceof HTMLInputElement) || !(codeEl instanceof HTMLInputElement) || !(descEl instanceof HTMLTextAreaElement) || !(teacherEl instanceof HTMLSelectElement) || !(activeEl instanceof HTMLInputElement)) return;
    setCrudError('');
    renderTeachers();

    if (department) {
      if (title) title.textContent = 'Editar departamento';
      idEl.value = String(department.id || '');
      nameEl.value = department.name || '';
      codeEl.value = department.code || '';
      descEl.value = department.description || '';
      teacherEl.value = department.teacher ? String(department.teacher) : '';
      activeEl.checked = department.is_active !== false;
    } else {
      if (title) title.textContent = 'Nuevo departamento';
      idEl.value = '';
      (document.getElementById('department-form'))?.reset();
      teacherEl.value = '';
      activeEl.checked = true;
    }

    document.getElementById('modal-backdrop')?.classList.remove('hidden');
  }

  function closePanel() {
    document.getElementById('modal-backdrop')?.classList.add('hidden');
    setCrudError('');
  }

  document.getElementById('new-department-btn')?.addEventListener('click', () => openPanel());
  document.getElementById('modal-close')?.addEventListener('click', closePanel);
  document.getElementById('modal-cancel')?.addEventListener('click', closePanel);
  document.getElementById('modal-backdrop')?.addEventListener('click', e => { if (e.target === e.currentTarget) closePanel(); });
  document.getElementById('departments-prev')?.addEventListener('click', () => { if (pagination.previous) loadDepartments(currentPage - 1); });
  document.getElementById('departments-next')?.addEventListener('click', () => { if (pagination.next) loadDepartments(currentPage + 1); });

  document.getElementById('department-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = (document.getElementById('edit-id') as HTMLInputElement)?.value || '';
    const name = (document.getElementById('department-name') as HTMLInputElement)?.value || '';
    const code = (document.getElementById('department-code') as HTMLInputElement)?.value || '';
    const description = (document.getElementById('department-description') as HTMLTextAreaElement)?.value || '';
    const teacherRaw = (document.getElementById('department-teacher') as HTMLSelectElement)?.value || '';
    const is_active = (document.getElementById('department-active') as HTMLInputElement)?.checked ?? true;

    setCrudError('');
    const payload = {
      name,
      code,
      description,
      teacher: teacherRaw ? Number(teacherRaw) : null,
      is_active,
    };

    try {
      if (id) {
        await apiFetch(`/academic/departments/${id}/`, { method: 'PATCH', body: JSON.stringify(payload) });
      } else {
        await apiFetch('/academic/departments/', { method: 'POST', body: JSON.stringify(payload) });
      }
      closePanel();
      await loadDepartments();
      toast.success('Departamento guardado');
    } catch {
      setCrudError('No se pudo guardar el departamento. Verificá nombre/código y reintentá.');
    }
  });

  (async () => {
    try {
      await Promise.all([loadTeachers(), loadDepartments()]);
      showContent();
    } catch {
      document.getElementById('page-loading')?.classList.add('hidden');
      document.getElementById('page-error')?.classList.remove('hidden');
    }
  })();
</script>

