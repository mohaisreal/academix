---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
---
<DashboardLayout title="Carreras — Academix" currentPath="/careers">
  <div id="page-loading" class="p-6 space-y-4">
    <div class="h-12 bg-card rounded-xl border border-border animate-pulse"></div>
    <div class="h-64 bg-card rounded-xl border border-border animate-pulse"></div>
  </div>

  <div id="page-content" class="hidden">
    <div class="flex items-center justify-between border-b border-border px-6 py-4">
      <div>
        <h1 class="text-xl font-semibold text-foreground">Carreras</h1>
        <p class="text-sm text-muted-foreground">Gestioná programas académicos y carreras</p>
      </div>
      <button id="new-career-btn" class="inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Nueva carrera
      </button>
    </div>

    <div class="p-6">
      <div class="bg-card text-card-foreground rounded-xl border border-border p-5">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-border">
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Nombre</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Código</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Duración</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Cupos totales</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Asignaturas</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Estado</th>
                <th class="text-left text-xs font-medium text-muted-foreground uppercase tracking-wide pb-3">Acciones</th>
              </tr>
            </thead>
            <tbody id="careers-table-body"></tbody>
          </table>
        </div>
        <div id="careers-empty" class="hidden py-10 text-center text-sm text-muted-foreground">No se encontraron carreras</div>
        <div id="careers-pagination" class="hidden mt-4 items-center justify-between">
          <p id="careers-pagination-summary" class="text-sm text-muted-foreground"></p>
          <div class="flex items-center gap-2">
            <button id="careers-prev" class="rounded-md border border-border px-3 py-1 text-sm disabled:opacity-50">Anterior</button>
            <span id="careers-page" class="text-sm text-foreground"></span>
            <button id="careers-next" class="rounded-md border border-border px-3 py-1 text-sm disabled:opacity-50">Siguiente</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal centrado -->
  <div id="modal-backdrop" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="w-full max-w-lg rounded-xl border border-border bg-background shadow-2xl max-h-[90vh] flex flex-col">
      <!-- Cabecera -->
      <div class="flex items-center justify-between px-5 py-4 border-b border-border shrink-0">
        <h2 id="modal-title" class="text-base font-semibold text-foreground">Nueva carrera</h2>
        <button id="modal-close" type="button" class="rounded-md p-1.5 text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <!-- Scrollable body -->
      <div class="overflow-y-auto flex-1 px-5 py-4">
        <form id="career-form" class="space-y-4">
          <input id="edit-id" type="hidden" value="" />
          <div>
            <label class="text-xs font-medium text-muted-foreground">Nombre *</label>
            <input id="career-name" type="text" required class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" placeholder="Ingeniería Informática" />
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Código *</label>
            <input id="career-code" type="text" required class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" placeholder="CS" />
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Descripción</label>
            <textarea id="career-desc" rows="3" class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary resize-none" placeholder="Descripción breve..."></textarea>
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Duración (años)</label>
            <input id="career-duration" type="number" min="1" max="6" value="4" class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
          </div>
          <div>
            <label class="text-xs font-medium text-muted-foreground">Cupos totales *</label>
            <input id="career-total-spots" type="number" min="0" step="1" required value="100" class="mt-1 w-full bg-input border border-border rounded-lg px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
          </div>
          <div class="flex items-center gap-3">
            <input id="career-active" type="checkbox" checked class="size-4 rounded border-border text-primary focus:ring-primary" />
            <label for="career-active" class="text-sm text-foreground">Activa</label>
          </div>
          <div id="form-error" class="hidden text-xs text-red-400"></div>
        </form>
      </div>
      <!-- Pie fijo -->
      <div class="flex items-center justify-end gap-3 px-5 py-4 border-t border-border shrink-0">
        <button id="modal-cancel" type="button" class="inline-flex items-center justify-center rounded-md border border-input bg-background px-4 py-2 text-sm font-medium text-foreground hover:bg-muted transition-colors">Cancelar</button>
        <button id="modal-save" type="submit" form="career-form" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary/90 transition-colors">Guardar</button>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  import API_BASE_URL from '@/config/api';
  import { toast } from "@/components/starwind/toast";
  import {
    DEFAULT_TOTAL_SPOTS,
    parseValidTotalSpots,
    resolveCareerTotalSpots,
  } from '@/utils/careers-form-utils';
  import {
    buildPaginatedEndpoint,
    getTotalPages,
    normalizePaginatedResponse,
    paginationSummary,
  } from '@/utils/pagination-utils';
  const STORAGE_KEY = "user-storage";
  const TOKEN_KEY = "access_token";
  const API_URL = API_BASE_URL;

  function getUser() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY))?.state?.user ?? null; }
    catch { return null; }
  }

  const token = localStorage.getItem(TOKEN_KEY);
  if (!token) window.location.replace('/login');
  const user = getUser();
  if (!user) window.location.replace('/login');
  const role = user?.role ?? '';

  if (role !== 'm' && role !== 'a') window.location.replace('/');

  async function apiFetch(path, options = {}) {
    const res = await fetch(`${API_URL}${path}`, {
      headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
      ...options,
    });
    if (res.status === 401) window.location.replace('/login');
    return res.json();
  }

  function showContent() {
    document.getElementById('page-loading')?.classList.add('hidden');
    document.getElementById('page-content')?.classList.remove('hidden');
  }

  function escHtml(str) {
    const d = document.createElement('div');
    d.textContent = String(str ?? '');
    return d.innerHTML;
  }

  let careers = [];
  let currentPage = 1;
  let pagination = { count: 0, next: null, previous: null };

  function renderTable() {
    const tbody = document.getElementById('careers-table-body');
    const empty = document.getElementById('careers-empty');
    if (!tbody) return;
    if (careers.length === 0) {
      tbody.innerHTML = '';
      empty?.classList.remove('hidden');
      return;
    }
    empty?.classList.add('hidden');
    tbody.innerHTML = careers.map(c => {
      const active = c.is_active !== false;
      const subjects = c.subjects_count ?? c.subjects?.length ?? '-';
      const totalSpots = resolveCareerTotalSpots(c.total_spots);
      return `<tr class="border-b border-border hover:bg-muted/40 transition-colors">
        <td class="py-3 pr-4 text-sm font-medium text-foreground">${escHtml(c.name)}</td>
        <td class="py-3 pr-4 text-sm text-muted-foreground font-mono">${escHtml(c.code)}</td>
        <td class="py-3 pr-4 text-sm text-muted-foreground">${c.duration_years || c.duration || '-'} años</td>
        <td class="py-3 pr-4 text-sm text-muted-foreground">${totalSpots}</td>
        <td class="py-3 pr-4 text-sm text-muted-foreground">${subjects}</td>
        <td class="py-3 pr-4">
          <span class="inline-flex items-center rounded-full ${active ? 'bg-green-500/15 text-green-400' : 'bg-muted text-muted-foreground'} px-2 py-0.5 text-xs font-medium">${active ? 'Activa' : 'Inactiva'}</span>
        </td>
        <td class="py-3">
          <div class="flex items-center gap-2">
            <button class="edit-btn rounded-lg border border-border px-2.5 py-1 text-xs font-medium text-foreground hover:bg-muted transition-colors" data-id="${c.id}">Editar</button>
            <button class="toggle-btn rounded-lg border border-border px-2.5 py-1 text-xs font-medium hover:bg-muted transition-colors ${active ? 'text-red-400 hover:border-red-500/30' : 'text-green-400 hover:border-green-500/30'}" data-id="${c.id}" data-active="${active}">${active ? 'Desactivar' : 'Activar'}</button>
            ${role === 'a' ? `<button class="delete-btn rounded-lg border border-border px-2.5 py-1 text-xs font-medium text-red-400 hover:bg-red-500/10 hover:border-red-500/30 transition-colors" data-id="${c.id}">Eliminar</button>` : ''}
          </div>
        </td>
      </tr>`;
    }).join('');

    tbody.querySelectorAll('.edit-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const career = careers.find(c => c.id == (btn as HTMLElement).dataset.id);
        if (career) openPanel(career);
      });
    });

    tbody.querySelectorAll('.toggle-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.id;
        const active = (btn as HTMLElement).dataset.active === 'true';
        try {
          await apiFetch(`/academic/careers/${id}/`, { method: 'PATCH', body: JSON.stringify({ is_active: !active }) });
          await loadCareers();
        } catch { toast.error('No se pudo actualizar status'); }
      });
    });

    tbody.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.id;
        window.confirmAction({
          title: "Eliminar carrera",
          description: "Esta acción no se puede deshacer.",
          confirmLabel: "Eliminar",
          variant: "destructive",
          onConfirm: async () => {
            try {
              await apiFetch(`/academic/careers/${id}/`, { method: 'DELETE' });
              await loadCareers();
            } catch { toast.error('No se pudo eliminar la carrera'); }
          },
        });
      });
    });

    renderPagination();
  }

  function renderPagination() {
    const wrapper = document.getElementById('careers-pagination');
    const summary = document.getElementById('careers-pagination-summary');
    const pageLabel = document.getElementById('careers-page');
    const prev = document.getElementById('careers-prev') as HTMLButtonElement;
    const next = document.getElementById('careers-next') as HTMLButtonElement;
    if (!wrapper || !summary || !pageLabel || !prev || !next) return;
    const totalPages = getTotalPages(pagination.count, 20);
    summary.textContent = paginationSummary({ count: pagination.count, currentPage, pageSize: 20 });
    pageLabel.textContent = `Página ${currentPage} de ${totalPages}`;
    prev.disabled = !pagination.previous;
    next.disabled = !pagination.next;
    wrapper.classList.toggle('hidden', pagination.count <= 20);
    wrapper.classList.toggle('flex', pagination.count > 20);
  }

  async function loadCareers(page = currentPage) {
    try {
      currentPage = page;
      const data = await apiFetch(buildPaginatedEndpoint('/academic/careers/', currentPage));
      const normalized = normalizePaginatedResponse(data);
      careers = normalized.results;
      pagination = { count: normalized.count, next: normalized.next, previous: normalized.previous };
      renderTable();
    } catch { careers = []; }
  }

  function openPanel(career = null) {
    const title = document.getElementById('modal-title');
    const idEl = document.getElementById('edit-id') as HTMLInputElement;
    const nameEl = document.getElementById('career-name') as HTMLInputElement;
    const codeEl = document.getElementById('career-code') as HTMLInputElement;
    const descEl = document.getElementById('career-desc') as HTMLTextAreaElement;
    const durEl = document.getElementById('career-duration') as HTMLInputElement;
    const totalSpotsEl = document.getElementById('career-total-spots') as HTMLInputElement;
    const activeEl = document.getElementById('career-active') as HTMLInputElement;
    document.getElementById('form-error')?.classList.add('hidden');

    if (career) {
      if (title) title.textContent = 'Editar carrera';
      if (idEl) idEl.value = career.id;
      if (nameEl) nameEl.value = career.name || '';
      if (codeEl) codeEl.value = career.code || '';
      if (descEl) descEl.value = career.description || '';
      if (durEl) durEl.value = career.duration_years || career.duration || 4;
      if (totalSpotsEl) totalSpotsEl.value = String(resolveCareerTotalSpots(career.total_spots));
      if (activeEl) activeEl.checked = career.is_active !== false;
    } else {
      if (title) title.textContent = 'Nueva carrera';
      if (idEl) idEl.value = '';
      (document.getElementById('career-form') as HTMLFormElement)?.reset();
      if (totalSpotsEl) totalSpotsEl.value = String(DEFAULT_TOTAL_SPOTS);
      if (activeEl) activeEl.checked = true;
    }
    document.getElementById('modal-backdrop')?.classList.remove('hidden');
  }

  function closePanel() {
    document.getElementById('modal-backdrop')?.classList.add('hidden');
  }

  document.getElementById('new-career-btn')?.addEventListener('click', () => openPanel());
  document.getElementById('modal-close')?.addEventListener('click', closePanel);
  document.getElementById('modal-cancel')?.addEventListener('click', closePanel);
  document.getElementById('modal-backdrop')?.addEventListener('click', e => { if (e.target === e.currentTarget) closePanel(); });
  document.getElementById('careers-prev')?.addEventListener('click', () => { if (pagination.previous) loadCareers(currentPage - 1); });
  document.getElementById('careers-next')?.addEventListener('click', () => { if (pagination.next) loadCareers(currentPage + 1); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closePanel(); });

  document.getElementById('career-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const errEl = document.getElementById('form-error');
    const id = (document.getElementById('edit-id') as HTMLInputElement).value;
    const name = (document.getElementById('career-name') as HTMLInputElement).value;
    const code = (document.getElementById('career-code') as HTMLInputElement).value;
    const description = (document.getElementById('career-desc') as HTMLTextAreaElement).value;
    const duration_years = parseInt((document.getElementById('career-duration') as HTMLInputElement).value);
    const totalSpotsRaw = (document.getElementById('career-total-spots') as HTMLInputElement).value;
    const total_spots = parseValidTotalSpots(totalSpotsRaw);
    const is_active = (document.getElementById('career-active') as HTMLInputElement).checked;

    if (total_spots === null) {
      errEl?.classList.remove('hidden');
      if (errEl) errEl.textContent = 'Ingresá cupos totales válidos (entero mayor o igual a 0).';
      return;
    }

    errEl?.classList.add('hidden');
    try {
      if (id) {
        await apiFetch(`/academic/careers/${id}/`, { method: 'PATCH', body: JSON.stringify({ name, code, description, duration_years, total_spots, is_active }) });
      } else {
        await apiFetch('/academic/careers/', { method: 'POST', body: JSON.stringify({ name, code, description, duration_years, total_spots, is_active }) });
      }
      closePanel();
      await loadCareers();
    } catch {
      errEl?.classList.remove('hidden');
      if (errEl) errEl.textContent = 'No se pudo guardar la carrera';
    }
  });

  (async () => {
    await loadCareers();
    showContent();
  })();
</script>

