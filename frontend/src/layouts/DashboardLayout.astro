                            Aulas
                        </a>
                        <a href="/management/timetable" class="nav-link flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            Gestión de horario
                        </a>
                        <p class="px-3 mb-1 mt-4 text-xs font-semibold uppercase tracking-wider text-muted-foreground/60">Admisiones</p>
                        <a href="/management/admissions" class="nav-link flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                            Admisiones
                        </a>
                        <a href="/management/identity-verifications" class="nav-link flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l7 4v5c0 5-3.5 8-7 9-3.5-1-7-4-7-9V7l7-4z"/><path d="M9 12l2 2 4-4"/></svg>
                            Verificación
                        </a>
                        <a href="/management/questionnaires" class="nav-link flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1" ry="1"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="12" y2="16"/></svg>
                            Cuestionarios
                        </a>
                        <a href="/enrolment/management" class="nav-link flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/></svg>
                            Matriculación
                        </a>
                        <a id="nav-users" href="/management/users" class="nav-link flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            Usuarios
                        </a>
                        <p class="px-3 mb-1 mt-4 text-xs font-semibold uppercase tracking-wider text-muted-foreground/60">Analíticas</p>
                        <a href="/statistics" class="nav-link flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                            Estadísticas
                        </a>
                        <a href="/files" class="nav-link flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                            Expedientes
                        </a>
                        <p id="nav-config-label" class="hidden px-3 mb-1 mt-4 text-xs font-semibold uppercase tracking-wider text-muted-foreground/60">Configuración</p>
                        <a id="nav-email-settings" href="/management/system" class="hidden nav-link flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                            Configuración de correo
                        </a>
                        <a id="nav-system" href="/system" class="hidden nav-link flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                            Sistema
                        </a>
                    </div>

                </nav>

                <!-- Sección de usuario al final de la barra lateral -->
                <div class="border-t border-border px-4 py-3 shrink-0">
                    <div class="flex items-center gap-3">
                        <Avatar size="sm">
                            <AvatarFallback class="bg-primary/20 text-primary text-xs">
                                <span id="sidebar-avatar-initials">--</span>
                            </AvatarFallback>
                        </Avatar>
                        <div class="min-w-0 flex-1">
                            <p id="sidebar-user-name" class="truncate text-sm font-medium text-foreground">Cargando...</p>
                            <p id="sidebar-user-role" class="text-xs text-muted-foreground capitalize">--</p>
                        </div>
                        <button id="logout-btn" type="button" aria-label="Cerrar sesión" class="rounded-md p-1.5 text-muted-foreground hover:text-foreground hover:bg-muted transition-colors shrink-0" title="Cerrar sesión">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                        </button>
                    </div>
                </div>
            </aside>

            <!-- ═══ MAIN CONTENT ══════════════════════════════════════════════════ -->
            <main class="mt-14 lg:pl-60 flex-1 bg-muted/20 min-h-[calc(100svh-3.5rem)]">
                <slot />
            </main>

        </div>

        <!-- Diálogo global de confirmación -->
        <div id="global-confirm-dialog">
            <div id="confirm-backdrop" class="fixed inset-0 z-50 hidden bg-black/50 data-[state=open]:animate-in data-[state=open]:fade-in data-[state=closed]:animate-out data-[state=closed]:fade-out data-[state=closed]:fill-mode-forwards" data-state="closed" style="animation-duration:200ms"></div>
            <dialog id="confirm-dialog" class="fixed top-[50%] left-[50%] z-50 w-full max-w-[calc(100%-2rem)] translate-x-[-50%] translate-y-[-50%] rounded-lg border bg-background p-6 shadow-lg sm:max-w-md data-[state=open]:animate-in data-[state=open]:fade-in data-[state=open]:zoom-in-95 data-[state=closed]:animate-out data-[state=closed]:fade-out data-[state=closed]:zoom-out-95 data-[state=closed]:fill-mode-forwards" data-state="closed" role="alertdialog" style="animation-duration:200ms">
                <div class="space-y-2">
                    <h2 id="confirm-dialog-title" class="text-lg font-semibold text-foreground">Confirmar</h2>
                    <p id="confirm-dialog-description" class="text-sm text-muted-foreground">¿Estás seguro?</p>
                </div>
                <div class="flex justify-end gap-3 mt-6">
                    <button id="confirm-dialog-cancel" type="button" class="inline-flex items-center justify-center rounded-md border border-input bg-background px-4 py-2 text-sm font-medium text-foreground shadow-sm hover:bg-accent hover:text-accent-foreground transition-colors">Cancelar</button>
                    <button id="confirm-dialog-action" type="button" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90 transition-colors">Confirmar</button>
                </div>
            </dialog>
        </div>

        <Toaster position="bottom-right" />
    </body>
</html>

<script>
    const STORAGE_KEY = "user-storage";
    const TOKEN_KEY = "access_token";
    const API_URL = API_BASE_URL;

    function getUser(): Record<string, any> | null {
        try {
            const stored = localStorage.getItem(STORAGE_KEY);
            if (!stored) return null;
            return JSON.parse(stored)?.state?.user ?? null;
        } catch { return null; }
    }

    function clearAuth() {
        localStorage.removeItem(TOKEN_KEY);
        localStorage.removeItem("refresh_token");
        localStorage.removeItem(STORAGE_KEY);
    }

    const THEME_STORAGE_KEY = "academix-theme";

    function applyTheme(theme: string) {
        const normalized = theme === "light" ? "light" : "dark";
        document.documentElement.classList.toggle("dark", normalized !== "light");
        document.documentElement.setAttribute("data-theme", normalized);
        try { localStorage.setItem(THEME_STORAGE_KEY, normalized); } catch {}
    }

    function isJwtExpired(jwt: string): boolean {
        try {
            const payload = JSON.parse(atob(jwt.split('.')[1]));
            return payload.exp ? Date.now() >= payload.exp * 1000 : true;
        } catch { return true; }
    }

    async function tryRefreshToken(): Promise<string | null> {
        const refresh = localStorage.getItem("refresh_token");
        if (!refresh) return null;
        try {
            const res = await fetch(`${API_URL}/users/token/refresh/`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ refresh }),
            });
            if (!res.ok) return null;
            const data = await res.json();
            if (data.access) {
                localStorage.setItem(TOKEN_KEY, data.access);
                if (data.refresh) localStorage.setItem("refresh_token", data.refresh);
                return data.access;
            }
            return null;
        } catch { return null; }
    }

    let token = localStorage.getItem(TOKEN_KEY);
    if (!token) { clearAuth(); window.location.replace("/login"); throw new Error("No token"); }

    if (isJwtExpired(token)) {
        const newToken = await tryRefreshToken();
        if (!newToken) { clearAuth(); window.location.replace("/login"); throw new Error("Token expired"); }
        token = newToken;
    }

    const user = getUser();
    if (!user) { clearAuth(); window.location.replace("/login"); throw new Error("No user"); }

    try {
        applyTheme(localStorage.getItem(THEME_STORAGE_KEY) || "dark");
        const prefRes = await fetch(`${API_URL}/notifications/preferences/`, {
            headers: { "Authorization": `Bearer ${token}` },
        });
        if (prefRes.ok) {
            const prefData = await prefRes.json();
            applyTheme(prefData?.theme || "dark");
        }
    } catch {
        applyTheme(localStorage.getItem(THEME_STORAGE_KEY) || "dark");
    }

    document.body.style.display = "";

    const role: string = user?.role ?? "";

    // Muestra el grupo de navegación según el rol
    const navStudent = document.getElementById("nav-student") as HTMLElement;
    const navTeacher = document.getElementById("nav-teacher") as HTMLElement;
    const navAdmin = document.getElementById("nav-admin") as HTMLElement;
    const navSystem = document.getElementById("nav-system") as HTMLElement;
    const navEmailSettings = document.getElementById("nav-email-settings") as HTMLElement;
    const navConfigLabel = document.getElementById("nav-config-label") as HTMLElement;

    const ACTIVE_ADMISSION_STATUSES = new Set([
        "submitted", "under_review", "provisional_admitted",
        "provisional_waitlisted", "admitted", "waitlisted", "confirmed", "completed",
    ]);

    if (role === "s") {
        navStudent?.classList.remove("hidden");
        // Restauración inmediata desde caché para evitar parpadeos entre navegaciones
        try {
            if (localStorage.getItem("enrollment-academic-visible") === "1") {
                document.getElementById("nav-student-academic")?.classList.remove("hidden");
            }
            if (localStorage.getItem("student-enrolment-actions-hidden") === "1") {
                document.getElementById("nav-student-enrolment-actions")?.classList.add("hidden");
            }
        } catch {}
        (async () => {
            try {
                const [enrollRes, admissionsRes, periodsRes] = await Promise.allSettled([
                    fetch(`${API_URL}/enrollment/career-enrollments/`, {
                        headers: { "Authorization": `Bearer ${token}` },
                    }),
                    fetch(`${API_URL}/admissions/applications/`, {
                        headers: { "Authorization": `Bearer ${token}` },
                    }),
                    fetch(`${API_URL}/academic/periods/?is_active=true`, {
                        headers: { "Authorization": `Bearer ${token}` },
                    }),
                ]);

                let enrollments: any[] = [];
                if (enrollRes.status === "fulfilled" && enrollRes.value.ok) {
                    const data = await enrollRes.value.json();
                    enrollments = Array.isArray(data) ? data : (data.results ?? []);
                }

                let applications: any[] = [];
                if (admissionsRes.status === "fulfilled" && admissionsRes.value.ok) {
                    const data = await admissionsRes.value.json();
                    applications = Array.isArray(data) ? data : (data.results ?? []);
                }

                let periods: any[] = [];
                if (periodsRes.status === "fulfilled" && periodsRes.value.ok) {
                    const data = await periodsRes.value.json();
                    periods = Array.isArray(data) ? data : (data.results ?? []);
                }
                const activePeriod = periods.find((p: any) => p?.is_active) ?? null;
                const getPeriodId = (enrollment: any) => String(
                    enrollment?.period_id_ro
                    ?? enrollment?.period?.id
                    ?? enrollment?.academic_period?.id
                    ?? enrollment?.period_id
                    ?? "",
                );
                const isCurrentPeriod = (enrollment: any) => !activePeriod || getPeriodId(enrollment) === String(activePeriod.id);
                const hasCompletedCurrentEnrollment = enrollments.some((e: any) => e.status === "completed" && isCurrentPeriod(e));

                if (enrollments.some((e: any) => ["active", "completed"].includes(e.status))) {
                    document.getElementById("nav-student-academic")?.classList.remove("hidden");
                    try { localStorage.setItem("enrollment-academic-visible", "1"); } catch {}
                } else {
                    document.getElementById("nav-student-academic")?.classList.add("hidden");
                    try { localStorage.removeItem("enrollment-academic-visible"); } catch {}
                }

                if (hasCompletedCurrentEnrollment) {
                    document.getElementById("nav-student-enrolment-actions")?.classList.add("hidden");
                    try { localStorage.setItem("student-enrolment-actions-hidden", "1"); } catch {}
                } else {
                    document.getElementById("nav-student-enrolment-actions")?.classList.remove("hidden");
                    try { localStorage.removeItem("student-enrolment-actions-hidden"); } catch {}
                }

                const hasActiveAdmission = applications.some((a: any) => ACTIVE_ADMISSION_STATUSES.has(a.status));
                const hasActiveEnrollment = enrollments.some((e: any) => ["active", "completed"].includes(e.status));
                if (hasActiveAdmission || hasActiveEnrollment) {
                    const applyLink = document.querySelector("a[href='/admissions']") as HTMLElement | null;
                    applyLink?.style.setProperty("display", "none");
                }
            } catch { /* non-critical — sidebar remains fully visible */
 }
        })();
    } else if (role === "t") {
        navTeacher?.classList.remove("hidden");
    } else if (role === "a") {
        navAdmin?.classList.remove("hidden");
        navSystem?.classList.remove("hidden");
        navEmailSettings?.classList.remove("hidden");
        navConfigLabel?.classList.remove("hidden");
    } else if (role === "m") {
        navAdmin?.classList.remove("hidden");
        navEmailSettings?.classList.remove("hidden");
        navConfigLabel?.classList.remove("hidden");
    }

    // Resaltado de enlace activo
    const currentPath = document.body.dataset.currentPath ?? "";
    document.querySelectorAll(".nav-link").forEach((link) => {
        const href = link.getAttribute("href") ?? "";
        if (href === currentPath || (currentPath.startsWith(href) && href !== "/" && href.length > 1)) {
            link.classList.add("bg-muted", "text-foreground");
            link.classList.remove("text-muted-foreground", "hover:text-foreground", "hover:bg-muted");
        }
    });

    // Rellena la sección de usuario
    if (user) {
        const firstName: string = user.first_name ?? "";
        const lastName: string = user.last_name ?? "";
        const username: string = user.username ?? "User";
        let initials = "";
        if (firstName && lastName) initials = (firstName[0] + lastName[0]).toUpperCase();
        else if (firstName) initials = firstName.substring(0, 2).toUpperCase();
        else initials = username.substring(0, 2).toUpperCase();
        const displayName = firstName && lastName ? `${firstName} ${lastName}` : username;
        const roleLabels: Record<string, string> = { s: "Estudiante", t: "Profesor", m: "Gestión", a: "Administración" };
        const avatarEl = document.getElementById("sidebar-avatar-initials");
        const nameEl = document.getElementById("sidebar-user-name");
        const roleEl = document.getElementById("sidebar-user-role");
        if (avatarEl) avatarEl.textContent = initials;
        if (nameEl) nameEl.textContent = displayName;
        if (roleEl) roleEl.textContent = roleLabels[role] ?? role;
    }

    // Cerrar sesión
    document.getElementById("logout-btn")?.addEventListener("click", () => {
        clearAuth();
        window.location.replace("/login");
    });

    // Recuento de notificaciones
    (async () => {
        try {
            const res = await fetch(`${API_URL}/notifications/unread-count/`, {
                headers: { "Authorization": `Bearer ${token}` },
            });
            if (res.ok) {
                const data = await res.json();
                if (data.count > 0) {
                    const countStr = data.count > 99 ? "99+" : String(data.count);
                    const badge = document.getElementById("notif-badge");
                    const badgeSidebar = document.getElementById("notif-badge-sidebar");
                    if (badge) { badge.textContent = countStr; badge.classList.remove("hidden"); }
                    if (badgeSidebar) { badgeSidebar.textContent = countStr; badgeSidebar.classList.remove("hidden"); }
                }
            }
        } catch { /* non-critical */
 }
    })();

    // ─── Conmutador de barra lateral (móvil) ──────────────────────────────────
    const sidebar = document.getElementById("sidebar") as HTMLElement;
    const sidebarBackdrop = document.getElementById("sidebar-backdrop") as HTMLElement;
    const sidebarOpenBtn = document.getElementById("sidebar-open-btn") as HTMLElement;

    function openSidebar() {
        sidebar.classList.remove("-translate-x-full");
        sidebar.classList.add("translate-x-0");
        sidebarBackdrop.classList.remove("hidden");
        document.body.classList.add("overflow-hidden", "lg:overflow-auto");
    }

    function closeSidebar() {
        sidebar.classList.add("-translate-x-full");
        sidebar.classList.remove("translate-x-0");
        sidebarBackdrop.classList.add("hidden");
        document.body.classList.remove("overflow-hidden", "lg:overflow-auto");
    }

    sidebarOpenBtn?.addEventListener("click", openSidebar);
    sidebarBackdrop?.addEventListener("click", closeSidebar);

    // Cierra la barra lateral al hacer clic en un enlace de navegación (móvil)
    sidebar?.querySelectorAll(".nav-link").forEach((link) => {
        link.addEventListener("click", () => {
            if (window.innerWidth < 1024) closeSidebar();
        });
    });

    // ─── Diálogo global de confirmación ───────────────────────────────────────
    const confirmDialog = document.getElementById("confirm-dialog") as HTMLDialogElement;
    const confirmBackdrop = document.getElementById("confirm-backdrop") as HTMLElement;
    const confirmTitle = document.getElementById("confirm-dialog-title") as HTMLElement;
    const confirmDesc = document.getElementById("confirm-dialog-description") as HTMLElement;
    const confirmAction = document.getElementById("confirm-dialog-action") as HTMLButtonElement;
    const confirmCancel = document.getElementById("confirm-dialog-cancel") as HTMLButtonElement;
    const CONFIRM_ANIM = 200;

    let _onConfirm: (() => void) | null = null;

    function closeConfirmDialog() {
        confirmDialog?.setAttribute("data-state", "closed");
        confirmBackdrop?.setAttribute("data-state", "closed");
        setTimeout(() => {
            confirmDialog?.close();
            confirmBackdrop?.classList.add("hidden");
            document.body.classList.remove("overflow-hidden");
        }, CONFIRM_ANIM);
        _onConfirm = null;
    }

    confirmCancel?.addEventListener("click", closeConfirmDialog);
    confirmBackdrop?.addEventListener("click", closeConfirmDialog);
    confirmDialog?.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.key === "Escape") { e.preventDefault(); closeConfirmDialog(); }
    });
    confirmAction?.addEventListener("click", () => { _onConfirm?.(); closeConfirmDialog(); });

    // ─── Helper global de toast ───────────────────────────────────────────────
    (window as any).showToast = function (variant: string, title: string, description?: string) {
        const manager = (window as any).__starwind__?.toast;
        if (!manager) return;
        manager.add({ title, description: description ?? '', variant });
    };

    (window as any).confirmAction = function (opts: { title: string; description: string; onConfirm: () => void; confirmLabel?: string; cancelLabel?: string; variant?: string }) {
        if (!confirmDialog || !confirmBackdrop) return;
        confirmTitle.textContent = opts.title;
        confirmDesc.textContent = opts.description;
        confirmAction.textContent = opts.confirmLabel ?? "Confirmar";
        confirmCancel.textContent = opts.cancelLabel ?? "Cancelar";
        if (opts.variant === "destructive") {
            confirmAction.className = "inline-flex items-center justify-center rounded-md bg-destructive px-4 py-2 text-sm font-medium text-destructive-foreground shadow-sm hover:bg-destructive/90 transition-colors";
        } else {
            confirmAction.className = "inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90 transition-colors";
        }
        _onConfirm = opts.onConfirm;
        confirmBackdrop.classList.remove("hidden");
        confirmDialog.showModal();
        document.body.classList.add("overflow-hidden");
        requestAnimationFrame(() => {
            confirmBackdrop.setAttribute("data-state", "open");
            confirmDialog.setAttribute("data-state", "open");
        });
    };
</script>
