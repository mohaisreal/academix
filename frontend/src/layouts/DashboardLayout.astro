---
import "@/styles/starwind.css";
import Avatar from "@/components/starwind/avatar/Avatar.astro";
import AvatarFallback from "@/components/starwind/avatar/AvatarFallback.astro";

interface Props {
    title: string;
    currentPath: string;
}
const { title, currentPath } = Astro.props;
---

<html lang="en" class="dark">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <style>
            .sidebar-nav { scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.08) transparent; }
            .sidebar-nav::-webkit-scrollbar { width: 4px; }
            .sidebar-nav::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.08); border-radius: 2px; }
            .kpi-card {
                opacity: 0;
                transform: translateY(12px);
                animation: fadeUp 0.4s ease-out forwards;
            }
            .kpi-card:nth-child(1) { animation-delay: 0.05s; }
            .kpi-card:nth-child(2) { animation-delay: 0.1s; }
            .kpi-card:nth-child(3) { animation-delay: 0.15s; }
            .kpi-card:nth-child(4) { animation-delay: 0.2s; }
            @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }
            @media (prefers-reduced-motion: reduce) { .kpi-card { opacity: 1; transform: none; animation: none; } }
            .nav-active { background-color: var(--color-muted) !important; color: var(--color-foreground) !important; }
        </style>
    </head>
    <body class="bg-background text-foreground" data-current-path={currentPath}>
        <div class="flex min-h-svh">

            <!-- SIDEBAR -->
            <aside class="fixed inset-y-0 left-0 z-40 flex w-56 flex-col border-r border-border bg-background">
                <!-- Logo -->
                <div class="flex items-center gap-2.5 px-5 py-5">
                    <div class="flex size-8 items-center justify-center rounded-lg bg-primary/10">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                        </svg>
                    </div>
                    <span class="text-lg font-bold tracking-tight text-foreground">academix</span>
                </div>

                <!-- Navigation -->
                <nav class="sidebar-nav flex-1 overflow-y-auto px-3 py-2">

                    <!-- HOME — visible to all roles -->
                    <p class="px-3 mb-1 mt-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground/60">Home</p>
                    <a href="/" class="nav-link flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                        Dashboard
                    </a>
                    <a href="/notifications" class="nav-link flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                        Notifications
                        <span id="notif-badge" class="ml-auto hidden text-xs bg-primary text-primary-foreground rounded-full px-1.5 py-0.5 leading-none">0</span>
                    </a>

                    <!-- STUDENT GROUP -->
                    <div id="nav-student" class="hidden">
                        <p class="px-3 mb-1 mt-4 text-xs font-semibold uppercase tracking-wider text-muted-foreground/60">Academic</p>
                        <a href="/my-subjects" class="nav-link flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 6 3 6 3s3 0 6-3v-5"/></svg>
                            My Subjects
                        </a>
                        <a href="/my-teachers" class="nav-link flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            My Teachers
                        </a>
                        <a href="/timetable" class="nav-link flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            Timetable
                        </a>
                        <a href="/grades" class="nav-link flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                            Grades
