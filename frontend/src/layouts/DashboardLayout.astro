                        Notificaciones
                        <span id="notif-badge-sidebar" class="ml-auto hidden text-xs bg-primary text-primary-foreground rounded-full px-1.5 py-0.5 leading-none">0</span>
                    </a>
                    <a href="/notifications/preferences" class="nav-link flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
