                <!-- User section at bottom -->
                <div class="border-t border-border px-4 py-3">
                    <div class="flex items-center gap-3">
                        <Avatar size="sm">
                            <AvatarFallback class="bg-primary/20 text-primary text-xs">
                                <span id="sidebar-avatar-initials">--</span>
                            </AvatarFallback>
                        </Avatar>
                        <div class="min-w-0 flex-1">
                            <p id="sidebar-user-name" class="truncate text-sm font-medium text-foreground">Loading...</p>
                            <p id="sidebar-user-role" class="text-xs text-muted-foreground capitalize">--</p>
                        </div>
                        <button id="logout-btn" type="button" aria-label="Sign out" class="rounded-md p-1.5 text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                        </button>
                    </div>
                </div>
            </aside>

            <!-- MAIN CONTENT -->
            <main class="ml-56 flex-1 bg-muted/20">
                <slot />
            </main>
        </div>
    </body>
</html>

<script>
    const STORAGE_KEY = "user-storage";
    const TOKEN_KEY = "access_token";
    const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8000/api";

    function getUser(): Record<string, any> | null {
        try {
            const stored = localStorage.getItem(STORAGE_KEY);
            if (!stored) return null;
            return JSON.parse(stored)?.state?.user ?? null;
        } catch {
            return null;
        }
    }

    // Auth guard
    const token = localStorage.getItem(TOKEN_KEY);
    if (!token) { window.location.replace("/login"); }
    const user = getUser();
    if (!user) { window.location.replace("/login"); }

    // Role: 's' | 't' | 'm' | 'a'
    const role: string = user?.role ?? "";

    // Show nav group
    const navStudent = document.getElementById("nav-student") as HTMLElement;
    const navTeacher = document.getElementById("nav-teacher") as HTMLElement;
    const navAdmin = document.getElementById("nav-admin") as HTMLElement;
    const navSystem = document.getElementById("nav-system") as HTMLElement;
    const navConfigLabel = document.getElementById("nav-config-label") as HTMLElement;

    if (role === "s") {
        navStudent?.classList.remove("hidden");
    } else if (role === "t") {
        navTeacher?.classList.remove("hidden");
    } else if (role === "a") {
        navAdmin?.classList.remove("hidden");
        navSystem?.classList.remove("hidden");
        navConfigLabel?.classList.remove("hidden");
    } else if (role === "m") {
        navAdmin?.classList.remove("hidden");
    }

    // Active link highlight
    const currentPath = document.body.dataset.currentPath ?? "";
    document.querySelectorAll(".nav-link").forEach((link) => {
        const href = link.getAttribute("href") ?? "";
        if (href === currentPath || (currentPath.startsWith(href) && href !== "/" && href.length > 1)) {
            link.classList.add("bg-muted", "text-foreground");
            link.classList.remove("text-muted-foreground", "hover:text-foreground", "hover:bg-muted");
        }
    });

    // Populate user section
    if (user) {
        const firstName: string = user.first_name ?? "";
        const lastName: string = user.last_name ?? "";
        const username: string = user.username ?? "User";
        let initials = "";
        if (firstName && lastName) {
            initials = (firstName[0] + lastName[0]).toUpperCase();
        } else if (firstName) {
            initials = firstName.substring(0, 2).toUpperCase();
        } else {
            initials = username.substring(0, 2).toUpperCase();
        }
        const displayName = firstName && lastName ? `${firstName} ${lastName}` : username;
        const roleLabels: Record<string,string> = { s: "Student", t: "Teacher", m: "Management", a: "Administration" };
        const avatarEl = document.getElementById("sidebar-avatar-initials");
        const nameEl = document.getElementById("sidebar-user-name");
        const roleEl = document.getElementById("sidebar-user-role");
        if (avatarEl) avatarEl.textContent = initials;
        if (nameEl) nameEl.textContent = displayName;
        if (roleEl) roleEl.textContent = roleLabels[role] ?? role;
    }

    // Logout
    document.getElementById("logout-btn")?.addEventListener("click", () => {
        localStorage.removeItem(TOKEN_KEY);
        localStorage.removeItem("refresh_token");
        localStorage.removeItem(STORAGE_KEY);
        window.location.replace("/login");
    });

    // Fetch unread notification count
    (async () => {
        try {
            const res = await fetch(`${API_URL}/notifications/unread-count/`, {
                headers: { "Authorization": `Bearer ${token}` },
            });
            if (res.ok) {
                const data = await res.json();
                if (data.count > 0) {
                    const badge = document.getElementById("notif-badge");
                    if (badge) {
                        badge.textContent = data.count > 99 ? "99+" : String(data.count);
                        badge.classList.remove("hidden");
                    }
                }
            }
        } catch {
            // Silently fail — notification count is non-critical
        }
    })();
</script>
