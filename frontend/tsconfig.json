{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/env.d.ts",
    "src/components/**/*",
    "src/hooks/**/*",
    "src/layouts/**/*",
    "src/pages/**/*",
    "src/stores/**/*",
    "src/test/setup.ts",
    "src/types/**/*",
    "src/utils/**/*",
    "vitest.config.ts"
  ],
  "exclude": [
    "dist",
    "src/examples/**",
    "src/validation/typecheck.ts"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "noImplicitAny": false,
    "strictNullChecks": false,
    "types": ["astro/client", "node", "vitest/globals"],
    "paths": {
      "@/*": ["src/*"]
    }
  }
}
